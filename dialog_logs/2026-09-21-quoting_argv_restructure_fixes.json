              "patch": "Index: common/string_utils.c\n===================================================================\n--- common/string_utils.c\t\n+++ common/string_utils.c\t\n@@ -1,106 +1,105 @@\n #include \"string_utils.h\"\r\n \r\n #include <ctype.h>\r\n #include <errno.h>\r\n #include <stdint.h>\r\n #include <stdio.h>\r\n #include <stdlib.h>\r\n #include <string.h>\r\n \r\n // ������ �������� �� �������� ������ �� \\0 ����� �������. ������\r\n char* get_string(int* len) {\r\n     *len = 0;\r\n     int capacity = 1;\r\n     char *s = (char*)malloc(sizeof(char)), *temp = NULL;\r\n     int ch;\r\n     while ((ch = getchar()) != EOF && ch != '\\n') {\r\n         s[*len] = (char)ch;\r\n         ++(*len);\r\n \r\n         if (*len >= capacity) {\r\n             capacity *= 2;\r\n             temp = (char*)realloc(s, capacity * sizeof(char));\r\n             // �������� �� null �� realloc �� ������ deepseek\r\n             // + free �����, ����� �� �� ������ ��� �������� null � �� ���� ������\r\n             if (!temp) {\r\n                 free(s);\r\n                 *len = -1;\r\n                 return NULL;\r\n             }\r\n             s = temp;\r\n         }\r\n     }\r\n     s[*len] = '\\0';\r\n     if (ch == EOF && *len == 0)\r\n         *len = -1;\r\n \r\n     return s;\r\n }\r\n \r\n // �������� �� �������\r\n int is_empty(const char* s) {\r\n     while (isspace((unsigned char)*s))\r\n         ++s;\r\n     return *s == '\\0';\r\n }\r\n \r\n // ���� �������� �� �����\r\n char* trim_string(char* s, int* len) {\r\n     // ������� ��������� ��������\r\n     while (*len > 0 && isspace((unsigned char)*s)) {\r\n         ++s;\r\n         --(*len);\r\n     }\r\n     // ����� ������\r\n     while (*len > 0 && isspace((unsigned char)s[*len - 1])) {\r\n         --(*len);\r\n         s[*len] = '\\0';\r\n     }\r\n \r\n     return s;\r\n }\r\n \r\n int is_hex_prefix(const char* ptr) {\r\n     // ������� �������� ������, �.�. ���� ��������� �������\r\n-    while (isspace((unsigned char)*ptr))\r\n-        ++ptr;\r\n+    ptr += strspn(ptr, \" \\t\\n\\r\");\r\n     if (*ptr == '\\0')\r\n         return 0;\r\n     // ���� ������ ������� ���� 0x, �� ������� � ��� �����. ����� �������� �� 0x�����\r\n     int pad = 0;\r\n     // +/- ����� hex ������ - ���������\r\n     if (*ptr == '+' || *ptr == '-')\r\n         ++pad;\r\n     // ���� ���� \\0, �� ��������� ����� ����� �� ���. � ����� - ����� �� if\r\n     if (*(ptr + pad) == '0' && (*(ptr + pad + 1) == 'x' || *(ptr + pad + 1) == 'X'))\r\n         return 1;\r\n     return 0;\r\n }\r\n \r\n // ������������� ������ �����\r\n int parse_int32(const char* s, int32_t* out) {\r\n     // ������� + �������� ������ ���� ����� �� ��� �����: strtol ������ �� � \"+-5\",\r\n     // �������� + ������ ���� (from_chars �� ����� ����), �� ����� \"+-5\" ���� ������\r\n     const char* first = s;\r\n     if (*first == '+') {\r\n         ++first;\r\n         if (!isdigit((unsigned char)*first))\r\n-            return INT_PARSE_NOT_NUMBER;\r\n+            return NUMBER_NOT_NUMBER;\r\n     }\r\n \r\n     errno = 0;\r\n     char* end = NULL;\r\n     long v = strtol(first, &end, 10);\r\n \r\n     // Windows: long == int32, ����� ������ ERANGE (�������� ��� clamp'����)\r\n     // Linux:   long 64-������, ERANGE ���, ����� ��������� � INT32_*\r\n     if (errno == ERANGE || v < INT32_MIN || v > INT32_MAX)\r\n-        return INT_PARSE_OUT_OF_RANGE;\r\n+        return NUMBER_OUT_OF_RANGE;\r\n \r\n     // ����� ������� �������� ��� ������: \"5x\", \"5.5\", \"0x10\", \"\" - �� �����\r\n     if (end == first || *end != '\\0')\r\n-        return INT_PARSE_NOT_NUMBER;\r\n+        return NUMBER_NOT_NUMBER;\r\n \r\n     *out = (int32_t)v;\r\n     return 0;\r\n }\r\n",
