            {
              "file": "tests/run_case.cpp",
              "patch": "Index: tests/run_case.cpp\n===================================================================\n--- tests/run_case.cpp\t\n+++ tests/run_case.cpp\t\n@@ -1,369 +1,369 @@\n #include <print>\r\n #include <string>\r\n #include <string_view>\r\n #include <system_error>\r\n \r\n #ifdef _WIN32\r\n #include <windows.h>\r\n \r\n #include <format>\r\n #include <ranges>\r\n \r\n #else\r\n #include <fcntl.h>\r\n #include <sys/wait.h>\r\n #include <unistd.h>\r\n \r\n #include <cerrno>\r\n \r\n #endif\r\n \r\n #ifdef _WIN32\r\n // ������ ������ - ��������� ������ �� ������� �������� � ��� �����, � ������� ���� ��������\r\n void print_win_error(std::string_view context, std::string_view target) {\r\n     DWORD current_err = GetLastError();\r\n     std::error_code ec(static_cast<int>(current_err), std::system_category());\r\n     std::print(stderr, \"Can not {} {}: {} (code {})\\n\", context, target, ec.message(), current_err);\r\n }\r\n \r\n // ������ ��� �������. �������, ����� ������� �������� ��������� CloseHandle\r\n // � HANDLE ��� �����������, ��� ������ �� �����, � ��������� ��� �����-���������\r\n // � ������ ��������� ������� ����� ��� ������ �� ������, � �� ������ ����� return ...\r\n class win_handle {\r\n     // h_: ���� ������ win_handle, ���������\r\n     // �� ������� � ��� �������� �� ���������� ���������� ������ ����� = INVALID_HANDLE_VALUE\r\n     HANDLE h_ = INVALID_HANDLE_VALUE;\r\n \r\n public:\r\n     // �����������. �������� h �� ��������� - INVALID_HANDLE_VALUE\r\n     // ��� �������� ��������� ������ ���������� h_ ����� �� ���������������\r\n     win_handle(HANDLE h = INVALID_HANDLE_VALUE) : h_(h) {}\r\n     // ����������. ��� �������� h_ - ��������� ���\r\n     ~win_handle() {\r\n         if (h_ != INVALID_HANDLE_VALUE && h_ != nullptr)\r\n             CloseHandle(h_);\r\n     }\r\n \r\n     // ���������� �������� �������� ��������:\r\n     // ������ ���������� ����� ����������� - �.�. ������ ������� ������ win_handle �� win_handle, ����� �� HANDLE\r\n     win_handle(const win_handle&) = delete;\r\n     // ������ ������� win_handle a = b, ��� b - ���� win_handle\r\n     win_handle& operator=(const win_handle&) = delete;\r\n \r\n     // ������ HANDLE - �.�. ������ �����. ��� �� ������� CloseHandle � ���������� ������� � ������\r\n     HANDLE get() const { return h_; }\r\n     // �������������� ������ � 0/1 (explicit) - ������ � ���������� ���������, �� � ������� ���������������\r\n     explicit operator bool() const { return h_ != INVALID_HANDLE_VALUE && h_ != nullptr; }\r\n };\r\n \r\n // ��������� �������� � ��������� ������ �������� ������\r\n win_handle open_io_file(const char* path, DWORD desired_access, DWORD creation_disposition, std::string_view context) {\r\n     // ���������� ������������ ��� ��������, ������� �������/������� ������ ��������� (��� ������ in/out/err)\r\n     SECURITY_ATTRIBUTES sa{};\r\n     sa.nLength = sizeof(sa);           // ������ ������. � ������; ����� ������ ������ SECURITY_ATTRIBUTES\r\n     sa.bInheritHandle = true;          // ����� � ���� sa ����� ������������� �������� ���������\r\n     sa.lpSecurityDescriptor = nullptr; // ���������� ������������ - �� �������\r\n \r\n     // ����� �� ���������� ���� (��������� / ��������)\r\n     // FILE_SHARE_READ - ������� �������� ���� ����� ������� �� ������ ������ ����. ��� ��-run_case � ��-main ���������\r\n     HANDLE h =\r\n         CreateFileA(path, desired_access, FILE_SHARE_READ, &sa, creation_disposition, FILE_ATTRIBUTE_NORMAL, NULL);\r\n \r\n     // ��� ��������� �������� ������ - ������ ��������� � ������� ������\r\n     if (h == INVALID_HANDLE_VALUE) {\r\n         print_win_error(context, path);\r\n         return win_handle{}; // ������������ �� ��������� ������ INVALID_HANDLE_VALUE\r\n     }\r\n     // ������� ������� ����� prvalue - ��������� copy elision. ��� �����������\r\n     // ������ ����� � ������ ����� �� ������ �����\r\n     return win_handle{h};\r\n }\r\n \r\n // ������ quoting\r\n // ���� �������� -> �������� ��������� ������ Windows, ������� CRT ������\r\n // ������� ����� � ���� �������� (MS Learn \"Parsing C++ command-line arguments\").\r\n // ���������� \" -> \\\"; ��� \\ ����� ����� \" ��� ����� ������ �����������, �����\r\n // �� \"������\" ����������� �������.\r\n std::string quote_arg(std::string_view arg) {\r\n     std::string out;\r\n     // ������ ����������� � �������\r\n     out += '\"';\r\n     std::size_t backslashes = 0;\r\n     for (char c : arg) {\r\n-        // �������������� ����. ���� ������� ��, �� ���� ������ ++�������. �.�. �����, ��� ����� \\\r\n+        // �������������� ����. ���� ������� ��, �� ���� ������ ++�������. �.�. �����, ��� �����\r\n         if (c == '\\\\') {\r\n             ++backslashes;\r\n-        // ���� ����� \\ �������, �������, �� ���������. \r\n-        // ����� ��� \\ �����. � �2, �.�. ����� �������� ������ ������ �� ������� �� 2��\r\n-        // ����� ��������� \\ �.�. ����� �������� ������ ���� ���� \\ \r\n+            // ���� ����� \\ �������, �������, �� ���������.\r\n+            // ����� ��� \\ �����. � �2, �.�. ����� �������� ������ ������ �� ������� �� 2��\r\n+            // ����� ��������� \\ �.�. ����� �������� ������ ���� ����\r\n         } else if (c == '\"') {\r\n             out.append(backslashes * 2 + 1, '\\\\');\r\n             out += '\"';\r\n-            // ���� ������ ������ ��������� ������������  \r\n+            // ���� ������ ������ ��������� ������������\r\n             backslashes = 0;\r\n         } else {\r\n             // �� ����� �������� ������ �� ����� ���� �� ��� �����. ������� ��� ��������\r\n             out.append(backslashes, '\\\\');\r\n             out += c;\r\n             backslashes = 0;\r\n         }\r\n     }\r\n     // ����� ������. ����� ����� ����� �������-���������, ������� ��� ����� ��� ����� ����� ���\r\n-    // �� ���� ����� ����������� �.�. ��� ����� �������� \r\n+    // �� ���� ����� ����������� �.�. ��� ����� ��������\r\n     out.append(backslashes * 2, 