e((unsigned char)*tail))\n        ++tail;\n    // ���� �������. ���. � ������, ��� � ����� �� �����, ��� ���� 16�� ������� - �� ��� ������ �������\n    if (end_r == argv[1] || *tail != '\\0' || is_hex_prefix(argv[1])) {\n        fprintf(stderr, \"������ ������ ���� ������. ��������: %s\\n\", argv[1]);\n        return usage;\n    }\n\n    if (errno == ERANGE && (r == 0.0 || !isfinite(r))) {\n        fprintf(stderr, \"������ ������� �� ���������� ��������: %s\\n\", argv[1]);\n        return usage;\n    }\n\n    if (!isfinite(r)) {\n        fprintf(stderr, \"������ ������ ���� �������� ������. ��������: %s\\n\", argv[1]);\n        return usage;\n    }\n\n    if (r <= 0) {\n        fprintf(stderr, \"������ ������ ���� �������������. ��������: %s\\n\", argv[1]);\n        return usage;\n    }\n\n    // ������ ����� � �������� ��������� ������\n    int points_size = 0, points_capacity = 1;\n    struct Point* points = malloc(sizeof(struct Point));\n    if (!points) {\n        fprintf(stderr, \"�� ������� �������� ������\\n\");\n        return io_fail;\n    }\n\n    // ����� ���������. �-���\n    // ���� ��� �����. != 0, ��� ��� ���-�� ����������, � ����� ������� ���� �� ���\n    int status = get_points(&points, &points_size, &points_capacity);\n    if (status != 0) {\n        free(points);\n        return status;\n    } else\n        // ����� �����, � ������� �����. �� ������ < r\n        for (int i = 0; i < points_size; ++i) {\n            if (sqrt(points[i].x * points[i].x + points[i].y * points[i].y + points[i].z * points[i].z) < r)\n                printf(\"%.3f %.3f %.3f\\n\", points[i].x, points[i].y, points[i].z);\n        }\n\n    free(points);\n\n    return 0;\n}",
