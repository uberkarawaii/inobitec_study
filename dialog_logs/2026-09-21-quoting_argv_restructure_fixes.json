              "patch": "Index: t4_filter_c/main.c\n===================================================================\n--- t4_filter_c/main.c\t\n+++ t4_filter_c/main.c\t\n@@ -1,200 +1,192 @@\n #include <ctype.h>\r\n #include <errno.h>\r\n #include <math.h>\r\n #include <stdio.h>\r\n #include <stdlib.h>\r\n \r\n #include \"../common/exit_codes.h\"\r\n #include \"../common/geometry.h\"\r\n+#include \"../common/parse_codes.h\"\r\n #include \"../common/string_utils.h\"\r\n \r\n int get_points(struct Point** points, int* points_size, int* points_capacity) {\r\n     // ������� ��� ������ ������ � ����� ������� ������\r\n     int i = 0, len = 0;\r\n     // ��������� �� �������. ������ � �����������\r\n     char* s;\r\n \r\n     // ���������� ����� � �������\r\n     while (1) {\r\n         s = get_string(&len);\r\n         ++i;\r\n \r\n         // ����� ����� ��������� �������� �� �������� � IO ��� ����� ����. ������\r\n         if (len == -1) {\r\n             free(s);\r\n             s = NULL;\r\n \r\n             if (ferror(stdin)) {\r\n                 fprintf(stderr, \"������ %d - ���� �����-������\\n\", i);\r\n                 return io_fail;\r\n             }\r\n             // ���� len == -1 ��� ������� � ������� ������, �� ��� ��������� EOF\r\n             else\r\n                 break;\r\n         }\r\n \r\n         // �������� �� �������; ���� �����, ����������\r\n         if (is_empty(s)) {\r\n             free(s);\r\n             s = NULL;\r\n             continue;\r\n         }\r\n \r\n         // ������������ ����� � ������ ����� parse_point\r\n         struct Point p;\r\n         int ex_code = parse_point(s, &p);\r\n \r\n         if (ex_code != 0) {\r\n             // ���� ���� ����������\r\n-            if (ex_code == PARSE_TOO_FEW)\r\n+            if (ex_code == NUMBER_TOO_FEW)\r\n                 fprintf(stderr, \"������ %d - ������������ ���������. ��������� X Y Z, ��������: %s\\n\", i, s);\r\n \r\n             // ���� �������� ����������\r\n-            else if (ex_code == PARSE_NOT_NUMBER)\r\n+            else if (ex_code == NUMBER_NOT_NUMBER)\r\n                 fprintf(stderr, \"������ %d. ���������� ������: %s\\n\", i, s);\r\n \r\n             // ������� ����� ����������\r\n-            else if (ex_code == PARSE_EXTRA)\r\n+            else if (ex_code == NUMBER_TOO_MUCH)\r\n                 fprintf(stderr, \"������ %d - ������� ����� ���������. ��������� X Y Z, ��������: %s\\n\", i, s);\r\n \r\n             // ���� �� ��������� ��� inf ��� Nan\r\n-            else if (ex_code == PARSE_NOT_FINITE)\r\n+            else if (ex_code == NUMBER_NOT_FINITE)\r\n                 fprintf(stderr, \"������ %d. ����� X Y Z ���������� �� �������� ����������: %s\\n\", i, s);\r\n \r\n             // � ����� ���� ����� ��������� �� �������� �����������\r\n-            else if (ex_code == PARSE_OUT_OF_RANGE)\r\n+            else if (ex_code == NUMBER_OUT_OF_RANGE)\r\n                 fprintf(stderr, \"������ %d. ����� X Y Z ���������� ����������, ��������� �� ���������� ��������: %s\\n\",\r\n                         i, s);\r\n \r\n             free(s);\r\n             s = NULL;\r\n             return data;\r\n         }\r\n \r\n         // ���� ����� ����, �� ��� �������� �� parse_points == 0 - ������������� ������\r\n         // ���������� ����� � ������\r\n         (*points)[*points_size] = p;\r\n         (*points_size)++;\r\n \r\n         //\r\n         if (*points_size >= *points_capacity) {\r\n             *points_capacity *= 2;\r\n             struct Point* tmp = realloc(*points, *points_capacity * sizeof(*tmp));\r\n             if (!tmp) {\r\n                 fprintf(stderr, \"������ ��� ��������� ������\\n\");\r\n                 free(s);\r\n                 free(*points);\r\n                 exit(io_fail);\r\n             }\r\n             *points = tmp;\r\n         }\r\n \r\n         // ���������� s �.�. � �� ��������� ����� ������\r\n         free(s);\r\n         s = NULL;\r\n     }\r\n \r\n     if (*points_size == 0) {\r\n         fprintf(stderr, \"����� �����������\\n\");\r\n         free(s);\r\n         return no_input;\r\n     }\r\n \r\n     return 0;\r\n }\r\n \r\n-enum {\r\n-    RADIUS_OK = 0,\r\n-    RADIUS_NOT_NUMBER = 1,\r\n-    RADIUS_NOT_FINITE = 2,\r\n-    RADIUS_NOT_POSITIVE = 3,\r\n-    RADIUS_OUT_OF_RANGE = 4,\r\n-    RADIUS_EMPTY = 5,\r\n-};\r\n-\r\n int parse_radius(const char* s, double* out) {\r\n     if (is_empty(s))\r\n-        return RADIUS_EMPTY;\r\n+        return NUMBER_EMPTY;\r\n \r\n     errno = 0;\r\n     char* end = NULL;\r\n     double r = strtod(s, &end);\r\n     const char* tail = end;\r\n     while (*tail != '\\0' && isspace((unsigned char)*tail))\r\n         ++tail;\r\n \r\n     if (end == s || *tail != '\\0' || is_hex_prefix(s))\r\n-        return RADIUS_NOT_NUMBER;\r\n+        return NUMBER_NOT_NUMBER;\r\n     if (errno == ERANGE && (r == 0.0 || !isfinite(r)))\r\n-        return RADIUS_OUT_OF_RANGE;\r\n+        return NUMBER_OUT_OF_RANGE;\r\n     if (!isfinite(r))\r\n-        return RADIUS_NOT_FINITE;\r\n+        return NUMBER_NOT_FINITE;\r\n     if (r <= 0)\r\n-        return RADIUS_NOT_POSITIVE;\r\n+        return NUMBER_NOT_POSITIVE;\r\n \r\n     *out = r;\r\n-    return RADIUS_OK;\r\n+    return NUMBER_OK;\r\n }\r\n \r\n int main(int argc, char* argv[]) {\r\n     // �������� ������� - ���-�� ���������� � ��� ������ (����� ��, ������� ��, ������������� ��)\r\n     if (argc != 2) {\r\n         if (argc < 2)\r\n             fprintf(stderr, \"�������� ������; ��� �������� �� ���� �������\\n\");\r\n         else\r\n             fprintf(stderr, \"�������� ������; ���� ������� ������ ���������\\n\");\r\n         return usage;\r\n     }\r\n \r\n     double r = 0;\r\n     const int r_code = parse_radius(argv[1], &r);\r\n-    if (r_code == RADIUS_EMPTY) {\r\n+    if (r_code == NUMBER_EMPTY) {\r\n         fprintf(stderr, \"�������� ������; �������� ������ ��� ��������\\n\");\r\n         return usage;\r\n     }\r\n \r\n-    if (r_code == RADIUS_NOT