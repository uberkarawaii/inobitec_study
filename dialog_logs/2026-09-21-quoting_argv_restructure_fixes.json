              "file": "t1_dist_matrix_c/main.c",
              "patch": "Index: t1_dist_matrix_c/main.c\n===================================================================\n--- t1_dist_matrix_c/main.c\t\n+++ t1_dist_matrix_c/main.c\t\n@@ -1,68 +1,69 @@\n #define _USE_MATH_DEFINES\r\n #include <math.h>\r\n #ifndef M_PI\r\n #define M_PI 3.14159265358979323846\r\n #endif\r\n #include <stdint.h>\r\n #include <stdio.h>\r\n #include <stdlib.h>\r\n #include <string.h>\r\n \r\n #include \"../common/exit_codes.h\"\r\n #include \"../common/geometry.h\"\r\n+#include \"../common/parse_codes.h\"\r\n #include \"../common/string_utils.h\"\r\n \r\n #define MAX_SIZE 20\r\n #define MIN_SIZE 3\r\n \r\n int main(void) {\r\n     char lineN[32];\r\n     if (fgets(lineN, sizeof(lineN), stdin) == NULL) {\r\n         fprintf(stderr, \"������� ������ ���� ������ ������ N\");\r\n         return no_input;\r\n     }\r\n     // ������� ������ �� ���������� �������� �� �����\r\n     int len = (int)strlen(lineN);\r\n     char* clean_n = trim_string(lineN, &len);\r\n \r\n     // �������� ������ �� ������� ����� ������� �� ���������� ��������\r\n     if (is_empty(clean_n)) {\r\n         fprintf(stderr, \"������� ������ ���� ������ ������ N\");\r\n         return no_input;\r\n     }\r\n \r\n     // ������������� - ����� ���������. �-��� �� string_utils\r\n     int32_t N = 0;\r\n     int code = parse_int32(clean_n, &N);\r\n-    if (code == INT_PARSE_OUT_OF_RANGE) {\r\n+    if (code == NUMBER_OUT_OF_RANGE) {\r\n         fprintf(stderr, \"N �� ���������� � 32-������ �����. ��������: %s\", clean_n);\r\n         return data;\r\n     }\r\n-    if (code == INT_PARSE_NOT_NUMBER) {\r\n+    if (code == NUMBER_NOT_NUMBER) {\r\n         fprintf(stderr, \"N ������ ���� ����� ������. ��������: %s\", clean_n);\r\n         return data;\r\n     }\r\n     if (N < MIN_SIZE || N > MAX_SIZE) {\r\n         fprintf(stderr, \"N ������ ���� � ��������� [3;20]. ��������: %s\", clean_n);\r\n         return usage;\r\n     }\r\n \r\n     // �������. � � � ��� �������� � ������ �� �����\r\n     struct Point points[MAX_SIZE];\r\n     for (int i = 0; i < N; ++i) {\r\n         points[i].x = cos(i * 2 * M_PI / N);\r\n         points[i].y = sin(i * 2 * M_PI / N);\r\n     }\r\n \r\n     for (int i = 0; i < N; ++i) {\r\n         for (int j = 0; j < N; ++j) {\r\n             if (i == j)\r\n                 printf(\"%8.3f\", 0.0);\r\n             else\r\n                 printf(\"%8.3f\", sqrt(pow(points[i].x - points[j].x, 2) + pow(points[i].y - points[j].y, 2)));\r\n         }\r\n         printf(\"\\n\");\r\n     }\r\n \r\n     return 0;\r\n }\r\n",
