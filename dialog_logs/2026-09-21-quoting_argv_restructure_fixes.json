              "patch": "Index: t2_passport_cpp/main.cpp\n===================================================================\n--- t2_passport_cpp/main.cpp\t\n+++ t2_passport_cpp/main.cpp\t\n@@ -1,67 +1,68 @@\n #include <array>\r\n #include <iostream>\r\n #include <string>\r\n \r\n #include \"../common/exit_codes.hpp\"\r\n+#include \"../common/parse_codes.hpp\"\r\n #include \"../common/string_utils.hpp\"\r\n \r\n // ����� ����� \"�������\" �� ����������.\r\n // ������� ����� ������, �� �������� � ������� ����� ������ ����� �����\r\n int get_vertex_name(int N) {\r\n     if (N % 10 == 1 && N % 100 / 10 != 1)\r\n         return 0;\r\n     else if (N % 10 >= 2 && N % 10 <= 4 && N % 100 / 10 != 1)\r\n         return 1;\r\n     else\r\n         return 2;\r\n }\r\n \r\n int main() {\r\n     std::string name;\r\n     if (!std::getline(std::cin, name)) {\r\n         std::cerr << \"EOF ������ ����� ������\\n\";\r\n         return exit_code::no_in;\r\n     }\r\n \r\n     trim_str(name);\r\n     if (name.empty()) {\r\n         std::cerr << \"������ ���� ������ ����� ������\\n\";\r\n         return exit_code::data;\r\n     }\r\n \r\n     std::string vertexes;\r\n     if (!std::getline(std::cin, vertexes)) {\r\n         std::cerr << \"EOF ������ ����� ������\\n\";\r\n         return exit_code::no_in;\r\n     }\r\n \r\n     trim_str(vertexes);\r\n     if (vertexes.empty()) {\r\n         std::cerr << \"������ ���� ������ ���-�� ������\\n\";\r\n         return exit_code::data;\r\n     }\r\n \r\n     auto parsed = parse_int32(vertexes);\r\n     if (!parsed) {\r\n-        if (parsed.error() == int_parse_out_of_range) {\r\n+        if (parsed.error() == number_error::out_of_range) {\r\n             std::cerr << \"���-�� ������ �� ���������� � 32-������ �����. ��������: \" << vertexes << \"\\n\";\r\n             return exit_code::data;\r\n         }\r\n         // ��� ����� ��. ������ - ��� ����� (�������� - ������ ������. �� ��� ���������, ����� ���. �� ���� ������)\r\n         std::cerr << \"���-�� ������ ������ ���� ����� ������. ��������: \" << vertexes << \"\\n\";\r\n         return exit_code::data;\r\n     }\r\n     // �-�� ������\r\n     const int V = *parsed;\r\n     if (V < 1) {\r\n         std::cerr << \"���-�� ������ ������ ���� �������������. ��������: \" << V << \"\\n\";\r\n         return exit_code::usage;\r\n     }\r\n \r\n     // ������ ��������� . ����� get_vertex_name(V) ����� ������ ��� ������ ����� �� ����� �������\r\n     std::array words{\"�������\", \"�������\", \"������\"};\r\n \r\n     std::cout << \"������ �\" << name << \"�: \" << V << \" \" << words[get_vertex_name(V)] << \".\\n\";\r\n \r\n     return 0;\r\n }\r\n",
