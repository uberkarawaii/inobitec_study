              "patch": "Index: t3_bbox_cpp/main.cpp\n===================================================================\n--- t3_bbox_cpp/main.cpp\t\n+++ t3_bbox_cpp/main.cpp\t\n@@ -1,102 +1,103 @@\n #include <algorithm>\r\n #include <cmath>\r\n #include <iostream>\r\n #include <numeric>\r\n #include <print>\r\n #include <ranges>\r\n #include <string>\r\n #include <vector>\r\n \r\n #include \"../common/exit_codes.hpp\"\r\n #include \"../common/geometry.hpp\"\r\n+#include \"../common/parse_codes.hpp\"\r\n #include \"../common/string_utils.hpp\"\r\n \r\n int main() {\r\n     // ����. �������������, ����� EOF � io-fail ������ ����������� ��-�� ������ ����� fgetc\r\n     std::ios::sync_with_stdio(false);\r\n     // ���������� ��������� x y z � ������; ������� ������, ����� �����\r\n     // ��� ������������� ������ ����� � ������� ����� ������\r\n     std::string temp;\r\n     std::vector<Point> points;\r\n     int i = 0;\r\n     // ���� �� EOF - ������\r\n     while (std::getline(std::cin, temp)) {\r\n         // ���������� �����, ����� ��� ������ ����� ������, � �� ����. � �������\r\n         ++i;\r\n \r\n         // ��������� ������ ������ ������ ������������\r\n         if (is_empty(temp))\r\n             continue;\r\n \r\n         // ������ ����� ����� parse_point\r\n         auto result = parse_point(temp);\r\n         if (!result) {\r\n             // ���� ����������\r\n-            if (result.error() == parse_too_few)\r\n+            if (result.error() == number_error::too_few)\r\n                 std::cerr << \"������ \" << i << \" - ������������ ���������. ��������� X Y Z, ��������: \" << temp << \"\\n\";\r\n             // ���������� ������\r\n-            else if (result.error() == parse_not_number)\r\n+            else if (result.error() == number_error::not_number)\r\n                 std::cerr << \"������ \" << i << \". ���������� ������: \" << temp << \"\\n\";\r\n             // ������� ����� ���������\r\n-            else if (result.error() == parse_too_much)\r\n+            else if (result.error() == number_error::too_much)\r\n                 std::cerr << \"������ \" << i << \" - ������� ����� ���������. ��������� X Y Z, ��������: \" << temp\r\n                           << \"\\n\";\r\n             // ���� �� ��������� - �� �������� �����\r\n-            else if (result.error() == parse_not_finite)\r\n+            else if (result.error() == number_error::not_finite)\r\n                 std::cerr << \"������ \" << i << \". ����� X Y Z ���������� �� �������� ����������: \" << temp << \"\\n\";\r\n             // � ����� ���� ����� ��������� �� �������� �����������\r\n-            else if (result.error() == parse_out_of_range)\r\n+            else if (result.error() == number_error::out_of_range)\r\n                 std::cerr << \"������ \" << i\r\n                           << \". ����� X Y Z ���������� ����������, ��������� �� ���������� ��������: \" << temp << \"\\n\";\r\n \r\n             return exit_code::data;\r\n         }\r\n \r\n         // ���� ����� �� ����� �������, ������ ex_code == 0 � ����� ������� ����� � ������\r\n         points.push_back(*result);\r\n     }\r\n     // �������� ���� ����� �����, �.�. ��� ���� - ����� �� �����. i+1 �.�. � ���� ��� ������ �� �����\r\n     if (std::cin.bad()) {\r\n         std::cerr << \"������ \" << i + 1 << \" - ���� �����-������\\n\";\r\n         return exit_code::io_fail;\r\n     }\r\n \r\n     // ���� �� ����� ������ ������ ����� ������, �� ������� ������ �� ����\r\n     if (points.empty()) {\r\n         std::cerr << \"������� ������ �����������\\n\";\r\n         return exit_code::no_in;\r\n     }\r\n \r\n     // ������� <double> �������� �� ����� x, y, z ��� ���������� ����������\r\n     auto xs = points | std::views::transform([](const Point& p) { return p.x; });\r\n     auto ys = points | std::views::transform([](const Point& p) { return p.y; });\r\n     auto zs = points | std::views::transform([](const Point& p) { return p.z; });\r\n \r\n     // ����� ��������� � ���������� �� ����\r\n     Point max_border{std::ranges::max(xs), std::ranges::max(ys), std::ranges::max(zs)};\r\n     Point min_border{std::ranges::min(xs), std::ranges::min(ys), std::ranges::min(zs)};\r\n \r\n     // ����� - ����� �� ���� ���� ������� �� ���-�� �����\r\n     Point center{std::reduce(xs.begin(), xs.end()) / points.size(), std::reduce(ys.begin(), ys.end()) / points.size(),\r\n                  std::reduce(zs.begin(), zs.end()) / points.size()};\r\n \r\n     // ���������� �������� ���������� �� ����� �� ���������\r\n     double dist = 0;\r\n     for (const auto& p : points) {\r\n         dist += std::hypot(p.x - center.x, p.y - center.y, p.z - center.z);\r\n     }\r\n     dist = dist / points.size();\r\n \r\n     // ����� ���-�� �����, ������ ���������������, �����. ��������� � ����. �����. �� ����\r\n     std::print(\"���������� �����: {}\\n\", points.size());\r\n \r\n     std::print(\r\n         \"���������� �������. ��������������� x: [ {:.3f}; {:.3f} ] y: [ {:.3f}; {:.3f} ] z: [ {:.3f}; {:.3f} ]\\n\",\r\n         min_border.x, max_border.x, min_border.y, max_border.y, min_border.z, max_border.z);\r\n \r\n     std::print(\"���������� ��������� x: {:.3f}, y: {:.3f}, z: {:.3f}\\n\", center.x, center.y, center.z);\r\n \r\n     std::print(\"������� ���������� �� ����� �� ���������: {:.3f}\\n\", dist);\r\n \r\n     return 0;\r\n }\n\\ No newline at end of file\n",
