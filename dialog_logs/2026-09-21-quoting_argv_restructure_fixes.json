              "file": "t3_bbox_c/main.c",
              "patch": "Index: t3_bbox_c/main.c\n===================================================================\n--- t3_bbox_c/main.c\t\n+++ t3_bbox_c/main.c\t\n@@ -1,169 +1,170 @@\n #include <math.h>\r\n #include <stdio.h>\r\n #include <stdlib.h>\r\n \r\n #include \"../common/exit_codes.h\"\r\n #include \"../common/geometry.h\"\r\n+#include \"../common/parse_codes.h\"\r\n #include \"../common/string_utils.h\"\r\n \r\n int main() {\r\n \r\n     int len;\r\n     char* s = NULL;\r\n \r\n     // ������ ����� � �������� ��������� ������\r\n     int points_size = 0, points_capacity = 1;\r\n     struct Point* points = malloc(sizeof(struct Point));\r\n     if (!points) {\r\n         fprintf(stderr, \"�� ������� �������� ������\\n\");\r\n         return io_fail;\r\n     }\r\n \r\n     // ��������\r\n     struct Point center = {.x = 0, .y = 0, .z = 0};\r\n \r\n     // ������� ��� ������ ������\r\n     int i = 0;\r\n     while (1) {\r\n         // ������� ������\r\n         s = get_string(&len);\r\n         ++i;\r\n \r\n         // ����� ����� ��������� �������� �� �������� � IO\r\n         if (len == -1) {\r\n             if (ferror(stdin)) {\r\n                 fprintf(stderr, \"������ %d - ���� �����-������\\n\", i);\r\n                 free(s);\r\n                 s = NULL;\r\n                 free(points);\r\n                 points = NULL;\r\n                 return io_fail;\r\n             }\r\n             // ���� len == -1 ��� ������� � ������� ������, �� ��� ��������� EOF\r\n             else {\r\n                 free(s);\r\n                 s = NULL;\r\n                 break;\r\n             }\r\n         }\r\n \r\n         // �������� �� �������. ���� �����, �������\r\n         if (is_empty(s)) {\r\n             free(s);\r\n             s = NULL;\r\n             continue;\r\n         }\r\n \r\n         // ������������� X Y Z ����� parse_point\r\n         struct Point p;\r\n         int ex_code = parse_point(s, &p);\r\n         // ��� ��������� ���� ������ - ��� ���������\r\n         if (ex_code != 0) {\r\n             // ������������ ������\r\n-            if (ex_code == PARSE_TOO_FEW)\r\n+            if (ex_code == NUMBER_TOO_FEW)\r\n                 fprintf(stderr, \"������ %d - ������������ ���������. ��������� X Y Z, ��������: %s\\n\", i, s);\r\n \r\n             // ���������� ������\r\n-            else if (ex_code == PARSE_NOT_NUMBER)\r\n+            else if (ex_code == NUMBER_NOT_NUMBER)\r\n                 fprintf(stderr, \"������ %d. ���������� ������: %s\\n\", i, s);\r\n \r\n             // ������� ����� ���������\r\n-            else if (ex_code == PARSE_EXTRA)\r\n+            else if (ex_code == NUMBER_TOO_MUCH)\r\n                 fprintf(stderr, \"������ %d - ������� ����� ���������. ��������� X Y Z, ��������: %s\\n\", i, s);\r\n \r\n             // ���� �� ��������� ��� inf ��� Nan\r\n-            else if (ex_code == PARSE_NOT_FINITE)\r\n+            else if (ex_code == NUMBER_NOT_FINITE)\r\n                 fprintf(stderr, \"������ %d. ����� X Y Z ���������� �� �������� ����������: %s\\n\", i, s);\r\n \r\n             // � ����� ���� ����� ��������� �� �������� �����������\r\n-            else if (ex_code == PARSE_OUT_OF_RANGE)\r\n+            else if (ex_code == NUMBER_OUT_OF_RANGE)\r\n                 fprintf(stderr, \"������ %d. ����� X Y Z ���������� ����������, ��������� �� ���������� ��������: %s\\n\",\r\n                         i, s);\r\n \r\n             free(s);\r\n             s = NULL;\r\n             free(points);\r\n             return data;\r\n         }\r\n         // ���� ����� �� ����, ��� ������ == 0 � ������������� ���������\r\n         points[points_size] = p;\r\n         points_size++;\r\n \r\n         // ���� ������ >= ����������� �� ���� ��������� �����������\r\n         if (points_size >= points_capacity) {\r\n             points_capacity *= 2;\r\n             struct Point* tmp = realloc(points, points_capacity * sizeof(*tmp));\r\n             // ���� �� ������� �������� ������\r\n             if (!tmp) {\r\n                 fprintf(stderr, \"������ ��� ��������� ������\\n\");\r\n                 free(s);\r\n                 free(points);\r\n                 exit(io_fail);\r\n             }\r\n             points = tmp;\r\n         }\r\n \r\n         // ������������ ����� � ��������\r\n         center.x += p.x;\r\n         center.y += p.y;\r\n         center.z += p.z;\r\n \r\n         // ������������ s �.�. � �� ��������� ����� ������\r\n         free(s);\r\n         s = NULL;\r\n     }\r\n \r\n     // ���� ����� ������� ����� ������� == 0 �� ������� ������ �� ����\r\n     if (points_size == 0) {\r\n         fprintf(stderr, \"������� ������ �����������\\n\");\r\n         free(s);\r\n         free(points);\r\n         return no_input;\r\n     }\r\n \r\n     // ������� ����������� � ��������� ����� �� ���-�� �����\r\n     center.x /= points_size;\r\n     center.y /= points_size;\r\n     center.z /= points_size;\r\n \r\n     // ������� - �������� � ���������\r\n     double max[3] = {points[0].x, points[0].y, points[0].z};\r\n     double min[3] = {points[0].x, points[0].y, points[0].z};\r\n     // ������� ���������� �� ���������\r\n     double d = 0;\r\n \r\n     i = 0;\r\n     for (; i < points_size; ++i) {\r\n         if (max[0] < points[i].x)\r\n             max[0] = points[i].x;\r\n         if (max[1] < points[i].y)\r\n             max[1] = points[i].y;\r\n         if (max[2] < points[i].z)\r\n             max[2] = points[i].z;\r\n \r\n         if (min[0] > points[i].x)\r\n             min[0] = points[i].x;\r\n         if (min[1] > points[i].y)\r\n             min[1] = points[i].y;\r\n         if (min[2] > points[i].z)\r\n             min[2] = points[i].z;\r\n \r\n         d += sqrt((points[i].x - center.x) * (points[i].x - center.x) +\r\n                   (points[i].y - center.y) * (points[i].y - center.y) +\r\n                   (points[i].z - center.z) * (points[i].z - center.z));\r\n     }\r\n \r\n     // ������� ������������ ���������� �� ���-�� �����\r\n     d /= points_size;\r\n \r\n     // ����� ����������\r\n     printf(\"���������� �����: %d\\n\", points_size);\r\n     printf(\"���������� �������. ��������������� x: [ %.3f; %.3f ] y: [ %.3f; %.3f ] z: [ %.3f; %.3f ]\\n\", min[0],\r\n            max[0], min[1], max[1], min[2], max[2]);\r\n     printf(\"���������� ��������� x: %.3f, y: %.3f, z: %.3f\\n\", center.x, center.y, center.z);\r\n     printf(\"������� ���������� �� ����� �� ���������: %.3f\\n\", d);\r\n \r\n     free(s);\r\n     free(points);\r\n     return 0;\r\n }\n\\ No newline at end of file\n",
