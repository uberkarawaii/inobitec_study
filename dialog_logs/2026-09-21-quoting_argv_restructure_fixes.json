              "patch": "Index: t1_dist_matrix_cpp/main.cpp\n===================================================================\n--- t1_dist_matrix_cpp/main.cpp\t\n+++ t1_dist_matrix_cpp/main.cpp\t\n@@ -1,65 +1,66 @@\n #include <cmath>\r\n #include <iostream>\r\n #include <numbers>\r\n #include <print>\r\n #include <string>\r\n #include <vector>\r\n \r\n #include \"../common/exit_codes.hpp\"\r\n #include \"../common/geometry.hpp\"\r\n+#include \"../common/parse_codes.hpp\"\r\n #include \"../common/string_utils.hpp\"\r\n \r\n int main() {\r\n     std::string lineN;\r\n     // ���������� ������, �������� �� �������\r\n     if (!std::getline(std::cin, lineN) || lineN.empty()) {\r\n         std::cerr << \"������� ������ ���� ������ ������ N\\n\";\r\n         return exit_code::no_in;\r\n     }\r\n     // ������� �� ������� ���������� �������� � �������� �� �������\r\n     trim_str(lineN);\r\n     if (lineN.empty()) {\r\n         std::cerr << \"������� ������ ���� ������ ������ N\\n\";\r\n         return exit_code::no_in;\r\n     }\r\n \r\n     // ������������� N � �������� �� ������ �������������\r\n     auto parsed = parse_int32(lineN);\r\n     if (!parsed) {\r\n-        if (parsed.error() == int_parse_out_of_range) {\r\n+        if (parsed.error() == number_error::out_of_range) {\r\n             std::cerr << \"N �� ���������� � 32-������ �����. ��������: \" << lineN << '\\n';\r\n             return exit_code::data;\r\n         }\r\n         // ��� ����� ������ ������ (�������� ��� ������ ������, �� ��� ���������, ����� ����� �� ����� ������)\r\n         std::cerr << \"N ������ ���� ����� ������. ��������: \" << lineN << '\\n';\r\n         return exit_code::data;\r\n     }\r\n \r\n     // ���������� �����\r\n     const int N = *parsed;\r\n \r\n     // ��������� ��������\r\n     if (N < 3 || N > 20) {\r\n         std::cerr << \"N ������ ���� � ��������� [3;20]. ��������: \" << lineN << '\\n';\r\n         return exit_code::usage;\r\n     }\r\n \r\n     std::vector<Point> points(N);\r\n     double perm_angle;\r\n     for (int i = 0; i < N; ++i) {\r\n         perm_angle = 2 * std::numbers::pi * i / N;\r\n         points[i].x = std::cos(perm_angle);\r\n         points[i].y = std::sin(perm_angle);\r\n     }\r\n \r\n     for (int i = 0; i < N; ++i) {\r\n         for (int j = 0; j < N; ++j) {\r\n             if (i == j)\r\n                 std::print(\"{:8.3f}\", 0.0);\r\n             else\r\n                 std::print(\"{:8.3f}\", std::hypot(points[i].x - points[j].x, points[i].y - points[j].y));\r\n         }\r\n         std::print(\"\\n\");\r\n     }\r\n     return 0;\r\n }\r\n",
