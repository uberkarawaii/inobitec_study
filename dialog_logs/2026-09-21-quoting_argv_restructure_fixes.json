              "patch": "Index: t2_passport_c/main.c\n===================================================================\n--- t2_passport_c/main.c\t\n+++ t2_passport_c/main.c\t\n@@ -1,87 +1,88 @@\n #include <inttypes.h>\r\n #include <stdint.h>\r\n #include <stdio.h>\r\n #include <stdlib.h>\r\n \r\n #include \"../common/exit_codes.h\"\r\n+#include \"../common/parse_codes.h\"\r\n #include \"../common/string_utils.h\"\r\n \r\n int get_vertex_name(int N) {\r\n     if ((N / 10) % 10 != 1 && N % 10 == 1)\r\n         return 0;\r\n     else if ((N / 10) % 10 != 1 && N % 10 >= 2 && N % 10 <= 4)\r\n         return 1;\r\n     else\r\n         return 2;\r\n }\r\n \r\n int main() {\r\n     //  ���������� ������ ���������\r\n     int len_name;\r\n     char* s = get_string(&len_name);\r\n \r\n     // ���� �� string_utils ��������� ������� �����, �� ������ ����. �� ������� ����� ������\r\n     if (len_name == -1) {\r\n         free(s);\r\n         fprintf(stderr, \"EOF ������ ����� ������\\n\");\r\n         return no_input;\r\n     }\r\n \r\n     // �������� ������ �� �������� � ������ � � �����\r\n     char* clean_s = trim_string(s, &len_name);\r\n     // ���� ����� �� ���� � ����� 0, �� ������ ������ �������� �������� �� ��������\r\n     if (len_name == 0) {\r\n         free(s);\r\n         // clean_s ����������� �������������, �.�. s ���������� ��� ���� �����������\r\n         fprintf(stderr, \"������ ���� ������ ����� ������\\n\");\r\n         return data;\r\n     }\r\n     // ���������� ����. ������ � ������ ������\r\n     int len_num;\r\n     char* s_num = get_string(&len_num);\r\n     // �����, ���� ����� = -1, �� ��� ��������� ������ ������\r\n     if (len_num == -1) {\r\n         free(s);\r\n         free(s_num);\r\n         fprintf(stderr, \"EOF ������ ����� ������\\n\");\r\n         return no_input;\r\n     }\r\n     // ������� �� ��������\r\n     char* clean_s_num = trim_string(s_num, &len_num);\r\n     // ���� ����� ������� �� �������� ����� = 0, �� ���������� ��� ������ ���� �� ��������\r\n     if (len_num == 0) {\r\n         free(s);\r\n         free(s_num);\r\n         fprintf(stderr, \"������ ���� ������ ���-�� ������\\n\");\r\n         return data;\r\n     }\r\n     // ������������� ����� ������������ �-���� �� string_utils\r\n     int32_t N = 0;\r\n     int code = parse_int32(clean_s_num, &N);\r\n-    if (code == INT_PARSE_OUT_OF_RANGE) {\r\n+    if (code == NUMBER_OUT_OF_RANGE) {\r\n         fprintf(stderr, \"���-�� ������ �� ���������� � 32-������ �����. ��������: %s\\n\", clean_s_num);\r\n         free(s);\r\n         free(s_num);\r\n         return data;\r\n     }\r\n-    if (code == INT_PARSE_NOT_NUMBER) {\r\n+    if (code == NUMBER_NOT_NUMBER) {\r\n         fprintf(stderr, \"���-�� ������ ������ ���� ����� ������. ��������: %s\\n\", clean_s_num);\r\n         free(s);\r\n         free(s_num);\r\n         return data;\r\n     }\r\n     if (N < 1) {\r\n         fprintf(stderr, \"���-�� ������ ������ ���� �������������. ��������: %\" PRId32 \"\\n\", N);\r\n         free(s);\r\n         free(s_num);\r\n         return usage;\r\n     }\r\n \r\n     // ������ ��������� �� ����������\r\n     const char* words[] = {\"�������\", \"�������\", \"������\"};\r\n     // ��������� ����� �� ����������\r\n     printf(\"������ �%s�: %\" PRId32 \" %s.\\n\", clean_s, N, words[get_vertex_name(N)]);\r\n     free(s);\r\n     free(s_num);\r\n     return 0;\r\n }\r\n",
