2:     int fd_ = -1;\n83: \n84: public:\n85:     posix_fd(int fd = -1) : fd_(fd) {}\n86:     ~posix_fd() {\n87:         if (fd_ >= 0)\n88:             close(fd_);\n89:     }\n90:     posix_fd(const posix_fd&) = delete;\n91:     posix_fd& operator=(const posix_fd&) = delete;\n92:     int get() const { return fd_; }\n93:     explicit operator bool() const { return fd_ >= 0; }\n94: };\n95: \n96: // ��������� ������ ������\n97: void print_errno_error(std::string_view context, std::string_view target) {\n98:     // ��������� ������ POSIX ��� ������� ����� ���������� errno - ��� ������ � ������ ������\n99:     // ���������� errno � ��������� ����������, ����� ������� ���������, ����� �� �� ��� ����� �����������\n100:     int current_err = errno;\n101:     std::error_code ec(current_err, std::generic_category());\n102:     std::print(stderr, \"Can not {} {}: {} (code {})\\n\", context, target, ec.message(), current_err);\n103: }\n104: \n105: // ��������� ������ � �������� ������������ � ������� ��� ����� � posix_fd ��� �����\n106: posix_fd open_io_file(const char* path, int flags, int mode, std::string_view context) {\n107:     // flags - ����� ����, ��� ����� ������������ � ���� ������ - ������ / ������ / � �.�.\n108:     // mode - ����� �����\n109:     int fd = open(path, flags, mode);\n110: \n111:     if (fd == -1) {\n112:         print_errno_error(context, path);\n113:         return posix_fd{};\n114:     }\n115: \n116:     return posix_fd{fd};\n117: }\n118: // ��������� ���� \"������� �� �������\"\n119: constexpr int kExecFailed = 127;\n120: \n121: #endif\n122: \n123: // run_case <���������_���> <����_�����> <����_stdout> <����_stderr> -- <exe> [���...]\n124: int main(int argc, char* argv[]) {\n125:     if (argc < 7) {\n126:         std::print(stderr,\n127:                    \"6 or more arg-s are needed: <expect_code> <file_input> <file_stdout> <file_stderr> -- <exe>. \"\n128:                    \"Received: {}\\n\",\n129:                    argc - 1);\n130:         return 1;\n131:     }\n132: \n133:     if (std::string(argv[5]) != \"--\") {\n134:         std::print(stderr, \"Separator \\\"--\\\" is needed on 5th position, but {} was received instead\\n\", argv[5]);\n135:         return 1;\n136:     }\n137: \n138:     int expected_code = 0;\n139: \n140:     try {\n141:         expected_code = std::stoi(argv[1]);\n142:     } catch (const std::invalid_argument&) {\n143:         std::print(stderr, \"Expected exit-code is integer. Received: {}\\n\", argv[1]);\n144:         return 1;\n145:     } catch (const std::out_of_range&) {\n146:         std::print(stderr, \"Expected exit-code is integer and received number({}) - is beyond int.\\n\", argv[1]);\n147:         return 1;\n148:     }\n149: \n150: // �������-����������� ����� ��� �������� ��������� �������� � ����������� ����������� � ��������� ����\n151: #ifdef _WIN32\n152:     // ���� ������� ����� ������ �������, ����� �����\n153:     // hProcess - ����� �� ������ ���� �������. ����� ��� �������� ����������, ������ ����\n154:     // hThread - ����� �� ������ ���� �����(������� ����� ��������). �� ������������, �� ����� ����� ������� ���\n155:     // ������ ����������� ����� �� �������� ������ � �����\n156:     PROCESS_INFORMATION pi{};\n157: \n158:     //  ���������� ���� ��� �������������� ����������� in/out/err ������\n159:     {\n160: \n161:         // ������ �� ����� �����, ������ � ������\n162:         win_handle in = open_io_file(argv[2], GENERIC_READ, OPEN_EXISTING, \"open input file\");\n163:         if (!in)\n164:             return 1;\n165: \n166:         win_handle out = open_io_file(argv[3], GENERIC_WRITE, CREATE_ALWAYS, \"create output file\");\n167:         if (!out)\n168:             return 1;\n169: \n170:         win_handle err = open_io_file(argv[4], GENERIC_WRITE, CREATE_ALWAYS, \"create error file\");\n171:         if (!err)\n172:             return 1;\n173: \n174:         // ��������� ��� �������� ��������\n175:         // hStdInput/hStdOutput/hStdError - ��� ������� ������ �� ��������/��������� ����� in/out/err\n176:         // ��������� ��� �������� �������� � ���� STARTUPINFOA. ����� ������ ������ ����� �������� ����, ��� � run_case\n177:         STARTUPINFOA si{};\n178:         si.cb = sizeof(si);                // ������ ��������� = ������ STARTUPINFOA\n179:         si.dwFlags = STARTF_USESTDHANDLES; // ������ �������������� ��� ������\n180:         si.hStdInput = in.get();\n181:         si.hStdOutput = out.get();\n182:         si.hStdError = err.get();\n183: \n184:         // ������ ���� \"main.exe\" arg1 arg2 ...; ������� - �� �������� � ����\n185:         std::string cmdline = \"\\\"\" + std::string(argv[6]) + \"\\\"\";\n186:         for (int i = 7; i < argc; ++i) {\n187:             cmdline += ' ';\n188:             cmdline += argv[i];\n189:         }\n190: \n191:         // ��� ����� �� CreateProcessW � CreateProcessA ������ ����� �� �������. � char* -> wchar_t\n192:         // �����: ��-ASCII ���� ������� �� ���������. �� � ���� ��� ��������� � �����\n193:         // argv[6] - ��� ������������ �������� - ��������-��� ������������ �����\n194:         // cmdline.data() - ����������� ���� � ��� ��������� ��������� ������\n195:         // 3 � 4 NULL - ��� ����� ���������� ������������ ��� �������� � ������\n196:         // TRUE - ���� ������� ����� �����������. ��� ���������� ������� ���� in/out/err �� run_case\n197:         // NULL - ��������� �� ��������� - �� ���� �� ��������\n198:         // NULL - current working directory ��� � ��������\n199:         // startup info = si, process information = pi\n200:         if (!CreateProcessA(argv[6], cmdline.data(), NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)) {\n201:             print_win_error(\"run\", argv[6]);\n202:             return 1;\n203:         }\n204:     } // ����� ���������� �������� in/out/err ����� ����������� ��� run_case\n205: \n206:     win_handle hproc{pi.hProcess};\n207:     win_handle hthread{pi.hThread};\n208: \n209:     DWORD exit_code = 0;\n210:     // run_case ����������� � ���, ���� �� ���������� ������� pi.hProcess\n211:     // ��� ����������, �� ����� ���� �������� � ���� ��� ���� - ������ ������ � ����������\n212:     if (WaitForSingleObject(hproc.get(), INFINITE) != WAIT_OBJECT_0) {\n213:         print_win_error(\"reach the completion of\", argv[6]);\n214:         return 1;\n215:     }\n216:     // GetExitCodeProcess - ����� ��� ���������� �������� pi.hProcess � �������� � exit_code\n217:     // ��������, ���� ����� �� ������� ����� ����� ��� ����������\n218:     if (!GetExitCodeProcess(hproc.get(), &exit_code)) {\n219:         print_win_error(\"get the execution code\", argv[6]);\n220:         return 1;\n221:     }\n222: \n223:     // ��������� ������� ���� �������� � ����������\n224:     if (static_cast<int>(exit_code) != expected_code) {\n225:         std::print(stderr, \"expected code is {}; received code is {}\\n\", expected_code, exit_code);\n226:         return 1;\n227:     }\n228: \n229:     return 0;\n230: #else\n231:     // linux\n232:     // fork() ������� � pid ������������� �������� (���� ��� ���, � �������� -1)\n233:     // ����� ��� ���������� ��������: -1 - ��� ������� ��� fail; 0 - ��� ������� ������\n234:     // �������. ����� - ��� ������� ��������\n235:     pid_t pid = -1;\n236:     {\n237:         // �������� �������� ������������ � ��������, ����� ����� �������� �� ������\n238:         posix_fd in = open_io_file(argv[2], O_RDONLY | O_CLOEXEC, 0, \"open input file\");\n239:         if (!in)\n240:             return 1;\n241: \n242:         posix_fd out = open_io_file(argv[3], O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644, \"create output file\");\n243:         if (!out)\n244:             return 1;\n245: \n246:         posix_fd err = open_io_file(argv[4], O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644, \"create error file\");\n247:         if (!err)\n248:             return 1;\n249: \n250:         pid = fork(); // ����� ������������� �������� run_case\n251:         // �������� ���� �� ���������� ������� �������� ������� (pid=-1)\n252:         if (pid < 0) {\n253:             print_errno_error(\"create a child process to run\", argv[6]);\n254:             return 1;\n255:         }\n256:         // ����� pid ����� � ������. � ���� ����� - ������ � �������� ������\n257:         if (pid == 0) {\n258:             // ������: ������������� 0/1/2 �� �����\n259:             if (dup2(in.get(), STDIN_FILENO) < 0 || dup2(out.get(), STDOUT_FILENO) < 0 ||\n260:                 dup2(err.get(), STDERR_FILENO) < 0) {\n261:                 int errno_copy = errno;\n262:                 std::print(stderr, \"Can not redirect streams: {}\\n\",\n263:                            std::error_code(errno_copy, std::generic_category()).message());\n264:                 _exit(kExecFailed);\n265:             }\n266:             // ������ ���� run_case �� ��� main (��� ��� ��������) � ������\n267:             // ���������������� ������ �������� ��� � ����\n268:             execv(argv[6], &argv[6]);\n269: \n270:             // ������� ������ execv\n271:             int errno_copy = errno;\n272:             std::print(stderr, \"Can not run {}: {}\\n\", argv[6],\n273:                        std::error_code(errno_copy, std::generic_category()).message());\n274:             // ��������� ������� ������\n275:             _exit(kExecFailed);\n276: \n277:             // � �������� ������ - ��������� ���� � execv ���� � _exit; ������ �� ���� ����� �� ������\n278:             // � �� ������, �.�. ����� - ��� ��������\n279:         }\n280:     } // ��� 3�� fd run_case-� ����������� ������������� ������, �.�. ����� �� ����. ������\n281: \n282:     // ��������� ��� exit-���� ������\n283:     int status = 0;\n284:     // ��� ������� ���������� �������� ������\n285:     // pid - ������ ��������� �������� � ���� id\n286:     // status - ������ ��� �� ������\n287:     // 0 - ��� ������ ����������, � ��������� ��� �����\n288:     // ��� waitpid < 0 �� ������� ��������� ������ ���������� �������� � ���� pid. ����� �������\n289:     // ���������� ������ errno == EINTR. �� ����, ����� �� ������ ������� ������� ����. �������\n290:     if (waitpid(pid, &status, 0) < 0) {\n291:         print_errno_error(\"wait for the process of\", argv[6]);\n292:         return 1;\n293:     }\n294: \n295:     // �������� ����, ��� ���������� ������: ������ ��� ���������\n296:     // WIFEXITED - ������, ���� true, ���� ������ ���������� ������, � �� �� sigkill/sigsegv/etc\n297:     if (WIFEXITED(status)) {\n298:         // WEXITSTATUS - �� ���� ����� ���������� ����������� ������ ��� ��������\n299:         int exit_code = WEXITSTATUS(status);\n300:         // ����� �������� ��� � ��������� �� �������\n301:         if (exit_code != expected_code) {\n302:             std::print(stderr, \"expected code is {}; received code is {}\\n\", expected_code, exit_code);\n303:             return 1;\n304:         }\n305:     }\n306:     // ������� ���������� �� ���, � � �����. �������� ����������\n307:     // � ������ ��������� ����� asan ����� ������ / ��� ����������� ��������� � ������ / ...\n308:     else if (WIFSIGNALED(status)) {\n309:         std::print(stderr, \"expected code is {}; process was terminated by signal {}\\n\", expected_code,\n310:                    WTERMSIG(status));\n311:         return 1;\n312:     }\n313:     // ���� �� ������� �������� ����� WIFSIGNALED. ��� ���������� ������ ����� ����������\n314:     // ���� ����������� � �������\n315:     else {\n316:         std::print(stderr, \"expected code is {}; process ended with unexpected status\\n\", expected_code);\n317:         return 1;\n318:     }\n319: \n320:     return 0;\n321: #endif\n322: }\n\n(End of file - total 322 lines)\n</content>",
