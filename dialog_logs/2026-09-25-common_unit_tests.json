              "patch": "Index: common/geometry.c\n===================================================================\n--- common/geometry.c\t\n+++ common/geometry.c\t\n@@ -1,80 +1,81 @@\n #include \"geometry.h\"\r\n \r\n #include <ctype.h>\r\n #include <errno.h>\r\n #include <math.h>\r\n #include <stdlib.h>\r\n \r\n #include \"string_utils.h\"\r\n \r\n // ������������� �����. ������ ��� �������� �����\r\n // ���� ��������� ������:\r\n int parse_point(const char* str, struct Point* p) {\r\n     // ��������� �� ������ ������\r\n     const char* pointer = str;\r\n     // ������ ���������, ���� ����� �������� ����� ������������� �����\r\n     char* end = NULL;\r\n \r\n     int i = 0;\r\n     double d[3];\r\n     while (i < 3) {\r\n         // ���������� ��������� ������� � ������� - �� ����� �� ������?\r\n         while (isspace((unsigned char)*pointer))\r\n             ++pointer;\r\n-        if(*pointer == '\\0') break;\r\n+        if (*pointer == '\\0')\r\n+            break;\r\n \r\n         // �������� �������� 16��. ���� ���� - ������������ ��� ������������\r\n         if (is_hex_prefix(pointer))\r\n             return NUMBER_NOT_NUMBER;\r\n \r\n         // ������ � ���� �� ������� ����������\r\n         errno = 0;\r\n         // ������� ���������� �����\r\n         d[i] = strtod(pointer, &end);\r\n         // ���� ��� ������������� underflow/overflow\r\n         if (errno == ERANGE && (d[i] == 0.0 || !isfinite(d[i])))\r\n             return NUMBER_OUT_OF_RANGE;\r\n         // �������� ������ ����, ��� ��� �� nan / inf\r\n         if (!isfinite(d[i]))\r\n             return NUMBER_NOT_FINITE;\r\n         // ��������� - �.�. ���������� ������;\r\n         // ��� ����� ���� ��������� �� �� �������/����� ��� � ����� ������ ������ ��� ���������� ������,\r\n         //  ����� end == pointer\r\n         if (end == pointer || (*end != '\\0' && !isspace((unsigned char)*end)))\r\n             return NUMBER_NOT_NUMBER;\r\n         // ����������� ��������� � �����, ��� ���������� ������������� �����\r\n         pointer = end;\r\n         // ����� �� �-�� �������� ����� �����. �����, �.�. ��� �������� �� 4� ���. ������� ��������\r\n         while (isspace((unsigned char)*pointer))\r\n             ++pointer;\r\n         ++i;\r\n     }\r\n \r\n     // ���� ������ ������ ���, � ������ ����������� - ��������� ������ �������\r\n     if (i != 3)\r\n         return NUMBER_TOO_FEW;\r\n \r\n     // ���� ������ ���������� ���, � ������ ���-�� ��� (������� ����� 3 ����� ��� �������) - ��� ������ �����, ���\r\n     // ������\r\n     if (i == 3 && *pointer != '\\0') {\r\n         // ���� ��� hex �����, �� ������������ ��� ��� ��-�����. � �� ��� \"������ ��� ����� x y z\"\r\n         if (is_hex_prefix(pointer))\r\n             return NUMBER_NOT_NUMBER;\r\n         // ���� ���� ��� �� X Y Z. ������� ��� ��� ������, ��� ��� ��� ����������\r\n         errno = 0;\r\n         double extra = strtod(pointer, &end);\r\n         // ���� ��� ������������� underflow/overflow\r\n         if (errno == ERANGE && (extra == 0.0 || !isfinite(extra)))\r\n             return NUMBER_OUT_OF_RANGE;\r\n         // ���� � ������ ������ ������ (end == ptr) ��� end ����������� �� �� ���������� - ������ �������� � ��-�����\r\n         if (end == pointer || (*end != '\\0' && !isspace((unsigned char)*end)))\r\n             return NUMBER_NOT_NUMBER;\r\n         // ����� - ��� ������ �����\r\n         else\r\n             return NUMBER_TOO_MUCH;\r\n     }\r\n \r\n     *p = (struct Point){.x = d[0], .y = d[1], .z = d[2]};\r\n \r\n     return 0;\r\n }\r\n",
