            "output": "<path>C:\\Users\\User\\Desktop\\inobitec_stud\\CMakeLists.txt</path>\n<type>file</type>\n<content>\n1: # минимальная необходимая версия cmake + свежие политики (конкретные точки поведения) до 3.22 \n2: # в старых CMake-ах выполнение остановится здесь, с требованием версии 3.22\n3: # политика - как себя ведёт что-либо в CMake. если не указать версию, то default=OLD и будет warning, \n4: # т.к. старые политики - для совместимости, но не обещают корретности\n5: cmake_minimum_required(VERSION 3.22)\n6: \n7: # проверка наличия ninja, если задан именно этот генератор. до проверки компилятора в project() \n8: if(CMAKE_GENERATOR MATCHES \"^Ninja\")\n9:   # find_program ищет в PATH и кэширует результат в CMakeCache.txt как NINJA_EXECUTABLE\n10:   find_program(NINJA_EXECUTABLE NAMES ninja)\n11:   if(NOT NINJA_EXECUTABLE)\n12:     message(FATAL_ERROR\n13:       \"The '${CMAKE_GENERATOR}' generator was selected, but ninja was not found. \"\n14:       \"Install ninja or add its directory to PATH\")\n15:   endif()\n16:   # сообщение при конфигурации\n17:   message(STATUS \"ninja: ${NINJA_EXECUTABLE}\")\n18: # else отсутствует - пока что в проекте генератор - именно Ninja\n19: endif()\n20: \n21: # имя проекта сохранится в CMAKE_PROJECT_NAME\n22: # определяются яызки проекта: с с++; определится компилятор; \n23: # появятся перменные (типа CMAKE_C_FLAGS_DEBUG) заполненные дефолтными значениями\n24: project(inobitec_stud LANGUAGES C CXX)\n25: \n26: # какой инстанс vcpkg реально подключён - защита от тихой подмены инструмента\n27: # CMAKE_TOOLCHAIN_FILE путь к скрипт vcpkg.cmake\n28: # Z_VCPKG_ROOT_DIR корень vcpkg, вычисляется им самим. т.е. из какого инстанса идёт инструмент\n29: # триплет: профиль сборки. у меня сейчас x64-windows - x64, винда, динамич. линковка\n30: if(VCPKG_TARGET_TRIPLET)\n31:   message(STATUS \"vcpkg toolchain: ${CMAKE_TOOLCHAIN_FILE}\")\n32:   if(DEFINED Z_VCPKG_ROOT_DIR)\n33:     message(STATUS \"vcpkg instance : ${Z_VCPKG_ROOT_DIR}\")\n34:   endif()\n35:   message(STATUS \"vcpkg triplet  : ${VCPKG_TARGET_TRIPLET}\")\n36: endif()\n37: \n38: # === СТАНДАРТЫ ===\n39: # стандарт языка Си\n40: set(CMAKE_C_STANDARD 17)\n41: # компилятор обязан поддерживать этот стандарт языка. иначе - ошибка во время конфигурации CMakeLists (прекомпил.)\n42: set(CMAKE_C_STANDARD_REQUIRED ON)\n43: # только стандартный компилятор языка, без расширений, типа gnu-расширений\n44: set(CMAKE_C_EXTENSIONS OFF)\n45: # то же для с++\n46: set(CMAKE_CXX_STANDARD 23)\n47: set(CMAKE_CXX_STANDARD_REQUIRED ON)\n48: set(CMAKE_CXX_EXTENSIONS OFF)\n49: \n50:                                \n51: # === ТИП СБОРКИ ===\n52: # определение debug / release; делается через -DCMAKE_BUILD_TYPE=...\n53: # Debug будет поставлен, если ничего не передали через флаг\n54: if(NOT CMAKE_BUILD_TYPE)\n55:   set(CMAKE_BUILD_TYPE Debug CACHE STRING \"Build type (Debug/Release)\" FORCE)\n56: endif()\n57: # переменная CMAKE_BUILD_TYPE уйдёт в кэш \n58: # кэш: для CMake, хранить инф. м-у выполнениями, и пользователь не повторяет ввод каждый раз\n59: # FORCE вызовет перезапись параметра\n60: \n61: \n62: # === ИСПРАВЛЕНИЕ DEFAULT-ФЛАГОВ ===\n63: # CMAke дефолтно положит /RTC1 в debug-ветку. /RTC1 ловит ошибки в runtime, для этого лезет в стек и размечает его\n64: # ASan - та же ф-ция. если оба будут менять стек, они помешают друг другу -> несовместимы. /RTC1 убирается \n65: # /incremental также несовместим с asan (именно по документации. так работало и когда оба вместе)\n66: if(MSVC)\n67:   string(REPLACE \"/RTC1\" \"\" CMAKE_C_FLAGS_DEBUG   \"${CMAKE_C_FLAGS_DEBUG}\")\n68:   string(REPLACE \"/RTC1\" \"\" CMAKE_CXX_FLAGS_DEBUG \"${CMAKE_CXX_FLAGS_DEBUG}\")\n69:   string(REPLACE \"/INCREMENTAL\" \"\" CMAKE_EXE_LINKER_FLAGS_DEBUG  \"${CMAKE_EXE_LINKER_FLAGS_DEBUG}\")\n70: endif()\n71: \n72: \n73: # === ПОСТРОИТЬ КОМАНДЫ КОМПИЛЯЦИИ И ЛИНКА ===\n74: function(configure_target trgt DBG)\n75: if(MSVC)\n76:   # в msvc /Zi, /EHsc, /DEBUG  будут дублироваться, но прописываются для ясности\n77:   # target_compile_options - произвольные флаги компилятора \n78:   # PRIVATE даёт нетранзитивность: А (этот объект) и Б к нему сможет линковаться. а когда К линк. к Б, то К не будет линк. к А\n79:   target_compile_options(${trgt} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:/EHsc> /W4 /permissive-)\n80: \n81:   # сюда будет заходить только для программ из задач, не для программ для тестирования (run_case, check) - им эти флаги не нужны\n82:   if(DBG)\n83:     # CMake проставит след. флаги автоматиечки: /Od /O2; /MDd /MD; /DNDEBUG\n84:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Debug>:/Zi /fsanitize=address> $<$<CONFIG:Release>:/Zi>)\n85:     target_link_options(${trgt} PRIVATE $<$<CONFIG:Debug>:/DEBUG> $<$<CONFIG:Release>:/DEBUG /OPT:REF /OPT:ICF>)\n86:   endif()\n87: \n88: else()\n89:   target_compile_options(${trgt} PRIVATE -Wall -Wextra)\n90:   # и в ветке продуктов, и в ветке тестовых программ оптимизация на релизе будет именно -O2, а не cmake-default -O3\n91:   if (DBG) \n92:     # -O0 на дебаге будет подтянут CMake автоматически, а на релизе -DNDEBUG\n93:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Debug>: -g -fsanitize=address> $<$<CONFIG:Release>: -g -O2>)\n94:     target_link_options(${trgt} PRIVATE $<$<CONFIG:Debug>: -fsanitize=address>)\n95:   else()\n96:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Release>: -O2>)\n97:   endif()\n98: endif()\n99: endfunction()\n100: \n101: \n102: # === Ф-ЦИЯ ДОБАВЛЕНИЯ ЗАДАЧИ === \n103: # сборки exe из main.c/main.cpp; уходит в каталог build/cfg/dir\n104: function(add_task dir trgt src lib)\n105:   # добавление исполняемного файла \n106:   # цель и её исходник. цель имеет одно имя (логическое, типа t1_c), а сделанный ею файл - другое (OUTPUT_NAME main)\n107:   add_executable(${trgt} ${src})\n108: \n109:   # в CMAKE_BINARY_DIR будет тот каталог, который был передан по -B\n110:   set_target_properties(${trgt} PROPERTIES\n111:   OUTPUT_NAME main\n112:   RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/${dir})\n113: \n114:   # с кем линкуемся\n115:   # тут private не имеет смысла (.exe конечен, к нему не линкуются), просто для единообразия\n116:   target_link_libraries(${trgt} PRIVATE ${lib})\n117: \n118:   # определение типа библиотеки т.к. на windows для .dll нужно доп. действие для связки с .exe\n119:   get_target_property(lib_type ${lib} TYPE)\n120:   # копирование dll в папку к exe даже если сам exe не перестраивался\n121:   if(WIN32 AND lib_type STREQUAL \"SHARED_LIBRARY\")\n122:     set(copied_dll \"${CMAKE_BINARY_DIR}/${dir}/${lib}.dll\")\n123:     add_custom_command(OUTPUT \"${copied_dll}\"\n124:       COMMAND ${CMAKE_COMMAND} -E copy_if_different $<TARGET_FILE:${lib}> \"${CMAKE_BINARY_DIR}/${dir}\"\n125:       DEPENDS ${lib} \n126:       COMMENT \"Copying DLL ${lib} next to ${trgt}\"\n127:       VERBATIM)\n128:     add_custom_target(${trgt}_dll DEPENDS \"${copied_dll}\")\n129:     add_dependencies(${trgt} ${trgt}_dll)\n130:   endif()\n131: \n132:   # команда для cl+link. флаг DEBUG = ON - т.е. пойдём по ветке if (DBG) с флагами для программ-задач\n133:   configure_target(${trgt} ON)\n134:  \n135: endfunction()\n136: \n137: # === ПОДПРОЕКТ ДЛЯ СОЗДАНИЯ БИБЛИОТЕК === \n138: # add_subdirectory(source_dir [binary_dir] ...)\n139: # source_dir - где лежит вложенный CMakeLists.txt /common)\n140: # binary_dir - где положить служеб. файлы CMake для подпроекта (если не указано, то в CMAKE_BINARY_DIR/source_dir)  \n141: add_subdirectory(common)\n142: \n143: \n144: # === ДОБАВЛЕНИЕ ЗАДАЧ ===\n145: # arg1 - папка бинарей и прочих продуктов (build/cfg/...)\n146: # arg2 - логическое имя цели\n147: # arg3 - исходник, чтобы сделать файл цели\n148: # arg4 - библиотека с которой линковаться\n149: \n150: # TASK 1\n151: add_task(t1_dist_matrix_cpp t1_cpp t1_dist_matrix_cpp/main.cpp common_cpp_static)\n152: add_task(t1_dist_matrix_c t1_c t1_dist_matrix_c/main.c common_c_static)\n153: \n154: # TASK 2\n155: add_task(t2_passport_cpp t2_cpp t2_passport_cpp/main.cpp string_utils_cpp_static)\n156: add_task(t2_passport_c t2_c t2_passport_c/main.c string_utils_c_static)\n157: \n158: # TASK 3\n159: add_task(t3_bbox_cpp t3_cpp t3_bbox_cpp/main.cpp common_cpp_shared)\n160: add_task(t3_bbox_c t3_c t3_bbox_c/main.c common_c_shared)\n161: \n162: # TASK 4\n163: add_task(t4_filter_cpp t4_cpp t4_filter_cpp/main.cpp common_cpp_shared)\n164: add_task(t4_filter_c t4_c t4_filter_c/main.c common_c_shared)\n165: \n166: # === ФОРМАТИРОВАНИЕ ===\n167: \n168: # cmake/format.cmake в скриптовом режиме. отделен он графа сборки проекта\n169: set(FORMAT_SCRIPT \"${CMAKE_SOURCE_DIR}/cmake/format.cmake\")\n170: \n171: # исключаем весь каталог сборки, а не только текущую конфигурацию:\n172: # конфигурации вложены (build/debug, build/release)\n173: set(FORMAT_BUILD_ROOT \"${CMAKE_BINARY_DIR}\")\n174: get_filename_component(FORMAT_BUILD_PARENT \"${CMAKE_BINARY_DIR}\" DIRECTORY)\n175: if(NOT FORMAT_BUILD_PARENT STREQUAL CMAKE_SOURCE_DIR)\n176:   set(FORMAT_BUILD_ROOT \"${FORMAT_BUILD_PARENT}\")\n177: endif()\n178: \n179: # один и тот же source-dir и build-dir, изменяется только check/apply - он добавляется в командах\n180: # общая часть из source-dir и build-dir\n181: set(FORMAT_COMMON -DSRC_DIR=${CMAKE_SOURCE_DIR} -DBUILD_DIR=${FORMAT_BUILD_ROOT} -P ${FORMAT_SCRIPT})\n182: \n183: # отформатировать\n184: add_custom_target(format\n185:   COMMAND ${CMAKE_COMMAND} -DMODE=apply ${FORMAT_COMMON}\n186:   COMMENT \"Applying clang-format to all C/C++ files\")\n187: \n188: # проверить формат (в этом же виде вызывается из ctest)\n189: add_custom_target(format-check\n190:   COMMAND ${CMAKE_COMMAND} -DMODE=check ${FORMAT_COMMON}\n191:   COMMENT \"Checking clang-format of all C/C++ files\")\n192: \n193: # === TESTS ===\n194: enable_testing()\n195: # первый тест: проверка чистоты формата\n196: # если есть clang+format - проверка строгая, не-падение - только при чистом формате\n197: # иначе - warning и тесты\n198: add_test(NAME format-check COMMAND ${CMAKE_COMMAND} -DMODE=check ${FORMAT_COMMON}) \n199: # тесты на знчения и коды\n200: add_subdirectory(tests) \n\n(End of file - total 200 lines)\n</content>",
            "metadata": {
              "preview": "# минимальная необходимая версия cmake + свежие политики (конкретные точки поведения) до 3.22 \n# в старых CMake-ах выполнение остановится здесь, с требованием версии 3.22\n# политика - как себя ведёт что-либо в CMake. если не указать версию, то default=OLD и будет warning, \n# т.к. старые политики - для совместимости, но не обещают корретности\ncmake_minimum_required(VERSION 3.22)\n\n# проверка наличия ninja, если задан именно этот генератор. до проверки компилятора в project() \nif(CMAKE_GENERATOR MATCHES \"^Ninja\")\n  # find_program ищет в PATH и кэширует результат в CMakeCache.txt как NINJA_EXECUTABLE\n  find_program(NINJA_EXECUTABLE NAMES ninja)\n  if(NOT NINJA_EXECUTABLE)\n    message(FATAL_ERROR\n      \"The '${CMAKE_GENERATOR}' generator was selected, but ninja was not found. \"\n      \"Install ninja or add its directory to PATH\")\n  endif()\n  # сообщение при конфигурации\n  message(STATUS \"ninja: ${NINJA_EXECUTABLE}\")\n# else отсутствует - пока что в проекте генератор - именно Ninja\nendif()\n",
