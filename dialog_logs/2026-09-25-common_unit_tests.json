            "output": "<path>C:\\Users\\User\\Desktop\\inobitec_stud\\tests\\CMakeLists.txt</path>\n<type>file</type>\n<content>\n1: add_executable(run_case run_case.cpp)\n2: configure_target(run_case OFF)\n3: \n4: add_executable(check check.cpp)\n5: configure_target(check OFF)\n6: \n7: # дымовая цель gtest\n8: # find_package с gtest именно тут т.к. корневому CMakeLists gtest не нужен\n9: # find_package(GTest - найди и прочитай описание пакета GTest\n10: # в описании сказано, как библиотека называется для CMake, где бинарники, headers\n11: # CONFIG - читай именно описание от автора библиотеки (GTestConfig.cmake), не \"догадываться\"\n12: # REQUIRED - если пошло некорректно - падаем. не идём тихо с ошибкой\n13: find_package(GTest CONFIG REQUIRED)\n14: # благодаря vcpkg GTestConfig.cmake найдётся. т.к. vcpkg.cmake Добавил build/<cfg>/vcpkg_installed/.../share\n15: # в список каталогов по которому CMake ведёт поиск\n16: \n17: # маленькая тестовая программа\n18: add_executable(gtest_smoke gtest_smoke.cpp)\n19: # конфигурируется как тестовая обвязка, не продукт для тестирования\n20: configure_target(gtest_smoke OFF)\n21: # GTest::gtest_main появилось на этапе find_package, как и др. импортированные цели \n22: # (это пути к headers / .lib) \n23: target_link_libraries(gtest_smoke PRIVATE GTest::gtest_main)\n24: add_test(NAME gtest_smoke COMMAND gtest_smoke)\n25: \n26: file(MAKE_DIRECTORY \"${CMAKE_CURRENT_BINARY_DIR}/results\")\n27: \n28: # test_name - имя таргета теста\n29: # exe - программа которая будет проверяться\n30: # args - аргументы командной строки для exe\n31: # input - входные данные для exe\n32: # expected_excode - ожидаемый код завершения\n33: # check_flag - для check (--equal / --contains)\n34: # expected_result - ожидаемый вывод программы; НЕ абсолют. путь, а просто имя\n35: # stream - поток, вывод которого будет сравниваться с expected_result\n36: function(add_case test_name exe args input expected_excode check_flag expected_result stream)\n37: \n38: # по этим аргументам будет развилка, так что проверка сразу. если что падает тут до первого теста\n39: # разнесены по двум if т.к. это независимые проверки\n40: # при mode=FATAL_ERROR остановка обработки и генерации. падение CMake c ненулевым кодом\n41: \n42: if(NOT \"${check_flag}\" STREQUAL \"CONTAINS\" AND NOT \"${check_flag}\" STREQUAL \"EQ\")\n43:   message(FATAL_ERROR \"unknown flag for check. expected CONTAINS for containing and EQ for equality\")\n44: endif()\n45: \n46: if(NOT ${stream} EQUAL 1 AND NOT ${stream} EQUAL 2)\n47:   message(FATAL_ERROR \"unknown stream type. expected 1 for stdout and 2 for stderr\" )\n48: endif()\n49: \n50: # имя теста на код: test_name + _code\n51: set(CODE_TEST \"${test_name}_code\")\n52: # имя файла stdout\n53: set(STDOUT_FILE \"${CMAKE_CURRENT_BINARY_DIR}/results/${test_name}.out\")\n54: # имя файла stderr\n55: set(STDERR_FILE \"${CMAKE_CURRENT_BINARY_DIR}/results/${test_name}.err\")\n56: \n57: # входное знаение м.б. или файлом, или папкой (для теста на IO fail)\n58: # для относит. путей считается, что это файл и он в /input_data; абсолютные берутся как есть\n59: if(IS_ABSOLUTE \"${input}\")\n60:   set(INPUT_PATH \"${input}\")\n61: else()\n62:   set(INPUT_PATH \"${CMAKE_CURRENT_SOURCE_DIR}/input_data/${input}\")\n63: endif() \n64: \n65: # тест_1 на код всегда безусловен и одинаков по сигнатуре\n66: add_test(NAME ${CODE_TEST} COMMAND $<TARGET_FILE:run_case> ${expected_excode}\n67:  ${INPUT_PATH}\n68:  ${STDOUT_FILE}\n69:  ${STDERR_FILE}\n70:  --\n71:  $<TARGET_FILE:${exe}>\n72:  ${args})\n73: # args без кавычек чтобы не ломалось на пустоте и на \"лишних\" аргументах\n74: \n75: # устновка имени выходного файла и теста в зависимоти от потока stdout(1)/stderr(2) \n76: if(${stream} EQUAL 1)\n77:   set(PROGRAMM_RESULT ${STDOUT_FILE})\n78:   set(RESULT_TEST \"${test_name}_stdout\")\n79: elseif(${stream} EQUAL 2)\n80:   set(PROGRAMM_RESULT ${STDERR_FILE})\n81:   set(RESULT_TEST \"${test_name}_stderr\")\n82: endif()\n83: \n84: # установка 