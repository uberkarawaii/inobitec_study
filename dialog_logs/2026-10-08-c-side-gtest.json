_static PUBLIC COMMON_STATIC) \n37: target_compile_definitions(string_utils_c_static PUBLIC COMMON_STATIC)\n38: \n39: configure_target(string_utils_cpp_static ON)\n40: configure_target(string_utils_c_static ON)\n41: \n42: \n43: # === T3-T4 СБОРКА ДИНАМИЧЕСКОЙ БИБЛИОТЕКИ ===\n44: add_library(common_cpp_shared SHARED geometry.cpp string_utils.cpp)\n45: add_library(common_c_shared SHARED geometry.c string_utils.c)\n46: \n47: # тут PRIVATE, т.к. main t3-t4 не должны иметь этот флаг, чтобы у них внутри был dllimport\n48: target_compile_definitions(common_cpp_shared PRIVATE COMMON_EXPORTS)\n49: target_compile_definitions(common_c_shared PRIVATE COMMON_EXPORTS)\n50: \n51: if(UNIX)\n52:   target_link_libraries(common_c_shared PUBLIC m)\n53: endif()\n54: \n55: configure_target(common_cpp_shared ON)\n56: configure_target(common_c_shared ON)\n\n(End of file - total 56 lines)\n</content>",
