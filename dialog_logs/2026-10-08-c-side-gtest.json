            "output": "<path>C:\\Users\\User\\Desktop\\inobitec_stud\\CMakeLists.txt</path>\n<type>file</type>\n<content>\n1: # минимальная необходимая версия cmake + свежие политики (конкретные точки поведения) до 3.22 \n2: # в старых CMake-ах выполнение остановится здесь, с требованием версии 3.22\n3: # политика - как себя ведёт что-либо в CMake. если не указать версию, то default=OLD и будет warning, \n4: # т.к. старые политики - для совместимости, но не обещают корретности\n5: cmake_minimum_required(VERSION 3.22)\n6: \n7: # проверка наличия ninja, если задан именно этот генератор. до проверки компилятора в project() \n8: if(CMAKE_GENERATOR MATCHES \"^Ninja\")\n9:   # find_program ищет в PATH и кэширует результат в CMakeCache.txt как NINJA_EXECUTABLE\n10:   find_program(NINJA_EXECUTABLE NAMES ninja)\n11:   if(NOT NINJA_EXECUTABLE)\n12:     message(FATAL_ERROR\n13:       \"The '${CMAKE_GENERATOR}' generator was selected, but ninja was not found. \"\n14:       \"Install ninja or add its directory to PATH\")\n15:   endif()\n16:   # сообщение при конфигурации\n17:   message(STATUS \"ninja: ${NINJA_EXECUTABLE}\")\n18: # else отсутствует - пока что в проекте генератор - именно Ninja\n19: endif()\n20: \n21: \n22: # === ПРОВЕРКА BASELINE ===\n23: # делается до project, иначе будет падение не от моей проверки с моим сообщением,\n24: # а при vcpkg install - каскад падений\n25: \n26: # надо понять: \"вложена\" ли требуемая версия в имеющийся инстанс vcpkg. для этого используем git\n27: # проверка что он есть - иначе нет инструмента для проверки\n28: find_program(GIT_EXECUTABLE NAMES git)\n29: if(NOT GIT_EXECUTABLE)\n30:   message(FATAL_ERROR \"git was not found in PATH; it is required to check the vcpkg baseline\")\n31: endif()\n32: \n33: # при поиске инстанса опираемся на переменную среды VCPKG_DEV_ROOT - если её нет, падаем\n34: # иначе не сможем понять, какой именно инстанс\n35: if(NOT DEFINED ENV{VCPKG_DEV_ROOT} OR \"$ENV{VCPKG_DEV_ROOT}\" STREQUAL \"\")\n36:   message(FATAL_ERROR \"VCPKG_DEV_ROOT is not set; it must point to the vcpkg clone used by the toolchain\")\n37: endif()\n38: \n39: # чтение vcpkg.json из корня проекта, чтобы определить baseline\n40: # _vcpkg_manifest - весь vcpkg.json; _m - builtin-baseline найденный по regex  \n41: file(READ \"${CMAKE_SOURCE_DIR}/vcpkg.json\" _vcpkg_manifest)\n42: string(REGEX MATCH \"\\\"builtin-baseline\\\"[ \\t]*:[ \\t]*\\\"([0-9a-fA-F]+)\\\"\" _m \"${_vcpkg_manifest}\")\n43: # если builtin-baseline не нашёлся, то падение с ошибкой \n44: if(NOT _m)\n45:   message(FATAL_ERROR \"builtin-baseline was not found in vcpkg.json\")\n46: endif()\n47: # CMAKE_MATCH_1 - то что попало в первую группу regex - т.е. ([0-9a-fA-F]+), сам sha\n48: set(VCPKG_BASELINE \"${CMAKE_MATCH_1}\")\n49: \n50: # запуск подпроцесса git из папки клона vcpkg\n51: # cat-file -e X - есть ли объект Х в базе? результат: 0(успех) или не-нуль(нет в базе), уйдёт в _baseline_ok\n52: # \"${VCPKG_BASELINE}^{commit}\" - объект-коммит выделенного sha. если такого коммита нет - падение с не-нуль  \n53: execute_process(\n54:   COMMAND \"${GIT_EXECUTABLE}\" -C \"$ENV{VCPKG_DEV_ROOT}\" cat-file -e \"${VCPKG_BASELINE}^{commit}\"\n55:   RESULT_VARIABLE _baseline_ok\n56:   OUTPUT_QUIET\n57:   ERROR_QUIET)\n58: \n59: # если такого объекта нет в базе - падение с сообщением. если есть - тоже оповещаем\n60: if(NOT _baseline_ok EQUAL 0)\n61:   message(FATAL_ERROR\n62:     \"builtin-baseline ${VCPKG_BASELINE} is not reachable in the vcpkg instance at \"\n63:     \"$ENV{VCPKG_DEV_ROOT}. Run 'git fetch' in that clone and try again.\")\n64: endif()\n65: \n66: message(STATUS \"vcpkg baseline : ${VCPKG_BASELINE} (reachable in $ENV{VCPKG_DEV_ROOT})\")\n67: \n68: # выключение механизма vcpkg applocal, т.к. он вызывает конфликты (мн-во пересозданий себя в %TEMP%) при -j билде\n69: set(VCPKG_APPLOCAL_DEPS OFF CACHE BOOL \"Deploy vcpkg runtime DLLs via CMake instead of vcpkg applocal\" FORCE)\n70: \n71: # имя проекта сохранится в CMAKE_PROJECT_NAME\n72: # определяются яызки проекта: с с++; определится компилятор; \n73: # появятся перменные (типа CMAKE_C_FLAGS_DEBUG) заполненные дефолтными значениями\n74: project(inobitec_stud VERSION 0.1.0 LANGUAGES C CXX)\n75: \n76: # какой инстанс vcpkg реально подключён - защита от тихой подмены инструмента\n77: # CMAKE_TOOLCHAIN_FILE путь к скрипт vcpkg.cmake\n78: # Z_VCPKG_ROOT_DIR корень vcpkg, вычисляется им самим. т.е. из какого инстанса идёт инструмент\n79: # триплет: профиль сборки. у меня сейчас x64-windows - x64, винда, динамич. линковка\n80: if(VCPKG_TARGET_TRIPLET)\n81:   message(STATUS \"vcpkg toolchain: ${CMAKE_TOOLCHAIN_FILE}\")\n82:   if(DEFINED Z_VCPKG_ROOT_DIR)\n83:     message(STATUS \"vcpkg instance : ${Z_VCPKG_ROOT_DIR}\")\n84:   endif()\n85:   message(STATUS \"vcpkg triplet  : ${VCPKG_TARGET_TRIPLET}\")\n86: endif()\n87: \n88: # === СТАНДАРТЫ ===\n89: # стандарт языка Си\n90: set(CMAKE_C_STANDARD 17)\n91: # компилятор обязан поддерживать этот стандарт языка. иначе - ошибка во время конфигурации CMakeLists (прекомпил.)\n92: set(CMAKE_C_STANDARD_REQUIRED ON)\n93: # только стандартный компилятор языка, без расширений, типа gnu-расширений\n94: set(CMAKE_C_EXTENSIONS OFF)\n95: # то же для с++\n96: set(CMAKE_CXX_STANDARD 23)\n97: set(CMAKE_CXX_STANDARD_REQUIRED ON)\n98: set(CMAKE_CXX_EXTENSIONS OFF)\n99: \n100:                                \n101: # === ТИП СБОРКИ ===\n102: # определение debug / release; делается через -DCMAKE_BUILD_TYPE=...\n103: # Debug будет поставлен, если ничего не передали через флаг\n104: if(NOT CMAKE_BUILD_TYPE)\n105:   set(CMAKE_BUILD_TYPE Debug CACHE STRING \"Build type (Debug/Release)\" FORCE)\n106: endif()\n107: # переменная CMAKE_BUILD_TYPE уйдёт в кэш \n108: # кэш: для CMake, хранить инф. м-у выполнениями, и пользователь не повторяет ввод каждый раз\n109: # FORCE вызовет перезапись параметра\n110: \n111: \n112: # === ИСПРАВЛЕНИЕ DEFAULT-ФЛАГОВ ===\n113: # CMAke дефолтно положит /RTC1 в debug-ветку. /RTC1 ловит ошибки в runtime, для этого лезет в стек и размечает его\n114: # ASan - та же ф-ция. если оба будут менять стек, они помешают друг другу -> несовместимы. /RTC1 убирается \n115: # /incremental также несовместим с asan (именно по документации. так работало и когда оба вместе)\n116: if(MSVC)\n117:   string(REPLACE \"/RTC1\" \"\" CMAKE_C_FLAGS_DEBUG   \"${CMAKE_C_FLAGS_DEBUG}\")\n118:   string(REPLACE \"/RTC1\" \"\" CMAKE_CXX_FLAGS_DEBUG \"${CMAKE_CXX_FLAGS_DEBUG}\")\n119:   string(REPLACE \"/INCREMENTAL\" \"\" CMAKE_EXE_LINKER_FLAGS_DEBUG  \"${CMAKE_EXE_LINKER_FLAGS_DEBUG}\")\n120: endif()\n121: \n122: \n123: # === ПОСТРОИТЬ КОМАНДЫ КОМПИЛЯЦИИ И ЛИНКА ===\n124: function(configure_target trgt DBG)\n125: if(MSVC)\n126:   # в msvc /Zi, /EHsc, /DEBUG  будут дублироваться, но прописываются для ясности\n127:   # target_compile_options - произвольные флаги компилятора \n128:   # PRIVATE даёт нетранзитивность: А (этот объект) и Б к нему сможет линковаться. а когда К линк. к Б, то К не будет линк. к А\n129:   target_compile_options(${trgt} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:/EHsc> /W4 /permissive-)\n130: \n131:   # сюда будет заходить только для программ из задач, не для программ для тестирования (run_case, check) - им эти флаги не нужны\n132:   if(DBG)\n133:     # CMake проставит след. флаги автоматиечки: /Od /O2; /MDd /MD; /DNDEBUG\n134:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Debug>:/Zi /fsanitize=address> $<$<CONFIG:Release>:/Zi>)\n135:     target_link_options(${trgt} PRIVATE $<$<CONFIG:Debug>:/DEBUG> $<$<CONFIG:Release>:/DEBUG /OPT:REF /OPT:ICF>)\n136:   endif()\n137: \n138: else()\n139:   target_compile_options(${trgt} PRIVATE -Wall -Wextra)\n140:   # и в ветке продуктов, и в ветке тестовых программ оптимизация на релизе будет именно -O2, а не cmake-default -O3\n141:   if (DBG) \n142:     # -O0 на дебаге будет подтянут CMake автоматически, а на релизе -DNDEBUG\n143:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Debug>: -g -fsanitize=address> $<$<CONFIG:Release>: -g -O2>)\n144:     target_link_options(${trgt} PRIVATE $<$<CONFIG:Debug>: -fsanitize=address>)\n145:   else()\n146:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Release>: -O2>)\n147:   endif()\n148: endif()\n149: endfunction()\n150: \n151: \n152: # === Ф-ЦИЯ ДОБАВЛЕНИЯ ЗАДАЧИ === \n153: # сборки exe из main.c/main.cpp; уходит в каталог build/cfg/dir\n154: function(add_task dir trgt src lib)\n155:   # добавление исполняемного файла \n156:   # цель и её исходник. цель имеет одно имя (логическое, типа t1_c), а сделанный ею файл - другое (OUTPUT_NAME main)\n157:   add_executable(${trgt} ${src})\n158: \n159:   # в CMAKE_BINARY_DIR будет тот каталог, который был передан по -B\n160:   set_target_properties(${trgt} PROPERTIES\n161:   OUTPUT_NAME main\n162:   RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/${dir})\n163: \n164:   # с кем линкуемся\n165:   # тут private не имеет смысла (.exe конечен, к нему не линкуются), просто для единообразия\n166:   target_link_libraries(${trgt} PRIVATE ${lib})\n167: \n168:   # определение типа библиотеки т.к. на windows для .dll нужно доп. действие для связки с .exe\n169:   get_target_property(lib_type ${lib} TYPE)\n170:   # копирование dll в папку к exe даже если сам exe не перестраивался\n171:   if(WIN32 AND lib_type STREQUAL \"SHARED_LIBRARY\")\n172:     set(copied_dll \"${CMAKE_BINARY_DIR}/${dir}/${lib}.dll\")\n173:     add_custom_command(OUTPUT \"${copied_dll}\"\n174:       COMMAND ${CMAKE_COMMAND} -E copy_if_different $<TARGET_FILE:${lib}> \"${CMAKE_BINARY_DIR}/${dir}\"\n175:       DEPENDS ${lib} \n176:       COMMENT \"Copying DLL ${lib} next to ${trgt}\"\n177:       VERBATIM)\n178:     add_custom_target(${trgt}_dll DEPENDS \"${copied_dll}\")\n179:     add_dependencies(${trgt} ${trgt}_dll)\n180:   endif()\n181: \n182:   # команда для cl+link. флаг DEBUG = ON - т.е. пойдём по ветке if (DBG) с флагами для программ-задач\n183:   configure_target(${trgt} ON)\n184:  \n185: endfunction()\n186: \n187: # генерация version.h из шаблона\n188: # @PROJECT_VERSION@ подставится реальная версия из project(VERSION)\n189: # @ONLY - подставляются только @VAR@, а не ${...} (в шаблоне только @PROJECT_VERSION@). для защиты\n190: # /generated в каталоге бинарей будет создан configure_file-ом, если такого каталога ещё нет\n191: configure_file(\n192:   ${CMAKE_SOURCE_DIR}/common/version.h.in\n193:   ${CMAKE_BINARY_DIR}/generated/version.h\n194:   @ONLY)\n195: \n196: # === ПОДПРОЕКТ ДЛЯ СОЗДАНИЯ БИБЛИОТЕК === \n197: # add_subdirectory(source_dir [binary_dir] ...)\n198: # source_dir - где лежит вложенный CMakeLists.txt /common)\n199: # binary_dir - где положить служеб. файлы CMake для подпроекта (если не указано, то в CMAKE_BINARY_DIR/source_dir)  \n200: add_subdirectory(common)\n201: \n202: \n203: # === ДОБАВЛЕНИЕ ЗАДАЧ ===\n204: # arg1 - папка бинарей и прочих продуктов (build/cfg/...)\n205: # arg2 - логическое имя цели\n206: # arg3 - исходник, чтобы сделать файл цели\n207: # arg4 - библиотека с которой линковаться\n208: \n209: # TASK 1\n210: add_task(t1_dist_matrix_cpp t1_cpp t1_dist_matrix_cpp/main.cpp common_cpp_static)\n211: add_task(t1_dist_matrix_c t1_c t1_dist_matrix_c/main.c common_c_static)\n212: \n213: # TASK 2\n214: add_task(t2_passport_cpp t2_cpp t2_passport_cpp/main.cpp string_utils_cpp_static)\n215: add_task(t2_passport_c t2_c t2_passport_c/main.c string_utils_c_static)\n216: \n217: # TASK 3\n218: add_task(t3_bbox_cpp t3_cpp t3_bbox_cpp/main.cpp common_cpp_shared)\n219: add_task(t3_bbox_c t3_c t3_bbox_c/main.c common_c_shared)\n220: \n221: # TASK 4\n222: add_task(t4_filter_cpp t4_cpp t4_filter_cpp/main.cpp common_cpp_shared)\n223: add_task(t4_filter_c t4_c t4_filter_c/main.c common_c_shared)\n224: \n225: # === ФОРМАТИРОВАНИЕ ===\n226: \n227: # cmake/format.cmake в скриптовом режиме. отделен он графа сборки проекта\n228: set(FORMAT_SCRIPT \"${CMAKE_SOURCE_DIR}/cmake/format.cmake\")\n229: \n230: # исключаем весь каталог сборки, а не только текущую конфигурацию:\n231: # конфигурации вложены (build/debug, build/release)\n232: set(FORMAT_BUILD_ROOT \"${CMAKE_BINARY_DIR}\")\n233: get_filename_component(FORMAT_BUILD_PARENT \"${CMAKE_BINARY_DIR}\" DIRECTORY)\n234: if(NOT FORMAT_BUILD_PARENT STREQUAL CMAKE_SOURCE_DIR)\n235:   set(FORMAT_BUILD_ROOT \"${FORMAT_BUILD_PARENT}\")\n236: endif()\n237: \n238: # один и тот же source-dir и build-dir, изменяется только check/apply - он добавляется в командах\n239: # общая часть из source-dir и build-dir\n240: set(FORMAT_COMMON -DSRC_DIR=${CMAKE_SOURCE_DIR} -DBUILD_DIR=${FORMAT_BUILD_ROOT} -P ${FORMAT_SCRIPT})\n241: \n242: # отформатировать\n243: add_custom_target(format\n244:   COMMAND ${CMAKE_COMMAND} -DMODE=apply ${FORMAT_COMMON}\n245:   COMMENT \"Applying clang-format to all C/C++ files\")\n246: \n247: # проверить формат (в этом же виде вызывается из ctest)\n248: add_custom_target(format-check\n249:   COMMAND ${CMAKE_COMMAND} -DMODE=check ${FORMAT_COMMON}\n250:   COMMENT \"Checking clang-format of all C/C++ files\")\n251: \n252: # === TESTS ===\n253: enable_testing()\n254: # первый тест: проверка чистоты формата\n255: # если есть clang+format - проверка строгая, не-падение - только при чистом формате\n256: # иначе - warning и тесты\n257: add_test(NAME format-check COMMAND ${CMAKE_COMMAND} -DMODE=check ${FORMAT_COMMON}) \n258: # тесты на знчения и коды\n259: add_subdirectory(tests) \n\n(End of file - total 259 lines)\n</content>",
            "metadata": {
              "preview": "# минимальная необходимая версия cmake + свежие политики (конкретные точки поведения) до 3.22 \n# в старых CMake-ах выполнение остановится здесь, с требованием версии 3.22\n# политика - как себя ведёт что-либо в CMake. если не указать версию, то default=OLD и будет warning, \n# т.к. старые политики - для совместимости, но не обещают корретности\ncmake_minimum_required(VERSION 3.22)\n\n# проверка наличия ninja, если задан именно этот генератор. до проверки компилятора в project() \nif(CMAKE_GENERATOR MATCHES \"^Ninja\")\n  # find_program ищет в PATH и кэширует результат в CMakeCache.txt как NINJA_EXECUTABLE\n  find_program(NINJA_EXECUTABLE NAMES ninja)\n  if(NOT NINJA_EXECUTABLE)\n    message(FATAL_ERROR\n      \"The '${CMAKE_GENERATOR}' generator was selected, but ninja was not found. \"\n      \"Install ninja or add its directory to PATH\")\n  endif()\n  # сообщение при конфигурации\n  message(STATUS \"ninja: ${NINJA_EXECUTABLE}\")\n# else отсутствует - пока что в проекте генератор - именно Ninja\nendif()\n",
