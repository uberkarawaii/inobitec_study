   if (pid == 0) {\n            // ребёнок\n            if (dup2(in.get(), STDIN_FILENO) < 0 || dup2(out.get(), STDOUT_FILENO) < 0 ||\n                dup2(err.get(), STDERR_FILENO) < 0) {\n                int e = errno;\n                std::print(stderr, \"Can not redirect streams: {}\\n\", std::error_code(e, std::generic_category()).message());\n                _exit(127);\n            }\n\n            execv(argv[6], &argv[6]);   // сюда возвращается только при ошибке\n\n            int exec_err = errno;\n            std::print(stderr, \"Can not run {}: {}\\n\", argv[6],\n                       std::error_code(exec_err, std::generic_category()).message());\n            _exit(127);\n        }\n    } // родитель: in/out/err закрыты RAII\n\n    int status = 0;\n    if (waitpid(pid, &status, 0) < 0) {\n        print_errno_error(\"wait\", argv[6]);\n        return 1;\n    }\n\n    if (WIFEXITED(status)) {\n        int exit_code = WEXITSTATUS(status);\n        if (exit_code != expected_code) {\n            std::print(stderr, \"expected code is {}; received code is {}\\n\", expected_code, exit_code);\n            return 1;\n        }\n    } else if (WIFSIGNALED(status)) {\n        std::print(stderr, \"expected code is {}; process was terminated by signal {}\\n\", expected_code,\n                   WTERMSIG(status));\n        return 1;\n    } else {\n        std::print(stderr, \"expected code is {}; process ended with unexpected status\\n\", expected_code);\n        return 1;\n    }\n\n    return 0;\n#endif\n```\n\nОбъясню тонкости:\n- exec_fail печать: stderr ребёнка уже err-файл (после dup2). \n- Почему печать errno в dup2-ошибке: если dup2 провалился, то, вероятно, 2 ещё не перенаправлен, печать в stderr run_case консоль. Чтобы не сломать err-файл? Всё равно.\n\nМожно упростить: на самом деле с тремя dup2 в одном if через || — если первая упала, последующие не вызовутся (short-circuit). Хм: если dup2(in,0) упал, dup2(out,1) и dup2(err,2) не выполнятся. Но это почти не