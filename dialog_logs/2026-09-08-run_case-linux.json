            "output": "<path>C:\\Users\\User\\Desktop\\inobitec_stud\\CMakeLists.txt</path>\n<type>file</type>\n<content>\n1: # минимальная необходимая версия cmake + свежие политики (конкретные точки поведения) до 3.22 \n2: # в старых CMake-ах выполнение остановится здесь, с требованием версии 3.22\n3: # политика - как себя ведёт что-либо в CMake. если не указать версию, то default=OLD и будет warning, \n4: # т.к. старые политики - для совместимости, но не обещают корретности\n5: cmake_minimum_required(VERSION 3.22)\n6: # имя проекта сохранится в CMAKE_PROJECT_NAME\n7: # определяются яызки проекта: с с++; определится компилятор; \n8: # появятся перменные (типа CMAKE_C_FLAGS_DEBUG) заполненные дефолтными значениями\n9: project(inobitec_stud LANGUAGES C CXX)\n10: \n11: \n12: # === СТАНДАРТЫ ===\n13: # стандарт языка Си\n14: set(CMAKE_C_STANDARD 17)\n15: # компилятор обязан поддерживать этот стандарт языка. иначе - ошибка во время конфигурации CMakeLists (прекомпил.)\n16: set(CMAKE_C_STANDARD_REQUIRED ON)\n17: # только стандартный компилятор языка, без расширений, типа gnu-расширений\n18: set(CMAKE_C_EXTENSIONS OFF)\n19: # то же для с++\n20: set(CMAKE_CXX_STANDARD 23)\n21: set(CMAKE_CXX_STANDARD_REQUIRED ON)\n22: set(CMAKE_CXX_EXTENSIONS OFF)\n23: \n24: \n25: # === ТИП СБОРКИ ===\n26: # определение debug / release; делается через -DCMAKE_BUILD_TYPE=...\n27: # Debug будет поставлен, если ничего не передали через флаг\n28: if(NOT CMAKE_BUILD_TYPE)\n29:   set(CMAKE_BUILD_TYPE Debug CACHE STRING FORCE)\n30: endif()\n31: # переменная CMAKE_BUILD_TYPE уйдёт в кэш \n32: # кэш: для CMake, хранить инф. м-у выполнениями, и пользователь не повторяет ввод каждый раз\n33: # FORCE вызовет перезапись параметра\n34: \n35: \n36: # === ИСПРАВЛЕНИЕ DEFAULT-ФЛАГОВ ===\n37: # CMAke дефолтно положит /RTC1 в debug-ветку. /RTC1 ловит ошибки в runtime, для этого лезет в стек и размечает его\n38: # ASan - та же ф-ция. если оба будут менять стек, они помешают друг другу -> несовместимы. /RTC1 убирается \n39: # /incremental также несовместим с asan (именно по документации. так работало и когда оба вместе)\n40: if(MSVC)\n41:   string(REPLACE \"/RTC1\" \"\" CMAKE_C_FLAGS_DEBUG   \"${CMAKE_C_FLAGS_DEBUG}\")\n42:   string(REPLACE \"/RTC1\" \"\" CMAKE_CXX_FLAGS_DEBUG \"${CMAKE_CXX_FLAGS_DEBUG}\")\n43:   string(REPLACE \"/INCREMENTAL\" \"\" CMAKE_EXE_LINKER_FLAGS_DEBUG  \"${CMAKE_EXE_LINKER_FLAGS_DEBUG}\")\n44: endif()\n45: \n46: \n47: # === ПОСТРОИТЬ КОМАНДЫ КОМПИЛЯЦИИ И ЛИНКА ===\n48: function(configure_target trgt DBG)\n49: if(MSVC)\n50:   # в msvc /Zi, /EHsc, /DEBUG  будут дублироваться, но прописываются для ясности\n51:   # target_compile_options - произвольные флаги компилятора \n52:   # PRIVATE даёт нетранзитивность: А (этот объект) и Б к нему сможет линковаться. а когда К линк. к Б, то К не будет линк. к А\n53:   target_compile_options(${trgt} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:/EHsc> /W4 /permissive-)\n54: \n55:   # сюда будет заходить только для программ из задач, не для программ для тестирования (run_case, check) - им эти флаги не нужны\n56:   if(DBG)\n57:     # CMake проставит след. флаги автоматиечки: /Od /O2; /MDd /MD; /DNDEBUG\n58:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Debug>:/Zi /fsanitize=address> $<$<CONFIG:Release>:/Zi>)\n59:     target_link_options(${trgt} PRIVATE $<$<CONFIG:Debug>:/DEBUG> $<$<CONFIG:Release>:/DEBUG /OPT:REF /OPT:ICF>)\n60:   endif()\n61: \n62: else()\n63:   target_compile_options(${trgt} PRIVATE -Wall -Wextra)\n64:   # и в ветке продуктов, и в ветке тестовых программ оптимизация на релизе будет именно -O2, а не cmake-default -O3\n65:   if (DBG) \n66:     # -O0 на дебаге будет подтянут CMake автоматически, а на релизе -DNDEBUG\n67:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Debug>: -g -fsanitize=address> $<$<CONFIG:Release>: -g -O2>)\n68:     target_link_options(${trgt} PRIVATE $<$<CONFIG:Debug>: -fsanitize=address>)\n69:   else()\n70:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Release>: -O2>)\n71:   endif()\n72: endif()\n73: endfunction()\n74: \n75: \n76: # === Ф-ЦИЯ ДОБАВЛЕНИЯ ЗАДАЧИ === \n77: # сборки exe из main.c/main.cpp; уходит в каталог build/cfg/dir\n78: function(add_task dir trgt src lib)\n79:   # добавление исполняемного файла \n80:   # цель и её исходник. цель имеет одно имя (логическое, типа t1_c), а сделанный ею файл - другое (OUTPUT_NAME main)\n81:   add_executable(${trgt} ${src})\n82: \n83:   # в CMAKE_BINARY_DIR будет тот каталог, который был передан по -B\n84:   set_target_properties(${trgt} PROPERTIES\n85:   OUTPUT_NAME main\n86:   RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/${dir})\n87: \n88:   # с кем линкуемся\n89:   # тут private не имеет смысла (.exe конечен, к нему не линкуются), просто для единообразия\n90:   target_link_libraries(${trgt} PRIVATE ${lib})\n91: \n92:   # команда для cl+link. флаг DEBUG = ON - т.е. пойдём по ветке if (DBG) с флагами для программ-задач\n93:   configure_target(${trgt} ON)\n94:  \n95: endfunction()\n96: \n97: # === ПОДПРОЕКТ ДЛЯ СОЗДАНИЯ БИБЛИОТЕК === \n98: # add_subdirectory(source_dir [binary_dir] ...)\n99: # source_dir - где лежит вложенный CMakeLists.txt /common)\n100: # binary_dir - где положить служеб. файлы CMake для подпроекта (если не указано, то в CMAKE_BINARY_DIR/source_dir)  \n101: add_subdirectory(common)\n102: \n103: \n104: # === ДОБАВЛЕНИЕ ЗАДАЧ ===\n105: # arg1 - папка бинарей и прочих продуктов (build/cfg/...)\n106: # arg2 - логическое имя цели\n107: # arg3 - исходник, чтобы сделать файл цели\n108: # arg4 - библиотека с которой линковаться\n109: \n110: # TASK 1\n111: add_task(t1_dist_matrix_cpp t1_cpp t1_dist_matrix_cpp/main.cpp geometry_cpp_static)\n112: add_task(t1_dist_matrix_c t1_c t1_dist_matrix_c/main.c geometry_c_static)\n113: \n114: # TASK 2\n115: add_task(t2_passport_cpp t2_cpp t2_passport_cpp/main.cpp string_utils_cpp_static)\n116: add_task(t2_passport_c t2_c t2_passport_c/main.c string_utils_c_static)\n117: \n118: # TASK 3\n119: add_task(t3_bbox_cpp t3_cpp t3_bbox_cpp/