.obj /Fe:$@ $(CXXFLAGS) $<\n125: \n126: # ������ �������� ������� ������ - �����\n127: # ����� && ����� ����������, ������ ���� �� && ��� ������ == 0. �������� � � shell � � cmd \n128: $(TESTDIR)\\t1_cpp_abc.ok: $(T1_CPP_EXE) $(RUN_CASE) | $(TESTDIR)\n129: \t$(RUN_CASE) \"echo abc | $(T1_CPP_EXE) > $(NULLDEV) 2> $(NULLDEV)\" 65 && $(TOUCH) $@\n130: \n131: \n132: # ��������� ���� (PHONY TARGETS)\n133: # ���������, �.�. �� ����� �� ���������� �� ����� �������� ���� ��� �����. ��� ����� ��� ��������� ���������� - ������ �������������\n134: # � �.�. ����� �� ����� phony target ������� �� �����, �� make ������ ��� ����� ������:\n135: # ���� ���, ������ ������ ������������ - �����. ���� �����������. (��� ��������� ������, ������ ��� ����� ����)\n136: # ����� make �� ��������� (�.�. ����� ����, ��� �������� ���� � ������� phony target), �������� ����. ������: .PHONY: ... � ������ make\n137: # �� ����� ����� �������, �.�. ������ �������� ���� ��� ���������\n138: \n139: .PHONY: all t1 test format format-check\n140: \n141: # phony-s ��� ��������� ������\n142: all: t1\n143: t1: $(T1_CPP_EXE) $(T1_C_EXE)\n144: test: $(TESTDIR)\\t1_cpp_abc.ok # $(T1_TESTS) format-check \n145: \n146: # phony-s ��� ������ ��� �������  \n147: format: \n148: \tclang-format -i $(wildcard **/*.cpp **/*.c **/*.hpp **/*.h)\n149: # --dry-run - �� ����� ����, ������ ������ �������. (� warning, � error); Werror - warning ��������� � ������ error\n150: format-check: \n151: \tclang-format --dry-run -Werror $(wildcard **/*.cpp **/*.c **/*.h **/*.hpp)\n152: clean: \n153: \t$(RMDIR) build\n\n(End of file - total 153 lines)\n</content>",
