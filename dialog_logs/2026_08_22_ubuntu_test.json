            "output": "<path>C:\\Users\\User\\Desktop\\inobitec_stud\\Makefile</path>\n<type>file</type>\n<content>\n1: # ---------- ����� � /build ---------- \n2: # ����� � ������ ������ ������. ���� �� ���� �������� �����, ����� /debug\n3: CONFIG ?= debug\n4: # ���������� ��� �������� ������. ������ �� ����� � debug, � release\n5: BINDIR := build/$(CONFIG)\n6: # ��� ���������� �������� ��������. �� ��������� ����� build/debug/test\n7: TESTDIR := $(BINDIR)/test\n8: \n9: \n10: # ---------- ������������������: ����������� ��� ������ � �����, ��������� �� ������ (��� cl, link) ---------- \n11: ifeq ($(OS), Windows_NT)\n12:   # ������ ��� MSVC\n13:   CC := cl\n14:   CXX := cl\n15:   COMPILE_ONLY := /c\n16:   LINK := link\n17:   CSTD := /std:c17\n18:   CXXSTD := /std:c++latest\n19:   WARN := /W4 /permissive-\n20:   OBJ_OUT := /Fo:\n21:   EXE_OUT := /Fe:\n22:   LINK_OUT := /OUT:\n23:   DEFINE := /D\n24:   DLL := /DLL\n25:   GREP := findstr\n26:   NULLDEV := nul\n27:   MKDIR := mkdir\n28:   TOUCH := type nul >\n29:   # /s - �� ����������; /q - quietly\n30:   RMDIR := rmdir /s /q\n31:   # ��������� ������ � ����� ��� �������. = � �� := ����� ������������ ��� ������ ������, � �� �������. ���\n32:   WCMD = $(subst /,\\,$1)\n33:   # ���������� ����������� � �����������\n34:   EXE_EXT :=.exe\n35:   OBJ_EXT :=.obj\n36:   # ����� ��� ��� ���������� ����������� (������ ��� ������)\n37:   PIC_FLAGS :=\n38:   ifeq ($(CONFIG), debug)\n39:     CONFIG_FLAGS := /Od /Zi /MDd /fsanitize=address\n40:     LINK_FLAGS := /DEBUG \n41:   else\n42:     # /O2 - � ������������ ����\n43:     # /Zi - ����� ����� ���� ���. ��� ������ � pdb. �� ��� �� ����������������� ����\n44:     # /DNDEBUG - define NDEBUG - ������ ����� ������ ����� assert-� \n45:     # �.�. ��� ����� ���������� ���������� ��������� ��� �������� �������� ���. ���������\n46:     # /MD - ����������. ������. crt - ��� d (debug)\n47:     CONFIG_FLAGS := /O2 /Zi /DNDEBUG /MD\n48:     # /DEBUG - ��� ����� ���. � ����� .pdb �� .obj - /Zi �� cl ��� ������� ���. �� .obj\n49:     # /OPT:REF - �������� ���� ������ � ������ ������� �-��� � ������, �� ������� ��� ������\n50:     # /OPT:ICF - identical comdat folding - ����� ����, ������� ��������� ����� cl, ������������ � ����\n51:     # ���� /OPT:ICF �� /OPT:REF ���������� �������������. \n52:     # /OPT:... ��������� �������� .exe, �� ���. ��� ���������� �� 1:1 � ����������� ����� - ���������� ��� �������  \n53:     LINK_FLAGS := /DEBUG /OPT:REF /OPT:ICF  \n54:   endif\n55:   # �������� ����� ������ cl\n56:   CXXFLAGS := $(CXXSTD) $(WARN) /EHsc $(CONFIG_FLAGS)  \n57:   CFLAGS := $(CSTD) $(WARN) $(CONFIG_FLAGS)\n58: else\n59:   # ����� ��� ������\n60:   CC := gcc\n61:   CXX := g++\n62:   COMPILE_ONLY := -c\n63:   LINK := g++\n64:   CSTD := -std=c17\n65:   CXXSTD := -std=c++23\n66:   WARN := -Wall -Wextra\n67:   OBJ_OUT := -o\n68:   EXE_OUT := -o\n69:   LINK_OUT := -o\n70:   DEFINE := -D\n71:   DLL := -shared\n72:   GREP := grep\n73:   NULLDEV := /dev/null\n74:   MKDIR := mkdir -p\n75:   TOUCH := touch\n76:   # -rf: -r recursive -f force. ����������, �.�. ��� \"�������\"\n77:   RMDIR := rm -rf\n78:   # ��������� ������ � ����� ��� �������. = � �� := ����� ������������ ��� ������ ������, � �� �������. ���\n79:   WCMD = $1\n80:   # ���������� ����������� � �����������\n81:   EXE_EXT :=\n82:   OBJ_EXT :=.o\n83:   # ����� ��� ��� ���������� ����������� (������ ��� ������)\n84:   PIC_FLAGS := -fPIC\n85:   ifeq ($(CONFIG), debug)\n86:   # -O0 - ��� �����������; \n87:   # -g - ���������� ���., ���������� pdb �� �����. ����� ����� � .�; \n88:   # ��� MDd ������� ������� ��� (D_GLIBCXX_DEBUG �� ��� �� ������ ��), ������� ���� ��� ���� \n89:   CONFIG_FLAGS := -O0 -g -fsanitize=address\n90:   # -fsanitize=address ���� ��� �������� ����� ��������� ����� runtime-����������\n91:   # DEBUG �� ����� - �.�. ���������� ����� � .o, �� � ��������� .pdb\n92:   LINK_FLAGS := -fsanitize=address\n93:   else\n94:   # -O2 - � ������������\n95:   # MD ��� - �� ������� ��� ������ CRT\n96:   CONFIG_FLAGS := -O2 -g -DNDEBUG \n97:   # ���� ����������� ����� �����, ����� �������� ����� ���-�� ���� -ffunction-sections -fdata-sections -Wl --gc-sections --icf=safe\n98:   LINK_FLAGS := \n99:   endif\n100:   # �������� ����� ������ cl\n101:   CXXFLAGS := $(CXXSTD) $(WARN) $(CONFIG_FLAGS)  \n102:   CFLAGS := $(CSTD) $(WARN) $(CONFIG_FLAGS)\n103: endif\n104: \n105: \n106: # ---------- ���������� ��� ����� (��� ����������, ����������� �����, �������� �����) ---------- \n107: # ����������� ����� ���������� �������� - ����� �������� �� win � linux - �� ������\n108: RUN_CASE := $(BINDIR)/tools/run_case$(EXE_EXT)\n109: CHECK := $(BINDIR)/tools/check$(EXE_EXT)\n110: ifeq ($(OS), Windows_NT)\n111:   # ���� ��� windows �� � ���. ����� ����� ������ ���� ��������\n112:   RUN_CASE_CMD := $(subst /,\\,$(RUN_CASE))\n113:   CHECK_CMD := $(subst /,\\,$(CHECK))\n114: else\n115:   RUN_CASE_CMD := $(RUN_CASE)\n116:   CHECK_CMD := $(CHECK)\n117: endif\n118: \n119: # ���������� � ����������� (���� � ���-����)\n120: T1_CPP_OBJ := $(BINDIR)/t1_dist_matrix_cpp/main$(OBJ_EXT) $(BINDIR)/common/geometry_cpp$(OBJ_EXT)\n121: T1_C_OBJ := $(BINDIR)/t1_dist_matrix_c/main$(OBJ_EXT) $(BINDIR)/common/geometry_c$(OBJ_EXT)\n122: T1_CPP_EXE := $(BINDIR)/t1_dist_matrix_cpp/main$(EXE_EXT)\n123: T1_C_EXE := $(BINDIR)/t1_dist_matrix_c/main$(EXE_EXT)\n124: \n125: T2_CPP_OBJ := $(BINDIR)/t2_passport_cpp/main$(OBJ_EXT) $(BINDIR)/common/string_utils_cpp$(OBJ_EXT)\n126: T2_C_OBJ := $(BINDIR)/t2_passport_c/main$(OBJ_EXT) $(BINDIR)/common/string_utils_c$(OBJ_EXT)\n127: T2_CPP_EXE := $(BINDIR)/t2_passport_cpp/main$(EXE_EXT)\n128: T2_C_EXE := $(BINDIR)/t2_passport_c/main$(EXE_EXT)\n129: \n130: T3_CPP_EXE := $(BINDIR)/t3_bbox_cpp/main$(EXE_EXT)\n131: T3_C_EXE := $(BINDIR)/t3_bbox_c/main$(EXE_EXT)\n132: \n133: T4_CPP_EXE := $(BINDIR)/t4_filter_cpp/main$(EXE_EXT)\n134: T4_C_EXE := $(BINDIR)/t4_filter_c/main$(EXE_EXT)\n135: \n136: # target-specific ���������� - ��� ����������� �������� �� ����� ���������� - ����������� / ������������ \n137: $(T1_CPP_EXE) $(T1_C_EXE) $(T2_CPP_EXE) $(T2_C_EXE): COMMON_FLAG := $(DEFINE)COMMON_STATIC\n138: # ��� t3 - t4 ���� ���� ������ - ��� ������� ����� ����������, ��� ������������� �� dll\n139: $(T3_CPP_EXE) $(T3_C_EXE) $(T4_CPP_EXE) $(T4_C_EXE): COMMON_FLAG :=\n140: \n141: # ���� (��������)\n142: # ��� ������ ����� wildcard: ���� ��� �������, �� ��� ���������� ������ make ����� ��������� � �������� ��������\n143: # � �� ������ ��� �� ������ �� .ok ������ - ������� ������ ��� �� ����. ����� �� ��� ������ .ok ����� ������ ��� �� �� ����������\n144: # ������ � ����������� ������\n145: T1_CPP_TESTS := $(TESTDIR)/t1_cpp_abc.ok \\\n146: \t    $(TESTDIR)/t1_cpp_float.ok \\\n147: \t    $(TESTDIR)/t1_cpp_low.ok \\\n148: \t    $(TESTDIR)/t1_cpp_high.ok \\\n149: \t    $(TESTDIR)/t1_cpp_nul.ok \\\n150:             $(TESTDIR)/t1_cpp_norm.ok\n151: \n152: T1_C_TESTS := $(TESTDIR)/t1_c_abc.ok \\\n153: \t    $(TESTDIR)/t1_c_float.ok \\\n154: \t    $(TESTDIR)/t1_c_low.ok \\\n155: \t    $(TESTDIR)/t1_c_high.ok \\\n156: \t    $(TESTDIR)/t1_c_nul.ok \\\n157:             $(TESTDIR)/t1_c_norm.ok\n158: \n159: T2_CPP_TESTS := $(TESTDIR)/t2_cpp_norm.ok \\\n160:                 $(TESTDIR)/t2_cpp_eof_name.ok \\\n161:                 $(TESTDIR)/t2_cpp_empty_name.ok \\\n162:                 $(TESTDIR)/t2_cpp_eof_vertexes.ok \\\n163:                 $(TESTDIR)/t2_cpp_empty_vertexes.ok \\\n164:                 $(TESTDIR)/t2_cpp_negative_vertexes.ok \\\n165:                 $(TESTDIR)/t2_cpp_fractional_vertexes.ok \\\n166:                 $(TESTDIR)/t2_cpp_nan_vertexes.ok\n167: \n168: T2_C_TESTS := $(TESTDIR)/t2_c_norm.ok \\\n169:                 $(TESTDIR)/t2_c_eof_name.ok \\\n170:                 $(TESTDIR)/t2_c_empty_name.ok \\\n171:                 $(TESTDIR)/t2_c_eof_vertexes.ok \\\n172:                 $(TESTDIR)/t2_c_empty_vertexes.ok \\\n173:                 $(TESTDIR)/t2_c_negative_vertexes.ok \\\n174:                 $(TESTDIR)/t2_c_fractional_vertexes.ok \\\n175:                 $(TESTDIR)/t2_c_nan_vertexes.ok\n176: \n177: T3_CPP_TESTS := $(TESTDIR)/t3_cpp_empty_case.ok \\\n178:                 $(TESTDIR)/t3_cpp_not_digit_case.ok \\\n179:                 $(TESTDIR)/t3_cpp_too_few_args_case.ok \\\n180:                 $(TESTDIR)/t3_cpp_test1.ok \\\n181:                 $(TESTDIR)/t3_cpp_test2.ok \\\n182:                 $(TESTDIR)/t3_cpp_test3.ok \n183: \n184: T3_C_TESTS := $(TESTDIR)/t3_c_empty_case.ok \\\n185:                 $(TESTDIR)/t3_c_not_digit_case.ok \\\n186:                 $(TESTDIR)/t3_c_too_few_args_case.ok \\\n187:                 $(TESTDIR)/t3_c_test1.ok \\\n188:                 $(TESTDIR)/t3_c_test2.ok \\\n189:                 $(TESTDIR)/t3_c_test3.ok \n190: \n191: T4_CPP_TESTS := $(TESTDIR)/t4_cpp_radius_empty.ok \\\n192:                 $(TESTDIR)/t4_cpp_radius_too_much.ok \\\n193:                 $(TESTDIR)/t4_cpp_radius_symbol.ok \\\n194:                 $(TESTDIR)/t4_cpp_radius_inf.ok \\\n195:                 $(TESTDIR)/t4_cpp_radius_negative.ok \\\n196:                 $(TESTDIR)/t4_cpp_symbol_coords.ok \\\n197:                 $(TESTDIR)/t4_cpp_too_few_coords.ok \\\n198:                 $(TESTDIR)/t4_cpp_empty_coords.ok \\\n199:                 $(TESTDIR)/t4_cpp_test1.ok \\\n200:                 $(TESTDIR)/t4_cpp_test2.ok \\\n201:                 $(TESTDIR)/t4_cpp_test3.ok \n202: \n203: T4_C_TESTS := $(TESTDIR)/t4_c_radius_empty.ok \\\n204:                 $(TESTDIR)/t4_c_radius_too_much.ok \\\n205:                 $(TESTDIR)/t4_c_radius_symbol.ok \\\n206:                 $(TESTDIR)/t4_c_radius_inf.ok \\\n207:                 $(TESTDIR)/t4_c_radius_negative.ok \\\n208:                 $(TESTDIR)/t4_c_symbol_coords.ok \\\n209:                 $(TESTDIR)/t4_c_too_few_coords.ok \\\n210:                 $(TESTDIR)/t4_c_empty_coords.ok \\\n211:                 $(TESTDIR)/t4_c_test1.ok \\\n212:                 $(TESTDIR)/t4_c_test2.ok \\\n213:                 $(TESTDIR)/t4_c_test3.ok\n214: \n215: # exit-����\n216: USAGE := 64\n217: DATA := 65\n218: NO_INPUT := 66\n219: IO_FAIL := 74\n220: \n221: # �������� ���������� ����� ��������� - ��������� ��������� order-only (���. ����), �.�. % ������� �� �.�. � ������ � order-only\n222: CPP_DIRS := $(BINDIR)/t1_dist_matrix_cpp $(BINDIR)/t2_passport_cpp $(BINDIR)/t3_bbox_cpp $(BINDIR)/t4_filter_cpp\n223: C_DIRS := $(BINDIR)/t1_dist_matrix_c $(BINDIR)/t2_passport_c $(BINDIR)/t3_bbox_c $(BINDIR)/t4_filter_c\n224: \n225: \n226: # ---------- ����������� (ORDER-ONLY, ����� ������ �� �������) ---------- \n227: \n228: # /tools ���������� ��� ���������� �������� - run_case � check\n229: # � ����� ��� ������� ����� ��������� �� 5 ������ ���� \"$(BINDIR)/t1_dist_matrix_cpp: $(MKDIR) $@\"\n230: \n231: # Make ����� ���� ������ ���� ���-�� �����, ��������, $(BINDIR)/common, �� ����� /common ��� ���. \n232: # ����� make ����� ���� � ������� ���������� MKDIR\n233: $(CPP_DIRS) $(C_DIRS) $(BINDIR)/common $(BINDIR)/tools $(TESTDIR):\n234: \t$(MKDIR) $(call WCMD,$@)\n235: \n236: \n237: # ---------- ����������� - (����)������� ���� ����: ����������� ��� ����ͨ� ����� ���� ��� ���� �٨ �� ���������� ---------- \n238: # ����: �������.1 �������.2 ...\n239: # $@ - ����\n240: # $< - ������ �����������\n241: # $^ - ��� ������������\t\n242: \n243: # ������\n244: # ������� ��� ���x .obj � ������������ /bin/..., \n245: # ��� ������� ���� ���������� .cpp/.c (����� � ����� �� �����, �� ��� � ����� �������)\n246: # ���� COMMON_FLAG - target-specific ����������. ������ �� ��� ���������� �������� - ������. / �������. \n247: # � order-only - ����� ����� ��� ���������� ������������, ���� ������ ��� �� ����\n248: $(BINDIR)/%$(OBJ_EXT): %.cpp | $(CPP_DIRS)\n249: \t$(CXX) $(COMPILE_ONLY) $(COMMON_FLAG) $(OBJ_OUT)$@ $(CXXFLAGS) $<   \n250: \n251: # ����������� ��� ��\n252: $(BINDIR)/%$(OBJ_EXT): %.c | $(C_DIRS) \n253: \t$(CC) $(COMPILE_ONLY) $(COMMON_FLAG) $(OBJ_OUT)$@ $(CFLAGS) $<\n254: \n255: # STATIC (t1-t2) ������� ��� geometry + string_utils, �.�. �� ��