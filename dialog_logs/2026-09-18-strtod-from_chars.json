\n        pointer = end;\n        // �������� ��������� �� ���-�� �������� ����� �����\n        pointer += strspn(pointer, \" \\t\\n\\r\");\n        ++i;\n    }\n\n    // ���� ������ ������ ���, � ������ ����������� - ��������� ������ �������\n    if (i != 3)\n        return PARSE_TOO_FEW;\n\n    // ���� ������ ���������� ���, � ������ ���-�� ��� (������� ����� 3 ����� ��� �������) - ��� ������ �����, ���\n    // ������\n    if (i == 3 && *pointer != '\\0') {\n        // ���� ��� hex �����, �� ������������ ��� ��� ��-�����. � �� ��� \"������ ��� ����� x y z\"\n        if (is_hex(pointer))\n            return PARSE_NOT_NUMBER;\n        // ���� ���� ��� �� X Y Z. ������� ��� ��� ������, ��� ��� ��� ����������\n        (void)strtod(pointer, &end);\n        // ���� � ������ ������ ������ (end == ptr) ��� end ����������� �� �� ���������� - ������ �������� � ��-�����\n        if (end == pointer || (*end != '\\0' && strchr(\" \\t\\n\\r\", *end) == NULL))\n            return PARSE_NOT_NUMBER;\n        // ����� - ��� ������ �����\n        else\n            return PARSE_EXTRA;\n    }\n\n    *p = (struct Point){.x = d[0], .y = d[1], .z = d[2]};\n\n    return 0;\n}",
