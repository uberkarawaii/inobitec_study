 ���. ��� ������ � pdb. �� ��� �� ����������������� ����\\n    # /DNDEBUG - define NDEBUG - ������ ����� ������ ����� assert-� \\n    # �.�. ��� ����� ���������� ���������� ��������� ��� �������� �������� ���. ���������\\n    # /MD - ����������. ������. crt - ��� d (debug)\\n    CONFIG_FLAGS := /O2 /Zi /DNDEBUG /MD\\n    # /DEBUG - ��� ����� ���. � ����� .pdb �� .obj - /Zi �� cl ��� ������� ���. �� .obj\\n    # /OPT:REF - �������� ���� ������ � ������ ������� �-��� � ������, �� ������� ��� ������\\n    # /OPT:ICF - identical comdat folding - ����� ����, ������� ��������� ����� cl, ������������ � ����\\n    # ���� /OPT:ICF �� /OPT:REF ���������� �������������. \\n    # /OPT:... ��������� �������� .exe, �� ���. ��� ���������� �� 1:1 � ����������� ����� - ���������� ��� �������  \\n    LINK_FLAGS := /DEBUG /OPT:REF /OPT:ICF  \\n  endif\\n  # �������� ����� ������ cl\\n  CXXFLAGS := $(CXXSTD) $(WARN) /EHsc $(CONFIG_FLAGS)  \\n  CFLAGS := $(CSTD) $(WARN) $(CONFIG_FLAGS)\\nelse\\n  # ����� ��� ������ - ���� �������������\\n  # TODO : �������� ����� ���...\n  Line 1897:           \"text\": \"Ирина спрашивает о порядке выполнения make. Она запустила `make -n all` и увидела странный порядок. Давай разберём.\\n\\nВывод:\\n```\\nmkdir build\\\\debug\\\\t1_dist_matrix_cpp\\nmkdir build\\\\debug\\\\t2_passport_cpp\\ncl /c ... t1_dist_matrix_cpp\\\\main.obj ...\\nmkdir build\\\\debug\\\\common\\ncl /c ... common\\\\geometry_cpp.obj\\nlink ... main.exe (t1_cpp)\\nmkdir build\\\\debug\\\\t1_dist_matrix_c\\nmkdir build\\\\debug\\\\t2_passport_c\\ncl /c ... t1_dist_matrix_c\\\\main.obj\\ncl /c ... common\\\\geometry_c.obj\\nlink ... main.exe (t1_c)\\necho T1_C T1_CPP COMPILED\\ncl /c ... t2_passport_cpp\\\\main.obj\\ncl /c ... common\\\\string_utils_cpp.obj\\nlink ... main.exe (t2_cpp)\\necho T2_CPP COMPILED\\n```\\n\\nВопросы Ирины:\\n1. Почему сначала папки делаются? (mkdir сначала)\\n2. Почему порядок такой странный — сначала папки, потом Obj 1-ой, потом подцели 1-ой и т.д.\\n\\nКлючевое понимание: **order-only пререквизиты** и то, как make строит граф и обрабатывает его.\\n\\nПравило:\\n```\\n$(CPP_DIRS) $(C_DIRS) $(BINDIR)\\\\common $(BINDIR)\\\\tools $(TESTDIR):\\n\\t$(MKDIR) $@\\n```\\nЭто правило создания папок. Папки — это цели с order-only зависимостью для других целей.\\n\\nCPP_DIRS := build\\\\debug\\\\t1_dist_matrix_cpp build\\\\debug\\\\t2_passport_cpp\\nC_DIRS := build\\\\debug\\\\t1_dist_matrix_c build\\\\debug\\\\t2_passport_c\\n\\nПочему mkdir идут парами? Потому что все папки из CPP_DIRS — общие order-only пререквизиты для паттерн-правил. Make перед построением цели `.obj` смотрит order-only пререквизиты — он должен их \\\"обновить\\\" (построить), и он группирует их.\\n\\nВажный момент: **make строит цели в глубину (depth-first), но group targets**. Когда make хочет построить `build\\\\debug\\\\t1_dist_matrix_cpp\\\\main.obj`, его order-only пререквизит — `build\\\\debug\\\\t1_dist_matrix_cpp` (часть CPP_DIRS). Но также есть другое правило для `build\\\\debug\\\\t2_passport_cpp`. Хм, но почему mkdir идут сразу оба (t1_dist_matrix_cpp и t2_passport_cpp) вместе перед obj?\\n\\nДело в том, что `$(CPP_DIRS)` в order-only у паттерн-правила:\\...\n  Line 2546:             \"output\": \"<path>C:\\\\Users\\\\User\\\\Desktop\\\\inobitec_stud\\\\Makefile</path>\\n<type>file</type>\\n<content>\\n1: # ---------- ����� � /build ---------- \\n2: # ����� � ������ ������ ������. ���� �� ���� �������� �����, ����� /debug\\n3: CONFIG ?= debug\\n4: # ���������� ��� �������� ������. ������ �� ����� � debug, � release\\n5: BINDIR := build\\\\$(CONFIG)\\n6: # ��� ���������� �������� ��������. �� ��������� ����� build/debug/test\\n7: TESTDIR := $(BINDIR)\\\\test\\n8: \\n9: \\n10: # ---------- ������������������: ����������� ��� ������ � �����, ��������� �� ������ (��� cl, link) ---------- \\n11: ifeq ($(OS), Windows_NT)\\n12:   # ������ ��� MSVC\\n13:   CC := cl\\n14:   CXX := cl\\n15:   LINK := link\\n16:   CSTD := /std:c17\\n17:   CXXSTD := /std