 # MD ��� - �� ������� ��� ������ CRT\n98:   CONFIG_FLAGS := -O2 -g -DNDEBUG \n99:   # ���� ����������� ����� �����, ����� �������� ����� ���-�� ���� -ffunction-sections -fdata-sections -Wl --gc-sections --icf=safe\n100:   LINK_FLAGS := \n101:   endif\n102:   # �������� ����� ������ cl\n103:   CXXFLAGS := $(CXXSTD) $(WARN) $(CONFIG_FLAGS)  \n104:   CFLAGS := $(CSTD) $(WARN) $(CONFIG_FLAGS)\n105: endif\n106: \n107: \n108: # ---------- ���������� ��� ����� (��� ����������, ����������� �����, �������� �����) ---------- \n109: # ����������� ����� ���������� �������� - ����� �������� �� win � linux - �� ������\n110: RUN_CASE := $(BINDIR)/tools/run_case$(EXE_EXT)\n111: FIND_SUBSTR := $(BINDIR)/tools/check_contains$(EXE_EXT)\n112: ifeq ($(OS), Windows_NT)\n113:   # ���� ��� windows �� � ���. ����� ����� ������ ���� ��������\n114:   RUN_CASE_CMD := $(subst /,\\,$(RUN_CASE))\n115:   FIND_SUBSTR_CMD := $(subst /,\\,$(FIND_SUBSTR))\n116: else\n117:   RUN_CASE_CMD := $(RUN_CASE)\n118:   FIND_SUBSTR_CMD := $(FIND_SUBSTR)\n119: endif\n120: \n121: # ���������� � ����������� (���� � ���-����)\n122: T1_CPP_OBJ := $(BINDIR)/t1_dist_matrix_cpp/main$(OBJ_EXT) $(BINDIR)/common/geometry_cpp$(OBJ_EXT)\n123: T1_C_OBJ := $(BINDIR)/t1_dist_matrix_c/main$(OBJ_EXT) $(BINDIR)/common/geometry_c$(OBJ_EXT)\n124: T1_CPP_EXE := $(BINDIR)/t1_dist_matrix_cpp/main$(EXE_EXT)\n125: T1_C_EXE := $(BINDIR)/t1_dist_matrix_c/main$(EXE_EXT)\n126: \n127: T2_CPP_OBJ := $(BINDIR)/t2_passport_cpp/main$(OBJ_EXT) $(BINDIR)/common/string_utils_cpp$(OBJ_EXT)\n128: T2_C_OBJ := $(BINDIR)/t2_passport_c/main$(OBJ_EXT) $(BINDIR)/common/string_utils_c$(OBJ_EXT)\n129: T2_CPP_EXE := $(BINDIR)/t2_passport_cpp/main$(EXE_EXT)\n130: T2_C_EXE := $(BINDIR)/t2_passport_c/main$(EXE_EXT)\n131: \n132: T3_CPP_EXE := $(BINDIR)/t3_bbox_cpp/main$(EXE_EXT)\n133: T3_C_EXE := $(BINDIR)/t3_bbox_c/main$(EXE_EXT)\n134: \n135: T4_CPP_EXE := $(BINDIR)/t4_filter_cpp/main$(EXE_EXT)\n136: T4_C_EXE := $(BINDIR)/t4_filter_c/main$(EXE_EXT)\n137: \n138: # target-specific ���������� - ��� ����������� �������� �� ����� ���������� - ����������� / ������������ \n139: $(T1_CPP_EXE) $(T1_C_EXE) $(T2_CPP_EXE) $(T2_C_EXE): COMMON_FLAG := $(DEFINE)COMMON_STATIC\n140: # ��� t3 - t4 ���� ���� ������ - ��� ������� ����� ����������, ��� ������������� �� dll\n141: $(T3_CPP_EXE) $(T3_C_EXE) $(T4_CPP_EXE) $(T4_C_EXE): COMMON_FLAG :=\n142: \n143: # ���� (��������)\n144: # ��� ������ ����� wildcard: ���� ��� �������, �� ��� ���������� ������ make ����� ��������� � �������� ��������\n145: # � �� ������ ��� �� ������ �� .ok ������ - ������� ������ ��� �� ����. ����� �� ��� ������ .ok ����� ������ ��� �� �� ����������\n146: # ������ � ����������� ������\n147: T1_CPP_TESTS := $(TESTDIR)/t1_cpp_abc.ok \\\n148: \t    $(TESTDIR)/t1_cpp_float.ok \\\n149: \t    $(TESTDIR)/t1_cpp_low.ok \\\n150: \t    $(TESTDIR)/t1_cpp_high.ok \\\n151: \t    $(TESTDIR)/t1_cpp_nul.ok \\\n152:             $(TESTDIR)/t1_cpp_norm.ok\n153: \n154: T1_C_TESTS := $(TESTDIR)/t1_c_abc.ok \\\n155: \t    $(TESTDIR)/t1_c_float.ok \\\n156: \t    $(TESTDIR)/t1_c_low.ok \\\n157: \t    $(TESTDIR)/t1_c_high.ok \\\n158: \t    $(TESTDIR)/t1_c_nul.ok \\\n159:             $(TESTDIR)/t1_c_norm.ok\n160: \n161: T2_CPP_TESTS := $(TESTDIR)/t2_cpp_norm.ok \\\n162:                 $(TESTDIR)/t2_cpp_eof_name.ok \\\n163:                 $(TESTDIR)/t2_cpp_empty_name.ok \\\n164:                 $(TESTDIR)/t2_cpp_eof_vertexes.ok \\\n165:                 $(TESTDIR)/t2_cpp_empty_vertexes.ok \\\n166:                 $(TESTDIR)/t2_cpp_negative_vertexes.ok \\\n167:                 $(TESTDIR)/t2_cpp_fractional_vertexes.ok \\\n168:                 $(TESTDIR)/t2_cpp_nan_vertexes.ok\n169: \n170: T2_C_TESTS := $(TESTDIR)/t2_c_norm.ok \\\n171:                 $(TESTDIR)/t2_c_eof_name.ok \\\n172:                 $(TESTDIR)/t2_c_empty_name.ok \\\n173:                 $(TESTDIR)/t2_c_eof_vertexes.ok \\\n174:                 $(TESTDIR)/t2_c_empty_vertexes.ok \\\n175:                 $(TESTDIR)/t2_c_negative_vertexes.ok \\\n176:                 $(TESTDIR)/t2_c_fractional_vertexes.ok \\\n177:                 $(TESTDIR)/t2_c_nan_vertexes.ok\n178: \n179: T3_CPP_TESTS := $(TESTDIR)/t3_cpp_empty_case.ok \\\n180:                 $(TESTDIR)/t3_cpp_not_digit_case.ok \\\n181:                 $(TESTDIR)/t3_cpp_too_few_args_case.ok \\\n182:                 $(TESTDIR)/t3_cpp_test1.ok \\\n183:                 $(TESTDIR)/t3_cpp_test2.ok \\\n184:                 $(TESTDIR)/t3_cpp_test3.ok \n185: \n186: T3_C_TESTS := $(TESTDIR)/t3_c_empty_case.ok \\\n187:                 $(TESTDIR)/t3_c_not_digit_case.ok \\\n188:                 $(TESTDIR)/t3_c_too_few_args_case.ok \\\n189:                 $(TESTDIR)/t3_c_test1.ok \\\n190:                 $(TESTDIR)/t3_c_test2.ok \\\n191:                 $(TESTDIR)/t3_c_test3.ok \n192: \n193: T4_CPP_TESTS := $(TESTDIR)/t4_cpp_radius_empty.ok \\\n194:                 $(TESTDIR)/t4_cpp_radius_too_much.ok \\\n195:                 $(TESTDIR)/t4_cpp_radius_symbol.ok \\\n196:                 $(TESTDIR)/t4_cpp_radius_inf.ok \\\n197:                 $(TESTDIR)/t4_cpp_radius_negative.ok \\\n198:                 $(TESTDIR)/t4_cpp_symbol_coords.ok \\\n199:                 $(TESTDIR)/t4_cpp_too_few_coords.ok \\\n200:                 $(TESTDIR)/t4_cpp_empty_coords.ok \\\n201:                 $(TESTDIR)/t4_cpp_test1.ok \\\n202:                 $(TESTDIR)/t4_cpp_test2.ok \\\n203:                 $(TESTDIR)/t4_cpp_test3.ok \n204: \n205: T4_C_TESTS := $(TESTDIR)/t4_c_radius_empty.ok \\\n206:                 $(TESTDIR)/t4_c_radius_too_much.ok \\\n207:                 $(TESTDIR)/t4_c_radius_symbol.ok \\\n208:                 $(TESTDIR)/t4_c_radius_inf.ok \\\n209:                 $(TESTDIR)/t4_c_radius_negative.ok \\\n210:                 $(TESTDIR)/t4_c_symbol_coords.ok \\\n211:                 $(TESTDIR)/t4_c_too_few_coords.ok \\\n212:                 $(TESTDIR)/t4_c_empty_coords.ok \\\n213:                 $(TESTDIR)/t4_c_test1.ok \\\n214:                 $(TESTDIR)/t4_c_test2.ok \\\n215:                 $(TESTDIR)/t4_c_test3.ok\n216: \n217: # exit-����\n218: USAGE := 64\n219: DATA := 65\n220: NO_INPUT := 66\n221: IO_FAIL := 74\n222: \n223: # �������� ���������� ����� ��������� - ��������� ��������� order-only (���. ����), �.�. % ������� �� �.�. � ������ � order-only\n224: CPP_DIRS := $(BINDIR)/t1_dist_matrix_cpp $(BINDIR)/t2_passport_cpp $(BINDIR)/t3_bbox_cpp $(BINDIR)/t4_filter_cpp\n225: C_DIRS := $(BINDIR)/t1_dist_matrix_c $(BINDIR)/t2_passport_c $(BINDIR)/t3_bbox_c $(BINDIR)/t4_filter_c\n226: \n227: \n228: # ---------- ����������� (ORDER-ONLY, ����� ������ �� �������) ---------- \n229: \n230: # /tools ���������� ������ ��� run_case.exe\n231: # � ����� ��� ������� ����� ��������� �� 5 ������ ���� \"$(BINDIR)/t1_dist_matrix_cpp: $(MKDIR) $@\"\n232: \n233: # Make ����� ���� ������ ���� ���-�� �����, ��������, $(BINDIR)/common, �� ����� /common ��� ���. \n234: # ����� make ����� ���� � ������� ���������� MKDIR\n235: $(CPP_DIRS) $(C_DIRS) $(BINDIR)/common $(BINDIR)/tools $(TESTDIR):\n236: \t$(MKDIR) $(call WCMD,$@)\n237: \n238: \n239: # ---------- ����������� - (����)������� ���� ����: ����������� ��� ����ͨ� ����� ���� ��� ���� �٨ �� ���������� ---------- \n240: # ����: �������.1 �������.2 ...\n241: # $@ - ����\n242: # $< - ������ �����������\n243: # $^ - ��� ������������\t\n244: \n245: # ������\n246: # ������� ��� ���x .obj � ������������ /bin/..., \n247: # ��� ������� ���� ���������� .cpp/.c (����� � ����� �� �����, �� ��� � ����� �������)\n248: # ���� COMMON_FLAG - target-specific ����������. ������ �� ��� ���������� �������� - ������. / �������. \n249: # � order-only - ����� ����� ��� ���������� ������������, ���� ������ ��� �� ����\n250: $(BINDIR)/%$(OBJ_EXT): %.cpp | $(CPP_DIRS)\n251: \t$(CXX) $(COMPILE_ONLY) $(COMMON_FLAG) $(OBJ_OUT)$@ $(CXXFLAGS) $<   \n252: \n253: # ����������� ��� ��\n254: $(BINDIR)/%$(OBJ_EXT): %.c | $(C_DIRS) \n255: \t$(CC) $(COMPILE_ONLY) $(COMMON_FLAG) $(OBJ_OUT)$@ $(CFLAGS) $<\n256: \n257: # STATIC