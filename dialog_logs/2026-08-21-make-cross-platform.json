mon_cpp.dll $^\\r\\n220: $(BINDIR)\\\\common\\\\common_c.dll $(BINDIR)\\\\common\\\\common_c.lib &: $(C_DLL_OBJ) | $(BINDIR)\\\\common\\r\\n221: $(LINK) $(LINK_FLAGS) /DLL /OUT:$(BINDIR)\\\\common\\\\common_c.dll $^\\r\\n224: # ??? common_cpp.dll ? ?????????????, ????? ????? ? ??????? ????? common_cpp.lib. ?.?. ?? dll ????????? ????? ? lib;\\r\\n226: $(BINDIR)\\\\t3_bbox_cpp\\\\main.exe: $(BINDIR)\\\\t3_bbox_cpp\\\\main.obj $(BINDIR)\\\\common\\\\common_cpp.dll | $(BINDIR)\\\\t3_bbox_cpp\\r\\n227: $(LINK) $(LINK_FLAGS) /OUT:$@ $< $(BINDIR)\\\\common\\\\common_cpp.lib\\r\\n229: $(BINDIR)\\\\t3_bbox_c\\\\main.exe: $(BINDIR)\\\\t3_bbox_c\\\\main.obj $(BINDIR)\\\\common\\\\common_c.dll | $(BINDIR)\\\\t3_bbox_c\\r\\n230: $(LINK) $(LINK_FLAGS) /OUT:$@ $< $(BINDIR)\\\\common\\\\common_c.lib\\r\\n244: # GEN_CLOUD ????????? ?????? ?????\\r\\n245: ...\n  Line 3791:             \"title\": \"Select-String -Path Makefile -Pattern \\\"COMMON_CPP_DLL_OBJ|COMMON_C_DLL_OBJ|T3_CPP_OBJ|GEN_CLOUD|SET_DLL_PATH|\\\\.lib|\\\\.dll|main\\\\.exe:\\\" | ForEach-Object { \\\"$($_.LineNumber): $($_.Line.Trim())\\\" }\",\n\n  Line 3863:           \"text\": \"Интересно. Строки 58-59 и 71 ещё на месте (COMMON_CPP_DLL_OBJ, COMMON_C_DLL_OBJ, #T3_CPP_OBJ). И main.exe t3 всё ещё зависит от .dll, а не .lib. Хмм, но пользователь сказал \\\"сделала\\\", \\\"убрала\\\", \\\"добавила\\\". Может она ещё не сохранила, или мы смотрим на старую версию? Возможно, она говорит о своих намерениях/том что сделала в уме, но файл ещё не обновлён. Или она обновляла в другой копии.\\n\\nСобственно, по пунктам:\\n1. Массовых тестов нет — наставник убрал. ок.\\n2. Сделала main.exe зависимым от lib, не dll.\\n3. Убрала мёртвый код.\\n4. Добавила header-зависимости.\\n5. Референсов нет.\\n6. Как сделать чтобы не зависеть от папки запуска make?\\n\\nНо файл всё ещё содержит старую версию. Значит правки либо не сохранены, либо она спрашивает о плане. Проверю git status / diff. Но plan mode — только чтение. git diff — read-on