����� � ������ ������� �-��� � ������, �� ������� ��� ������\n49:     # /OPT:ICF - identical comdat folding - ����� ����, ������� ��������� ����� cl, ������������ � ����\n50:     # ���� /OPT:ICF �� /OPT:REF ���������� �������������. \n51:     # /OPT:... ��������� �������� .exe, �� ���. ��� ���������� �� 1:1 � ����������� ����� - ���������� ��� �������  \n52:     LINK_FLAGS := /DEBUG /OPT:REF /OPT:ICF  \n53:   endif\n54:   # �������� ����� ������ cl\n55:   CXXFLAGS := $(CXXSTD) $(WARN) /EHsc $(CONFIG_FLAGS)  \n56:   CFLAGS := $(CSTD) $(WARN) $(CONFIG_FLAGS)\n57: else\n58:   # ����� ��� ������\n59:   CC := gcc\n60:   CXX := g++\n61:   COMPILE_ONLY := -c\n62:   LINK := g++\n63:   CSTD := -std=c17\n64:   CXXSTD := -std=c++23\n65:   WARN := -Wall -Wextra\n66:   OBJ_OUT := -o\n67:   EXE_OUT := -o\n68:   LINK_OUT := -o\n69:   DEFINE := -D\n70:   DLL := -shared\n71:   GREP := grep\n72:   NULLDEV := /dev/null\n73:   MKDIR := mkdir -p\n74:   TOUCH := touch\n75:   # -rf: -r recursive -f force. ����������, �.�. ��� \"�������\"\n76:   RMDIR := rm -rf\n77:   FC := diff\n78:   # ��������� ������ � ����� ��� �������. = � �� := ����� ������������ ��� ������ ������, � �� �������. ���\n79:   WCMD = $1\n80:   # ���������� ����������� � �����������\n81:   EXE_EXT :=\n82:   OBJ_EXT :=.o\n83:   ifeq ($(CONFIG), debug)\n84:   # -O0 - ��� �����������; \n85:   # -g - ���������� ���., ���������� pdb �� �����. ����� ����� � .�; \n86:   # ��� MDd ������� ������� ��� (D_GLIBCXX_DEBUG �� ��� �� ������ ��), ������� ���� ��� ���� \n87:   CONFIG_FLAGS := -O0 -g -fsanitize=address\n88:   # -fsanitize=address ���� ��� �������� ����� ��������� ����� runtime-����������\n89:   # DEBUG �� ����� - �.�. ���������� ����� � .o, �� � ��������� .pdb\n90:   LINK_FLAGS := -fsanitize=address\n91:   else\n92:   # -O2 - � ������������\n93:   # MD ��� - �� ������� ��� ������ CRT\n94:   CONFIG_FLAGS := -O2 -g -DNDEBUG \n95:   # ���� ����������� ����� �����, ����� �������� ����� ���-�� ���� -ffunction-sections -fdata-sections -Wl --gc-sections --icf=safe\n96:   LINK_FLAGS := \n97:   endif\n98:   # �������� ����� ������ cl\n99:   CXXFLAGS := $(CXXSTD) $(WARN) $(CONFIG_FLAGS)  \n100:   CFLAGS := $(CSTD) $(WARN) $(CONFIG_FLAGS)\n101: endif\n102: \n103: \n104: # ---------- ���������� ��� ����� (��� ����������, ����������� �����, �������� �����) ---------- \n105: # ����������� ����� ���������� �������� - ����� �������� �� win � linux - �� ������\n106: RUN_CASE := $(BINDIR)/tools/run_case$(EXE_EXT)\n107: FIND_SUBSTR := $(BINDIR)/tools/check_contains$(EXE_EXT)\n108: ifeq ($(OS), Windows_NT)\n109:   # ���� ��� windows �� � ���. ����� ����� ������ ���� ��������\n110:   RUN_CASE_CMD := $(subst /,\\,$(RUN_CASE))\n111:   FIND_SUBSTR_CMD := $(subst /,\\,$(FIND_SUBSTR))\n112: else\n113:   RUN_CASE_CMD := $(RUN_CASE)\n114:   FIND_SUBSTR_CMD := $(FIND_SUBSTR)\n115: endif\n116: \n117: # ���������� � ����������� (���� � ���-����)\n118: T1_CPP_OBJ := $(BINDIR)/t1_dist_matrix_cpp/main$(OBJ_EXT) $(BINDIR)/common/geometry_cpp$(OBJ_EXT)\n119: T1_C_OBJ := $(BINDIR)/t1_dist_matrix_c/main$(OBJ_EXT) $(BINDIR)/common/geometry_c$(OBJ_EXT)\n120: T1_CPP_EXE := $(BINDIR)/t1_dist_matrix_cpp/main$(EXE_EXT)\n121: T1_C_EXE := $(BINDIR)/t1_dist_matrix_c/main$(EXE_EXT)\n122: \n123: T2_CPP_OBJ := $(BINDIR)/t2_passport_cpp/main$(OBJ_EXT) $(BINDIR)/common/string_utils_cpp$(OBJ_EXT)\n124: T2_C_OBJ := $(BINDIR)/t2_passport_c/main$(OBJ_EXT) $(BINDIR)/common/string_utils_c$(OBJ_EXT)\n125: T2_CPP_EXE := $(BINDIR)/t2_passport_cpp/main$(EXE_EXT)\n126: T2_C_EXE := $(BINDIR)/t2_passport_c/main$(EXE_EXT)\n127: \n128: T3_CPP_EXE := $(BINDIR)/t3_bbox_cpp/main$(EXE_EXT)\n129: T3_C_EXE := $(BINDIR)/t3_bbox_c/main$(EXE_EXT)\n130: \n131: T4_CPP_EXE := $(BINDIR)/t4_filter_cpp/main$(EXE_EXT)\n132: T4_C_EXE := $(BINDIR)/t4_filter_c/main$(EXE_EXT)\n133: \n134: # ������������ ���������� - ������ ����� �.�. ��� ������ ���������� ����� ���������� � lib\n135: ifeq ($(OS), Windows_NT)\n136:   CPP_SHARED := $(BINDIR)/common/common_cpp.dll\n137:   C_SHARED := $(BINDIR)/common/common_c.dll\n138: else\n139:   CPP_SHARED := $(BINDIR)/common/libcommon_cpp.so\n140:   C_SHARED := $(BINDIR)/common/libcommon_c.so\n141: endif\n142: \n143: \n144: # target-specific ���������� - ��� ����������� �������� �� ����� ���������� - ����������� / ������������ \n145: $(T1_CPP_EXE) $(T1_C_EXE) $(T2_CPP_EXE) $(T2_C_EXE): COMMON_FLAG := $(DEFINE)COMMON_STATIC\n146: # ��� t3 - t4 ���� ���� ������ - ��� ������� ����� ����������, ��� ������������� �� dll\n147: $(T3_CPP_EXE) $(T3_C_EXE) $(T4_CPP_EXE) $(T4_C_EXE): COMMON_FLAG :=\n148: \n149: # ���� (��������)\n150: # ��� ������ ����� wildcard: ���� ��� �������, �� ��� ���������� ������ make ����� ��������� � �������� ��������\n151: # � �� ������ ��� �� ������ �� .ok ������ - ������� ������ ��� �� ����. ����� �� ��� ������ .ok ����� ������ ��� �� �� ����������\n152: # ������ � ����������� ������\n153: T1_CPP_TESTS := $(TESTDIR)/t1_cpp_abc.ok \\\n154: \t    $(TESTDIR)/t1_cpp_float.ok \\\n155: \t    $(TESTDIR)/t1_cpp_low.ok \\\n156: \t    $(TESTDIR)/t1_cpp_high.ok \\\n157: \t    $(TESTDIR)/t1_cpp_nul.ok \\\n158:             $(TESTDIR)/t1_cpp_norm.ok\n159: \n160: T1_C_TESTS := $(TESTDIR)/t1_c_abc.ok \\\n161: \t    $(TESTDIR)/t1_c_float.ok \\\n162: \t    $(TESTDIR)/t1_c_low.ok \\\n163: \t    $(TESTDIR)/t1_c_high.ok \\\n164: \t    $(TESTDIR)/t1_c_nul.ok \\\n165:             $(TESTDIR)/t1_c_norm.ok\n166: \n167: T2_CPP_TESTS := $(TESTDIR)/t2_cpp_norm.ok \\\n168:                 $(TESTDIR)/t2_cpp_eof_name.ok \\\n169:                 $(TESTDIR)/t2_cpp_empty_name.ok \\\n170:                 $(TESTDIR)/t2_cpp_eof_vertexes.ok \\\n171:                 $(TESTDIR)/t2_cpp_empty_vertexes.ok \\\n172:                 $(TESTDIR)/t2_cpp_negative_vertexes.ok \\\n173:                 $(TESTDIR)/t2_cpp_fractional_vertexes.ok \\\n174:                 $(TESTDIR)/t2_cpp_nan_vertexes.ok\n175: \n176: T2_C_TESTS := $(TESTDIR)/t2_c_norm.ok \\\n177:                 $(TESTDIR)/t2_c_eof_name.ok \\\n178:                 $(TESTDIR)/t2_c_empty_name.ok \\\n179:                 $(TESTDIR)/t2_c_eof_vertexes.ok \\\n180:                 $(TESTDIR)/t2_c_empty_vertexes.ok \\\n181:                 $(TESTDIR)/t2_c_negative_vertexes.ok \\\n182:                 $(TESTDIR)/t2_c_fractional_vertexes.ok \\\n183:                 $(TESTDIR)/t2_c_nan_vertexes.ok\n184: \n185: T3_CPP_TESTS := $(TESTDIR)/t3_cpp_empty_case.ok \\\n186:                 $(TESTDIR)/t3_cpp_not_digit_case.ok \\\n187:                 $(TESTDIR)/t3_cpp_too_few_args_case.ok \\\n188:                 $(TESTDIR)/t3_cpp_test1.ok \\\n189:                 $(TESTDIR)/t3_cpp_test2.ok \\\n190:                 $(TESTDIR)/t3_cpp_test3.ok \n191: \n192: T3_C_TESTS := $(TESTDIR)/t3_c_empty_case.ok \\\n193:                 $(TESTDIR)/t3_c_not_digit_case.ok \\\n194:                 $(TESTDIR)/t3_c_too_few_args_case.ok \\\n195:                 $(TESTDIR)/t3_c_test1.ok \\\n196:                 $(TESTDIR)/t3_c_test2.ok \\\n197:                 $(TESTDIR)/t3_c_test3.ok \n198: \n199: T4_CPP_TESTS := $(TESTDIR)/t4_cpp_radius_empty.ok \\\n200:                 $(TESTDIR)/t4_cpp_radius_too_much.ok \\\n201:                 $(TESTDIR)/t4_cpp_radius_symbol.ok \\\n202:                 $(TESTDIR)/t4_cpp_radius_inf.ok \\\n203:                 $(TESTDIR)/t4_cpp_radius_negative.ok \\\n204:                 $(TESTDIR)/t4_cpp_symbol_coords.ok \\\n205:                 $(TESTDIR)/t4_cpp_too_few_coords.ok \\\n206:                 $(TESTDIR)/t4_cpp_empty_coords.ok \\\n207:                 $(TESTDIR)/t4_cpp_test1.ok \\\n208:                 $(TESTDIR)/t4_cpp_test2.ok \\\n209:                 $(TESTDIR)/t4_cpp_test3.ok \n210: \n211: T4_C_TESTS := $(TESTDIR)/t4_c_radius_empty.ok \\\n212:                 $(TESTDIR)/t4_c_radius_too_much.ok \\\n213:                 $(TESTDIR)/t4_c_radius_symbol.ok \\\n214:                 $(TESTDIR)/t4_c_radius_inf.ok \\\n215:                 $(TESTDIR)/t4_c_radius_negative.ok \\\n216:                 $(TESTDIR)/t4_c_symbol_coords.ok \\\n217:                 $(TESTDIR)/t4_c_too_few_coords.ok \\\n218:                 $(TESTDIR)/t4_c_empty_coords.ok \\\n219:                 $(TESTDIR)/t4_c_test1.ok \\\n220:                 $(TESTDIR)/t4_c_test2.ok \\\n221:                 $(TESTDIR)/t4_c_test3.ok\n222: \n223: # exit-����\n224: USAGE := 64\n225: DATA := 65\n226: NO_INPUT := 66\n227: IO_FAIL := 74\n228: \n229: # �������� ���������� ����� ��������� - ��������� ��������� order-only (���. ����), �.�. % ������� �� �.�. � ������ � order-only\n230: CPP_DIRS := $(BINDIR)/t1_dist_matrix_cpp $(BINDIR)/t2_passport_cpp $(BINDIR)/t3_bbox_cpp $(BINDIR)/t4_filter_cpp\n231: C_DIRS := $(BINDIR)/t1_dist_matrix_c $(BINDIR)/t2_passport_c $(BINDIR)/t3_bbox_c $(BINDIR)/t4_filter_c\n232: \n233: \n234: # ---------- ����������� (ORDER-ONLY, ����� ������ �� �������) ---------- \n235: \n236: # /tools ���������� ������ ��� run_case.exe\n237: # � ����� ��� ������� ����� ��������� �� 5 ������ ���� \"$(BINDIR)/t1_dist_matrix_cpp: $(MKDIR) $@\"\n238: \n239: # Make ����� ���� ������ ���� ���-�� �����, ��������, $(BINDIR)/common, �� ����� /common ��� ���. \n240: # ����� make ����� ���� � ������� ���������� MKDIR\n241: $(CPP_DIRS) $(C_DIRS) $(BINDIR)/common $(BINDIR)/tools $(TESTDIR):\n242: \t$(MKDIR) $(call WCMD,$@)\n243: \n244: \n245: # ---------- ����������� - (����)������� ���� ����: ����������� ��� ����ͨ� ����� ���� ��� ���� �٨ �� ���������� ---------- \n246: # ����: �������.1 �������.2 ...\n247: # $@ - ����\n248: # $< - ������ �����������\n249: # $^ - ��� ������������\t\n250: \n251: # ������\n252: # ������� ��� ���x .obj � ������������ /bin/..., \n253: # ��� ������� ���� ���������� .cpp/.c (����� � ����� �� �����, �� ��� � ����� �������)\n254: # ���� COMMON_FLAG - target-specific ����������. ������ �� ��� ���������� �������� - ������. / �������. \n255: # � order-only - ����� ����� ��� ���������� ������������, ���� ������ ��� �� ����\n256: $(BINDIR)/%$(OBJ_EXT): %.cpp | $(CPP_DIRS)\n257: \t$(CXX) $(COMPILE_ONLY) $(COMMON_FLAG) $(OBJ_OU