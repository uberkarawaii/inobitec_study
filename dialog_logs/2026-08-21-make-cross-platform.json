al comdat folding - ����� ����, ������� ��������� ����� cl, ������������ � ����\n47:     # ���� /OPT:ICF �� /OPT:REF ���������� �������������. \n48:     # /OPT:... ��������� �������� .exe, �� ���. ��� ���������� �� 1:1 � ����������� ����� - ���������� ��� �������  \n49:     LINK_FLAGS := /DEBUG /OPT:REF /OPT:ICF  \n50:   endif\n51:   # �������� ����� ������ cl\n52:   CXXFLAGS := $(CXXSTD) $(WARN) /EHsc $(CONFIG_FLAGS)  \n53:   CFLAGS := $(CSTD) $(WARN) $(CONFIG_FLAGS)\n54: else\n55:   # ����� ��� ������\n56:   CC := gcc\n57:   CXX := g++\n58:   COMPILE_ONLY := -c\n59:   LINK := g++\n60:   CSTD := -std=c17\n61:   CXXSTD := -std=c++23\n62:   WARN := -Wall -Wextra\n63:   OBJ_OUT := -o\n64:   EXE_OUT := -o\n65:   LINK_OUT := -o\n66:   DEFINE := -D\n67:   DLL := -shared\n68:   GREP := grep\n69:   NULLDEV := /dev/null\n70:   MKDIR := mkdir -p\n71:   TOUCH := touch\n72:   # -rf: -r recursive -f force. ����������, �.�. ��� \"�������\"\n73:   RMDIR := rm -rf\n74:   FC := diff\n75:   # ��������� ������ � ����� ��� �������. = � �� := ����� ������������ ��� ������ ������, � �� �������. ���\n76:   WCMD = $1\n77:   ifeq ($(CONFIG), debug)\n78:   # TODO\n79:   else\n80:   # TODO\n81:   endif\n82: endif\n83: \n84: \n85: # ---------- ���������� ��� ����� (��� ����������, ����������� �����, �������� �����) ---------- \n86: # ����������� ����� ���������� ��������\n87: RUN_CASE := $(BINDIR)/tools/run_case.exe\n88: FIND_SUBSTR := $(BINDIR)/tools/check_contains.exe\n89: # ��� ������ ��� �������. �������� RUN_CASE_CMD � ������� ����� ������, �.�. ��� �� ���������� ����� RUN_CASE. �� �� � FIND_SUBSTR\n90: ifeq ($(OS), Windows_NT)\n91:   RUN_CASE_CMD := $(subst /,\\,$(RUN_CASE))\n92:   FIND_SUBSTR_CMD := $(subst /,\\,$(FIND_SUBSTR))\n93: else\n94:   RUN_CASE_CMD := $(RUN_CASE)\n95:   FIND_SUBSTR_CMD := $(FIND_SUBSTR)\n96: endif\n97: \n98: # ���������� � ����������� (���� � ���-����)\n99: T1_CPP_OBJ := $(BINDIR)/t1_dist_matrix_cpp/main.obj $(BINDIR)/common/geometry_cpp.obj\n100: T1_C_OBJ := 