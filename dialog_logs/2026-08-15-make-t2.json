tools $(TESTDIR):\n124: \t$(MKDIR) $@\n125: \n126: \n127: # ---------- ����������� - (����)������� ���� ����: ����������� ��� ����ͨ� ����� ���� ��� ���� �٨ �� ���������� ---------- \n128: # ����: �������.1 �������.2 ...\n129: # $@ - ����\n130: # $< - ������ �����������\n131: # $^ - ��� ������������\t\n132: \n133: # ������\n134: # ������� ��� ���x .obj � ������������ /bin/..., \n135: # ��� ������� ���� ���������� .cpp/.c (����� � ����� �� �����, �� ��� � ����� �������)\n136: # ���� COMMON_FLAG - target-specific ����������. ������ �� ��� ���������� �������� - ������. / �������. \n137: # � order-only - ����� ����� ��� ���������� ������������, ���� ������ ��� �� ����\n138: $(BINDIR)\\\\%.obj: %.cpp | $(CPP_DIRS)\n139: \t$(CXX) /c $(COMMON_FLAG) /Fo:$@ $(CXXFLAGS) $<   \n140: \n141: # ����������� ��� ��\n142: $(BINDIR)\\\\%.obj: %.c | $(C_DIRS) \n143: \t$(CC) /c $(COMMON_FLAG) /Fo:$@ $(CFLAGS) $<\n144: \n145: # STATIC (t1-t2) ������� ��� geometry + string_utils, �.�. �� ����� ����������� �� ��������� � ������� .src\n146: $(BINDIR)\\common\\geometry_cpp.obj: common\\geometry.cpp common\\geometry.hpp | $(BINDIR)\\common\n147: \t$(CXX) /c /DCOMMON_STATIC /Fo:$@ $(CXXFLAGS) $< \n148: \n149: $(BINDIR)\\common\\geometry_c.obj: common\\geometry.c common\\geometry.h | $(BINDIR)\\common\n150: \t$(CC) /c /DCOMMON_STATIC /Fo:$@ $(CFLAGS) $<\n151: \n152: $(BINDIR)\\common\\string_utils_cpp.obj: common\\string_utils.cpp common\\string_utils.hpp | $(BINDIR)\\common\n153: \t$(CXX) /c /DCOMMON_STATIC /Fo:$@ $(CXXFLAGS) $<\n154: \n155: $(BINDIR)\\common\\string_utils_c.obj: common\\string_utils.c common\\string_utils.h | $(BINDIR)\\common\n156: \t$(CC) /c /DCOMMON_STATIC /Fo:$@ $(CFLAGS) $<\n157: \n158: # DYNAMIC (t3-t4)\n159: $(BINDIR)\\common\\geometry_cpp_dll.obj: common\\geometry.cpp | $(BINDIR)\\common\n160: \t$(CXX) /c /DCOMMON_EXPORTS /Fo:$@ $(CXXFLAGS) $<\n161: \n162: $(BINDIR)\\common\\geometry_c_dll.obj: common\\geometry.c | $(BINDIR)\\common\n163: \t$(CC) /c /DCOMMON_EXPORTS /