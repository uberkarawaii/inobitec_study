k \\\n175:                 $(TESTDIR)/t2_c_nan_vertexes.ok\n176: \n177: T3_CPP_TESTS := $(TESTDIR)/t3_cpp_empty_case.ok \\\n178:                 $(TESTDIR)/t3_cpp_not_digit_case.ok \\\n179:                 $(TESTDIR)/t3_cpp_too_few_args_case.ok \\\n180:                 $(TESTDIR)/t3_cpp_test1.ok \\\n181:                 $(TESTDIR)/t3_cpp_test2.ok \\\n182:                 $(TESTDIR)/t3_cpp_test3.ok \n183: \n184: T3_C_TESTS := $(TESTDIR)/t3_c_empty_case.ok \\\n185:                 $(TESTDIR)/t3_c_not_digit_case.ok \\\n186:                 $(TESTDIR)/t3_c_too_few_args_case.ok \\\n187:                 $(TESTDIR)/t3_c_test1.ok \\\n188:                 $(TESTDIR)/t3_c_test2.ok \\\n189:                 $(TESTDIR)/t3_c_test3.ok \n190: \n191: T4_CPP_TESTS := $(TESTDIR)/t4_cpp_radius_empty.ok \\\n192:                 $(TESTDIR)/t4_cpp_radius_too_much.ok \\\n193:                 $(TESTDIR)/t4_cpp_radius_symbol.ok \\\n194:                 $(TESTDIR)/t4_cpp_radius_inf.ok \\\n195:                 $(TESTDIR)/t4_cpp_radius_negative.ok \\\n196:                 $(TESTDIR)/t4_cpp_symbol_coords.ok \\\n197:                 $(TESTDIR)/t4_cpp_too_few_coords.ok \\\n198:                 $(TESTDIR)/t4_cpp_empty_coords.ok \\\n199:                 $(TESTDIR)/t4_cpp_test1.ok \\\n200:                 $(TESTDIR)/t4_cpp_test2.ok \\\n201:                 $(TESTDIR)/t4_cpp_test3.ok \n202: \n203: T4_C_TESTS := $(TESTDIR)/t4_c_radius_empty.ok \\\n204:                 $(TESTDIR)/t4_c_radius_too_much.ok \\\n205:                 $(TESTDIR)/t4_c_radius_symbol.ok \\\n206:                 $(TESTDIR)/t4_c_radius_inf.ok \\\n207:                 $(TESTDIR)/t4_c_radius_negative.ok \\\n208:                 $(TESTDIR)/t4_c_symbol_coords.ok \\\n209:                 $(TESTDIR)/t4_c_too_few_coords.ok \\\n210:                 $(TESTDIR)/t4_c_empty_coords.ok \\\n211:                 $(TESTDIR)/t4_c_test1.ok \\\n212:                 $(TESTDIR)/t4_c_test2.ok \\\n213:                 $(TESTDIR)/t4_c_test3.ok\n214: \n215: # exit-����\n216: USAGE := 64\n217: DATA := 65\n218: NO_INPUT := 66\n219: IO_FAIL := 74\n220: \n221: # �������� ���������� ����� ��������� - ��������� ��������� order-only (���. ����), �.�. % ������� �� �.�. � ������ � order-only\n222: CPP_DIRS := $(BINDIR)/t1_dist_matrix_cpp $(BINDIR)/t2_passport_cpp $(BINDIR)/t3_bbox_cpp $(BINDIR)/t4_filter_cpp\n223: C_DIRS := $(BINDIR)/t1_dist_matrix_c $(BINDIR)/t2_passport_c $(BINDIR)/t3_bbox_c $(BINDIR)/t4_filter_c\n224: \n225: \n226: # ---------- ����������� (ORDER-ONLY, ����� ������ �� �������) ---------- \n227: \n228: # /tools ���������� ��� ���������� �������� - run_case � check\n229: # � ����� ��� ������� ����� ��������� �� 5 ������ ���� \"$(BINDIR)/t1_dist_matrix_cpp: $(MKDIR) $@\"\n230: \n231: # Make ����� ���� ������ ���� ���-�� �����, ��������, $(BINDIR)/common, �� ����� /common ��� ���. \n232: # ����� make ����� ���� � ������� ���������� MKDIR\n233: $(CPP_DIRS) $(C_DIRS) $(BINDIR)/common $(BINDIR)/tools $(TESTDIR):\n234: \t$(MKDIR) $(call WCMD,$@)\n235: \n236: \n237: # ---------- ����������� - (����)������� ���� ����: ����������� ��� ����ͨ� ����� ���� ��� ���� �٨ �� ���������� ---------- \n238: # ����: �������.1 �������.2 ...\n239: # $@ - ����\n240: # $< - ������ �����������\n241: # $^ - ��� ������������\t\n242: \n243: # ������\n244: # ������� ��� ���x .obj � ������������ /bin/..., \n245: # ��� ������� ���� ���������� .cpp/.c (����� � ����� �� �����, �� ��� � ����� �������)\n246: # ���� COMMON_FLAG - target-specific ����������. ������ �� ��� ���������� �������� - ������. / �������. \n247: # � order-only - ����� ����� ��� ���������� ������������, ���� ������ ��� �� ����\n248: $(BINDIR)/%$(OBJ_EXT): %.cpp | $(CPP_DIRS)\n249: \t$(CXX) $(COMPILE_ONLY) $(COMMON_FLAG) $(OBJ_OUT)$@ $(CXXFLAGS) $<   \n250: \n251: # ����������� ��� ��\n252: $(BINDIR)/%$(OBJ_EXT): %.c | $(C_DIRS) \n253: \t$(CC) $(COMPILE_ONLY) $(COMMON_FLAG) $(OBJ_OUT)$@ $(CFLAGS) $<\n254: \n255: # STATIC (t1-t2) ������� ��� geometry + string_utils, �.�. �� ����� ����������� �� ��������� � ������� .src\n256: $(BINDIR)/common/geometry_cpp$(OBJ_EXT): common/geometry.cpp common/geometry.hpp | $(BINDIR)/common\n257: \t$(CXX) $(COMPILE_ONLY) $(DEFINE)COMMON_STATIC $(OBJ_OUT)$@ $(PIC_FLAGS) $(CXXFLAGS) $< \n258: \n259: $(BINDIR)/common/geometry_c$(OBJ_EXT): common/geometry.c common/geometry.h | $(BINDIR)/common\n260: \t$(CC) $(COMPILE_ONLY) $(DEFINE)COMMON_STATIC $(OBJ_OUT)$@ $(PIC_FLAGS) $(CFLAGS) $<\n261: \n262: $(BINDIR)/common/string_utils_cpp$(OBJ_EXT): common/string_utils.cpp common/string_utils.hpp | $(BINDIR)/common\n263: \t$(CXX) $(COMPILE_ONLY) $(DEFINE)COMMON_STATIC $(OBJ_OUT)$@ $(PIC_FLAGS) $(CXXFLAGS) $<\n264: \n265: $(BINDIR)/common/string_utils_c$(OBJ_EXT): common/string_utils.c common/string_utils.h | $(BINDIR)/common\n266: \t$(CC) $(COMPILE_ONLY) $(DEFINE)COMMON_STATIC $(OBJ_OUT)$@ $(PIC_FLAGS) $(CFLAGS) $<\n267: \n268: # DYNAMIC (t3-t4)\n269: # ��� �������� ������ � �������������� ������ ���, ������� � �������� ����������� (������� ���� �� �����) �� �����\n270: ifeq ($(OS), Windows_NT)\n271: $(BINDIR)/common/geometry_cpp_dll$(OBJ_EXT): common/geometry.cpp common/geometry.hpp | $(BINDIR)/common\n272: \t$(CXX) $(COMPILE_ONLY) $(DEFINE)COMMON_EXPORTS $(OBJ_OUT)$@ $(CXXFLAGS) $<\n273: \n274: $(BINDIR)/common/geometry_c_dll$(OBJ_EXT): common/geometry.c common/geometry.h | $(BINDIR)/common\n275: \t$(CC) $(COMPILE_ONLY) $(DEFINE)COMMON_EXPORTS $(OBJ_OUT)$@ $(CFLAGS) $<\n276: \n277: $(BINDIR)/common/string_utils_cpp_dll$(OBJ_EXT): common/string_utils.cpp common/string_utils.hpp | $(BINDIR)/common\n278: \t$(CXX) $(COMPILE_ONLY) $(DEFINE)COMMON_EXPORTS $(OBJ_OUT)$@ $(CXXFLAGS) $<\n279: \n280: $(BINDIR)/common/string_utils_c_dll$(OBJ_EXT): common/string_utils.c common/string_utils.h | $(BINDIR)/common\n281: \t$(CC) $(COMPILE_ONLY) $(DEFINE)COMMON_EXPORTS $(OBJ_OUT)$@ $(CFLAGS) $<\n282: endif\n283: \n284: # ��������\n285: # �������� ��� 1 ������ � ������ geometry. �������� �����������, �� ��� ���� geometry ��� string_utils\n286: $(BINDIR)/t1_dist_matrix_cpp/main$(EXE_EXT): $(T1_CPP_OBJ) | $(BINDIR)/t1_dist_matrix_cpp\n287: \t$(LINK) $(LINK_FLAGS) $(LINK_OUT)$@ $^ \n288: \n289: $(BINDIR)/t1_dist_matrix_c/main$(EXE_EXT): $(T1_C_OBJ) | $(BINDIR)/t1_dist_matrix_c \n290: \t$(LINK) $(LINK_FLAGS) $(LINK_OUT)$@ $^\n291: \n292: # �������� ��� 2 ������. ����� ������., � ����� ������� string_utils\n293: $(BINDIR)/t2_passport_cpp/main$(EXE_EXT): $(T2_CPP_OBJ) | $(BINDIR)/t2_passport_cpp\n294: \t$(LINK) $(LINK_FLAGS) $(LINK_OUT)$@ $^\t\n295: \n296: $(BINDIR)/t2_passport_c/main$(EXE_EXT): $(T2_C_OBJ) | $(BINDIR)/t2_passport_c\n297: \t$(LINK) $(LINK_FLAGS) $(LINK_OUT)$@ $^\n298: \n299: # ���������� ��� ����������� � dll+lib / so �� �� ������������� �� ������ ����������\n300: ifeq ($(OS), Windows_NT)\n301:   # ���������� � ��������� import / export �� �������� \n302:   CPP_DLL_OBJ := $(BINDIR)/common/geometry_cpp_dll$(OBJ_EXT) $(BINDIR)/common/string_utils_cpp_dll$(OBJ_EXT)\n303:   C_DLL_OBJ := $(BINDIR)/common/geometry_c_dll$(OBJ_EXT) $(BINDIR)/common/string_utils_c_dll$(OBJ_EXT)\n304: \n305:   CPP_SHARED      := $(BINDIR)/common/common_cpp.dll\n306:   CPP_SHARED_LINK := $(BINDIR)/common/common_cpp.lib    \n307:   C_SHARED        := $(BINDIR)/common/common_c.dll\n308:   C_SHARED_LINK   := $(BINDIR)/common/common_c.lib\n309: else\n310:   # ��� �������� ���������� �������, ��� ������� inport / export\n311:   CPP_OBJ := $(BINDIR)/common/geometry_cpp$(OBJ_EXT) $(BINDIR)/common/string_utils_cpp$(OBJ_EXT)\n312:   C_OBJ := $(BINDIR)/common/geometry_c$(OBJ_EXT) $(BINDIR)/common/string_utils_c$(OBJ_EXT)\n313:   # ��� �������� ���� ����� � ����� .so\n314:   CPP_SHARED      := $(BINDIR)/common/libcommon_cpp.so\n315:   CPP_SHARED_LINK := $(CPP_SHARED)                       \n316:   C_SHARED        := $(BINDIR)/common/libcommon_c.so\n317:   C_SHARED_LINK   := $(C_SHARED)\n318: endif\n319: \n320: # ===== �������� ������������ ���������� =====\n321: ifeq ($(OS), Windows_NT)\n322: # �������� common_cpp.dll � com