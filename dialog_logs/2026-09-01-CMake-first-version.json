            "output": "<path>C:\\Users\\User\\Desktop\\inobitec_stud\\CMakeLists.txt</path>\n<type>file</type>\n<content>\n1: # минимальная необходимая версия cmake + свежие политики (конкретные точки поведения) до 3.22 \n2: # в старых CMake-ах выполнение остановится здесь, с требованием версии 3.22\n3: # политика - как себя ведёт что-либо в CMake. если не указать версию, то default=OLD и будет warning, \n4: # т.к. старые политики - для совместимости, но не обещают корретности\n5: cmake_minimum_required(VERSION 3.22)\n6: # имя проекта сохранится в CMAKE_PROJECT_NAME\n7: # определяются яызки проекта: с с++; определится компилятор; \n8: # появятся перменные (типа CMAKE_C_FLAGS_DEBUG) заполненные дефолтными значениями\n9: project(inobitec_stud LANGUAGES C CXX)\n10: \n11: # === СТАНДАРТЫ ===\n12: # стандарт языка Си\n13: set(CMAKE_C_STANDARD 17)\n14: # компилятор обязан поддерживать этот стандарт языка. иначе - ошибка во время конфигурации CMakeLists (прекомпил.)\n15: set(CMAKE_C_STANDARD_REQUIRED ON)\n16: # только стандартный компилятор языка, без расширений, типа gnu-расширений\n17: set(CMAKE_C_EXTENSIONS OFF)\n18: # то же для с++\n19: set(CMAKE_CXX_STANDARD 23)\n20: set(CMAKE_CXX_STANDARD_REQUIRED ON)\n21: set(CMAKE_CXX_EXTENSIONS OFF)\n22: \n23: # === ТИП СБОРКИ ===\n24: # определение debug / release; делается через -DCMAKE_BUILD_TYPE=...\n25: # Debug будет поставлен, если ничего не передали через флаг\n26: if(NOT CMAKE_BUILD_TYPE)\n27:   set(CMAKE_BUILD_TYPE Debug CACHE STRING \"Build type: Debug / Release\" FORCE)\n28: endif()\n29: # переменная CMAKE_BUILD_TYPE будет сохранена в кэше с с пояснит. строкой\n30: # кэш: для самого CMake (хранить инф. м-у выполнениями) и чтобы человек каждый раз не вводил эти вещи\n31: # FORCE вызовет перезапись параметра\n32: \n33: # === НЕ /RTC1, А ASan ===\n34: # CMAke дефолтно положит /RTC1 в debug-ветку. /RTC1 ловит ошибки в runtime, для этого лезет в стек и размечает его\n35: # ASan - та же ф-ция. если оба будут менять стек, они помешают друг другу -> несовместимы. /RTC1 убирается \n36: if(MSVC)\n37:   string(REPLACE \"/RTC1\" \"\" CMAKE_C_FLAGS_DEBUG   \"${CMAKE_C_FLAGS_DEBUG}\")\n38:   string(REPLACE \"/RTC1\" \"\" CMAKE_CXX_FLAGS_DEBUG \"${CMAKE_CXX_FLAGS_DEBUG}\")\n39: endif()\n40: \n41: # === ПОСТРОИТЬ КОМАНДЫ КОМПИЛЯЦИИ И ЛИНКА ===\n42: # тут очень много полагается на слова deepseek-a про флаги, которые должны подтянуться via CMake - важно следить за этим\n43: function(configure_target trgt DBG)\n44: if(MSVC)\n45:   # target_compile_options - общие флаги компилятора \n46:   # PRIVATE даёт нетранзитивность: А (этот объект) и Б к нему сможет линковаться. а когда К линк. к Б, то К не будет линк. к А\n47:   target_compile_options(${trgt} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:/EHsc> /W4 /permissive-)\n48: \n49:   # сюда будет заходить только для программ из задач, не для программ для тестирования (run_case, check) - им эти флаги не нужны\n50:   if(DBG)\n51:     # CMake проставит след. флаги автоматиечки: /Od /O2; /MDd /MD; /DNDEBUG\n52:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Debug>:/Zi /fsanitize=address> $<$<CONFIG:Release>:/Zi>)\n53:     target_link_options(${trgt} PRIVATE $<$<CONFIG:Debug>:/DEBUG> $<$<CONFIG:Release>:/DEBUG /OPT:REF /OPT:ICF>)\n54:   endif()\n55: \n56: else()\n57:   target_compile_options(${trgt} PRIVATE -Wall -Wextra)\n58:   # и в ветке продуктов, и в ветке тестовых программ оптимизация на релизе будет именно -O2, а не cmake-default -O3\n59:   if (DBG) \n60:     # -O0 на дебаге будет подтянут CMake автоматически, а на релизе -DNDEBUG\n61:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Debug>: -g -fsanitize=address> $<$<CONFIG:Release>: -g -O2>)\n62:     target_link_options(${trgt} PRIVATE $<$<CONFIG:Debug>: -fsanitize=address>)\n63:   else()\n64:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Release>: -O2>)\n65:   endif()\n66: endif()\n67: endfunction()\n68: \n69: # === ДОБАВЛЕНИЕ ЗАДАЧИ === \n70: # сборки exe из main.c/main.cpp; уходит в каталог build/cfg/dir\n71: function(add_task dir trgt src lib)\n72: \n73:   # добавление исполняемного файла \n74:   # цель и её исходник. цель имеет одно имя (логическое, типа t1_c), а сделанный ею файл - другое (OUTPUT_NAME main)\n75:   add_executable(${trgt} ${src})\n76: \n77:   # в CMAKE_BINARY_DIR будет тот каталог, который был передан по -B\n78:   set_target_properties(${trgt} PROPERTIES\n79:   OUTPUT_NAME main\n80:   RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/${dir})\n81: \n82:   # с кем линкуемся\n83:   # тут private не имеет смысла (.exe конечен, к нему не линкуются), просто для единообразия\n84:   target_link_libraries(${trgt} PRIVATE ${lib})\n85: \n86:   # команда для cl+link. флаг DEBUG = ON - т.е. пойдём по ветке if (DBG) с флагами для программ-задач\n87:   configure_target(${trgt} ON)\n88:  \n89: endfunction()\n90: \n91: # переход в /common к CMakeLists.txt, там сделаются common_...lib, с которыми main надо слинковаться  \n92: add_subdirectory(common)\n93: \n\n(End of file - total 93 lines)\n</content>",
