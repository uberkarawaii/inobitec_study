лог build/cfg/dir\n71: function(add_task dir trgt src lib)\n72: \n73:   # добавление исполняемного файла \n74:   # цель и её исходник. цель имеет одно имя (логическое, типа t1_c), а сделанный ею файл - другое (OUTPUT_NAME main)\n75:   add_executable(${trgt} ${src})\n76: \n77:   # в CMAKE_BINARY_DIR будет тот каталог, который был передан по -B\n78:   set_target_properties(${trgt} PROPERTIES\n79:   OUTPUT_NAME main\n80:   RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/${dir})\n81: \n82:   # с кем линкуемся\n83:   # тут private не имеет смысла (.exe конечен, к нему не линкуются), просто для единообразия\n84:   target_link_libraries(${trgt} PRIVATE ${lib})\n85: \n86:   # команда для cl+link. флаг DEBUG = ON - т.е. пойдём по ветке if (DBG) с флагами для программ-задач\n87:   configure_target(${trgt} ON)\n88:  \n89: endfunction()\n90: \n91: # переход в /common к CMakeLists.txt, там сделаются common_...lib, с которыми main надо слинковаться  \n92: add_subdirectory(common)\n93: \n94: # arg1 - папка бинарей и прочих продуктов (build/cfg/...)\n95: # arg2 - логическое имя цели\n96: # arg3 - исходник, чтобы сделать файл цели\n97: # arg4 - библиотека с которой линковаться\n98: add_task(t1_dist_matrix_cpp t1_cpp t1_dist_matrix_cpp/main.cpp common_cpp_static)\n99: add_task(t1_dist_matrix_c t1_c t1_dist_matrix_c/main.c common_c_static)\n\n(End of file - total 99 lines)\n</content>",
            "metadata": {
              "preview": "# минимальная необходимая версия cmake + свежие политики (конкретные точки поведения) до 3.22 \n# в старых CMake-ах выполнение остановится здесь, с требованием версии 3.22\n# политика - как себя ведёт что-либо в CMake. если не указать версию, то default=OLD и будет warning, \n# т.к. старые политики - для совместимости, но не обещают корретности\ncmake_minimum_required(VERSION 3.22)\n# имя проекта сохранится в CMAKE_PROJECT_NAME\n# определяются яызки проекта: с с++; определится компилятор; \n# появятся перменные (типа CMAKE_C_FLAGS_DEBUG) заполненные дефолтными значениями\nproject(inobitec_stud LANGUAGES C CXX)\n\n# === СТАНДАРТЫ ===\n# стандарт языка Си\nset(CMAKE_C_STANDARD 17)\n# компилятор обязан поддерживать этот стандарт языка. иначе - ошибка во время конфигурации CMakeLists (прекомпил.)\nset(CMAKE_C_STANDARD_REQUIRED ON)\n# только стандартный компилятор языка, без расширений, типа gnu-расширений\nset(CMAKE_C_EXTENSIONS OFF)\n# то же для с++\nset(CMAKE_CXX_STANDARD 23)\nset(CMAKE_CXX_STANDARD_REQUIRED ON)",
