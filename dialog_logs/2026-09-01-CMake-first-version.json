помешают друг другу -> несовместимы. /RTC1 убирается \n36: # /incremental также несовместим с asan (именно по документации. так работало и когда оба вместе)\n37: if(MSVC)\n38:   string(REPLACE \"/RTC1\" \"\" CMAKE_C_FLAGS_DEBUG   \"${CMAKE_C_FLAGS_DEBUG}\")\n39:   string(REPLACE \"/RTC1\" \"\" CMAKE_CXX_FLAGS_DEBUG \"${CMAKE_CXX_FLAGS_DEBUG}\")\n40:   string(REPLACE \"/INCREMENTAL\" \"\" CMAKE_EXE_LINKER_FLAGS_DEBUG  \"${CMAKE_EXE_LINKER_FLAGS_DEBUG}\")\n41: endif()\n42: \n43: # === ПОСТРОИТЬ КОМАНДЫ КОМПИЛЯЦИИ И ЛИНКА ===\n44: # тут /Zi, /EHsc, /DEBUG  будут дублироваться, но прописываются для ясности\n45: function(configure_target trgt DBG)\n46: if(MSVC)\n47:   # target_compile_options - общие флаги компилятора \n48:   # PRIVATE даёт нетранзитивность: А (этот объект) и Б к нему сможет линковаться. а когда К линк. к Б, то К не будет линк. к А\n49:   target_compile_options(${trgt} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:/EHsc> /W4 /permissive-)\n50: \n51:   # сюда будет заходить только для программ из задач, не для программ для тестирования (run_case, check) - им эти флаги не нужны\n52:   if(DBG)\n53:     # CMake проставит след. флаги автоматиечки: /Od /O2; /MDd /MD; /DNDEBUG\n54:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Debug>:/Zi /fsanitize=address> $<$<CONFIG:Release>:/Zi>)\n55:     target_link_options(${trgt} PRIVATE $<$<CONFIG:Debug>:/DEBUG> $<$<CONFIG:Release>:/DEBUG /OPT:REF /OPT:ICF>)\n56:   endif()\n57: \n58: else()\n59:   target_compile_options(${trgt} PRIVATE -Wall -Wextra)\n60:   # и в ветке продуктов, и в ветке тестовых программ оптимизация на релизе будет именно -O2, а не cmake-default -O3\n61:   if (DBG) \n62:     # -O0 на дебаге будет подтянут CMake автоматически, а на релизе -DNDEBUG\n63:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Debug>: -g -fsanitize=address> $<$<CONFIG:Release>: -g -O2>)\n64:     target_link_options(${trgt} PRIVATE $<$<CONFIG:Debug>: -fsanitize=address>)\n65:   else()\n66:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Release>: -O2>)\n67:   endif()\n68: endif()\n69: endfunction()\n70: \n71: # === ДОБАВЛЕНИЕ ЗАДАЧИ === \n72: # сборки exe из main.c/main.cpp; уходит в каталог build/cfg/dir\n73: function(add_task dir trgt src lib)\n74: \n75:   # добавление исполняемного файла \n76:   # цель и её исходник. цель имеет одно имя (логическое, типа t1_c), а сделанный ею файл - другое (OUTPUT_NAME main)\n77:   add_executable(${trgt} ${src})\n78: \n79:   # в CMAKE_BINARY_DIR будет тот каталог, который был передан по -B\n80:   set_target_properties(${trgt} PROPERTIES\n81:   OUTPUT_NAME main\n82:   RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/${dir})\n83: \n84:   # с кем линкуемся\n85:   # тут private не имеет смысла (.exe конечен, к нему не линкуются), просто для единообразия\n86:   target_link_libraries(${trgt} PRIVATE ${lib})\n87: \n88:   # команда для cl+link. флаг DEBUG = ON - т.е. пойдём по ветке if (DBG) с флагами для программ-задач\n89:   configure_target(${trgt} ON)\n90:  \n91: endfunction()\n92: \n93: # переход в /common к CMakeLists.txt, там сделаются common_...lib, с которыми main надо слинковаться  \n94: add_subdirectory(common)\n95: \n96: # arg1 - папка бинарей и прочих продуктов (build/cfg/...)\n97: # arg2 - логическое имя цели\n98: # arg3 - исходник, чтобы сделать файл цели\n99: # arg4 - библиотека с которой линковаться\n100: add_task(t1_dist_matrix_cpp t1_cpp t1_dist_matrix_cpp/main.cpp common_cpp_static)\n101: add_task(t1_dist_matrix_c t1_c t1_dist_matrix_c/main.c common_c_static)\n\n(End of file - total 101 lines)\n</content>",
            "metadata": {
              "preview": "# минимальная необходимая версия cmake + свежие политики (конкретные точки поведения) до 3.22 \n# в старых CMake-ах выполнение остановится здесь, с требованием версии 3.22\n# политика - как себя ведёт что-либо в CMake. если не указать версию, то default=OLD и будет warning, \n# т.к. старые политики - для совместимости, но не обещают корретности\ncmake_minimum_required(VERSION 3.22)\n# имя проекта сохранится в CMAKE_PROJECT_NAME\n# определяются яызки проекта: с с++; определится компилятор; \n# появятся перменные (типа CMAKE_C_FLAGS_DEBUG) заполненные дефолтными значениями\nproject(inobitec_stud LANGUAGES C CXX)\n\n# === СТАНДАРТЫ ===\n# стандарт языка Си\nset(CMAKE_C_STANDARD 17)\n# компилятор обязан поддерживать этот стандарт языка. иначе - ошибка во время конфигурации CMakeLists (прекомпил.)\nset(CMAKE_C_STANDARD_REQUIRED ON)\n# только стандартный компилятор языка, без расширений, типа gnu-расширений\nset(CMAKE_C_EXTENSIONS OFF)\n# то же для с++\nset(CMAKE_CXX_STANDARD 23)\nset(CMAKE_CXX_STANDARD_REQUIRED ON)",
