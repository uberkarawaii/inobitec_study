��� ����� ��� ���������� ������������, ���� ������ ��� �� ����\n289: \n290: # ������������� ����� �������. obj - ����� ��� ��������� hdr obj ��������� ������\n291: # �������� ������������� ��� t1-t2 �.�. ��� ���������� � ��������� ���������� ������� ����, ���� ������ ����������, ��� ����� obj ����� hdr\n292: \n293: # ���-���� �������������� (������ ��� �������)\n294: ifeq ($(OS), Windows_NT)\n295:  \n296: GEOM_CPP_HDR := common/geometry.hpp\n297: GEOM_C_HDR := common/geometry.h\n298: \n299: STR_UTIL_CPP_HDR := common/string_utils.hpp\n300: STR_UTIL_C_HDR := common/string_utils.h\n301: \n302: CPP_OBJ_HDR := common/exit_codes.hpp $(STR_UTIL_CPP_HDR) $(GEOM_CPP_HDR)\n303: C_OBJ_HDR := common/exit_codes.h $(STR_UTIL_C_HDR) $(GEOM_C_HDR)\n304: \n305: else\n306: \n307: GEOM_CPP_HDR := \n308: GEOM_C_HDR := \n309: \n310: STR_UTIL_CPP_HDR := \n311: STR_UTIL_C_HDR := \n312: \n313: CPP_OBJ_HDR := \n314: C_OBJ_HDR := \n315: \n316: endif\n317: \n318: \n319: $(BINDIR)/%$(OBJ_EXT): %.cpp $(CPP_OBJ_HDR) | $(CPP_DIRS)\n320: \t$(CXX) $(COMPILE_ONLY) $(COMMON_FLAG) $(OBJ_OUT)$@ $(CXXFLAGS) $(FD) $<   \n321: \n322: # ����������� ��� ��\n323: $(BINDIR)/%$(OBJ_EXT): %.c $(C_OBJ_HDR) | $(C_DIRS) \n324: \t$(CC) $(COMPILE_ONLY) $(COMMON_FLAG) $(OBJ_OUT)$@ $(CFLAGS) $(FD) $<\n325: \n326: # STATIC (t1-t2) ������� ��� geometry + string_utils, �.�. �� ����� ����������� �� ��������� � ������� .src\n327: $(BINDIR)/common/geometry_cpp$(OBJ_EXT): common/geometry.cpp $(GEOM_CPP_HDR) | $(BINDIR)/common\n328: \t$(CXX) $(COMPILE_ONLY) $(DEFINE)COMMON_STATIC $(OBJ_OUT)$@ $(PIC_FLAGS) $(CXXFLAGS) $(FD) $< \n329: \n330: $(BINDIR)/common/geometry_c$(OBJ_EXT): common/geometry.c $(GEOM_C_HDR) | $(BINDIR)/common\n331: \t$(CC) $(COMPILE_ONLY) $(DEFINE)COMMON_STATIC $(OBJ_OUT)$@ $(PIC_FLAGS) $(CFLAGS) $(FD) $<\n332: \n333: $(BINDIR)/common/string_utils_cpp$(OBJ_EXT): common/string_utils.cpp $(STR_UTIL_CPP_HDR) | $(BINDIR)/common\n334: \t$(CXX) $(COMPILE_ONLY) $(DEFINE)COMMON_STATIC $(OBJ_OUT)$@ $(PIC_FLAGS) $(C