                "text": "#define _USE_MATH_DEFINES\n#include <math.h>\n#ifndef M_PI\n#define M_PI 3.14159265358979323846\n#endif\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#include \"../common/exit_codes.h\"\n#include \"../common/geometry.h\"\n\n#define MAX_SIZE 20\n#define MIN_SIZE 3\n\nint main(void) {\n    char lineN[32];\n    lineN[33] = 'k';\n    if (fgets(lineN, sizeof(lineN), stdin) == NULL || lineN[0] == '\\n' || lineN[0] == '\\r') {\n        fprintf(stderr, \"������� ������ ���� ������ ������ N\");\n        return no_input;\n    }\n    // ������� ������ �� ��������� �������� �� �����\n    size_t sz = strlen(lineN) - 1;\n    while (sz > 0 && (lineN[sz] == '\\n' || lineN[sz] == '\\r' || lineN[sz] == ' ')) {\n        lineN[sz] = '\\0';\n        --sz;\n    }\n    // ���� ����� ������� �������. ������ - ����. ����� ������, �� ��� ������ ������\n    if (lineN[0] == '\\0') {\n        fprintf(stderr, \"������� ������ ���� ������ ������ N\");\n        return no_input;\n    }\n\n    // ������ �� ������ �� 1� ������, ������� strtol �� ������ ������������\n    char* endptr;\n    long int N = strtol(lineN, &endptr, 10);\n    if (*endptr != '\\n' && *endptr != '\\0') {\n        fprintf(stderr, \"N ������ ���� ����� ������. ��������: %s\", lineN);\n        return data;\n    }\n\n    if (N < MIN_SIZE || N > MAX_SIZE) {\n        fprintf(stderr, \"N ������ ���� � ��������� [3;20]. ��������: %s\", lineN);\n        return usage;\n    }\n\n    // �������. � � � ��� �������� � ������ �� �����\n    struct Point points[MAX_SIZE];\n    for (int i = 0; i < N; ++i) {\n        points[i].x = cos(i * 2 * M_PI / N);\n        points[i].y = sin(i * 2 * M_PI / N);\n    }\n\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (i == j)\n                printf(\"%8.3f\", 0.0);\n            else\n                printf(\"%8.3f\", sqrt(pow(points[i].x - points[j].x, 2) + pow(points[i].y - points[j].y, 2)));\n        }\n        printf(\"\\n\");\n    }\n\n    return 0;\n}",
