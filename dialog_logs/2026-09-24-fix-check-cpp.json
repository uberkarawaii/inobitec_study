  win_handle(const win_handle&) = delete;\n50:     // ������ ������� win_handle a = b, ��� b - ���� win_handle\n51:     win_handle& operator=(const win_handle&) = delete;\n52: \n53:     // ������ HANDLE - �.�. ������ �����. ��� �� ������� CloseHandle � ���������� ������� � ������\n54:     HANDLE get() const { return h_; }\n55:     // �������������� ������ � 0/1 (explicit) - ������ � ���������� ���������, �� � ������� ���������������\n56:     explicit operator bool() const { return h_ != INVALID_HANDLE_VALUE && h_ != nullptr; }\n57: };\n58: \n59: // ��������� �������� � ��������� ������ �������� ������\n60: win_handle open_io_file(const char* path, DWORD desired_access, DWORD creation_disposition, std::string_view context) {\n61:     // ���������� ������������ ��� ��������, ������� �������/������� ������ ��������� (��� ������ in/out/err)\n62:     SECURITY_ATTRIBUTES sa{};\n63:     sa.nLength = sizeof(sa);           // ������ ������. � ������; ����� ������ ������ SECURITY_ATTRIBUTES\n64:     sa.bInheritHandle = true;          // ����� � ���� sa ����� ������������� �������� ���������\n65:     sa.lpSecurityDescriptor = nullptr; // ���������� ������������ - �� �������\n66: \n67:     // ����� �� ���������� ���� (��������� / ��������)\n68:     // FILE_SHARE_READ - ������� �������� ���� ����� ������� �� ������ ������ ����. ��� ��-run_case � ��-main ���������\n69:     HANDLE h =\n70:         CreateFileA(path, desired_access, FILE_SHARE_READ, &sa, creation_disposition, FILE_ATTRIBUTE_NORMAL, NULL);\n71: \n72:     // ��� ��������� �������� ������ - ������ ��������� � ������� ������\n73:     if (h == INVALID_HANDLE_VALUE) {\n74:         print_win_error(context, path);\n75:         return win_handle{}; // ������������ �� ��������� ������ INVALID_HANDLE_VALUE\n76:     }\n77:     // ������� ������� ����� prvalue - ��������� copy elision. ��� �����������\n78:     // ������ ����� � ������ ����� �� ������ �����\n79:     return win_handle{h};\n80: }\n81: \n82: // ������ quoting\n83: // ���� �������� -> �������� ��������� ������ Windows, ������� CRT ������\n84: // ������� ����� � ���� �������� (MS Learn \"Parsing C++ command-line arguments\").\n85: // ���������� \" -> \\\"; ��� \\ ����� ����� \" ��� ����� ������ �����������, �����\n86: // �� \"������\" ����������� �������.\n87: std::string quote_arg(std::string_view arg) {\n88:     std::string out;\n89:     // ������ ����������� � �������\n90:     out += '\"';\n91:     std::size_t backslashes = 0;\n92:     for (char c : arg) {\n93:         // �������������� ����. ���� ������� ��, �� ���� ������ ++�������. �.�. �����, ��� �����\n94:         if (c == '\\\\') {\n95:             ++backslashes;\n96:             // ���� ����� \\ �������, �������, �� ���������.\n97:             // ����� ��� \\ �����. � �2, �.�. ����� �������� ������ ������ �� ������� �� 2��\n98:             // ����� ��������� \\ �.�. ����� �������� ������ ���� ����\n99:         } else if (c == '\"') {\n100:             out.append(backslashes * 2 + 1, '\\\\');\n101:             out += '\"';\n102:             // ���� ������ ������ ��������� ������������\n103:             backslashes = 0;\n104:         } else {\n105:             // �� ����� �������� ������ �� ����� ���� �� ��� �����. ������� ��� ��������\n106:             out.append(backslashes, '\\\\');\n107:             out += c;\n108:             backslashes = 0;\n109:         }\n110:     }\n111:     // ����� ������. ����� ����� ����� �������-���������, ������� ��� ����� ��� ����� ����� ���\n112:     // �� ���� ����� ����������� �.�. ��� ����� ��������\n113:     out.append(backslashes * 2, '\\\\');\n114:     out += '\"';\n115:     return out;\n116: }\n117: \n118: #else\n119: // �����-������ ��� �������� �����������\n120: class posix_fd {\n121:     int fd_ = -1;\n122: \n123: public:\n124:     posix_fd(int fd = -1) : fd_(fd) {}\n125:     ~posix_fd() {\n126:         if (fd_ >= 0)\n127:             close(fd_);\n128:     }\n129:     posix_fd(const posix_fd&) = delete;\n130:     posix_fd& operator=(const posix_fd&) = delete;\n131:     int get() const { return fd_; }\n132:     explicit operator bool() const { return fd_ >= 0; }\n133: };\n134: \n135: // ��������� ������ ������\n136: void print_errno_error(std::string_view context, std::string_view target) {\n137:     // ��������� ������ POSIX ��� ������� ����� ���������� errno - ��� ������ � ������ ������\n138:     // ���������� errno � ��������� ����������, ����� ������� ���������, ����� �� �� ��� ����� �����������\n139:     int current_err = errno;\n140:     std::error_code ec(current_err, std::generic_category());\n141:     std::print(stderr, \"Can not {} {}: {} (code {})\\n\", context, target, ec.message(), current_err);\n142: }\n143: \n144: // ��������� ������ � �������� ������������ � ������� ��� ����� � posix_fd ��� �����\n145: posix_fd open_io_file(const char* path, int flags, int mode, std::string_view context) {\n146:     // flags - ����� ����, ��� ����� ������������ � ���� ������ - ������ / ������ / � �.�.\n147:     // mode - ����� �����\n148:     int fd = open(path, flags, mode);\n149: \n150:     if (fd == -1) {\n151:         print_errno_error(context, path);\n152:         return posix_fd{};\n153:     }\n154: \n155:     return posix_fd{fd};\n156: }\n157: // ��������� ���� \"������� �� �������\"\n158: constexpr int kExecFailed = 127;\n159: \n160: #endif\n161: \n162: // ������� �� ������� ��� ���.����� � ������ ���.\n163: // �������� �.�. ���. � � ������, � � ������� �����\n164: constexpr int kExeIndex = 6;\n165: constexpr int kFirstArgIndex = 7;\n166: \n167: // run_case <���������_���> <����_�����> <����_stdout> <����_stderr> -- <exe> [���...]\n168: int main(int argc, char* argv[]) {\n169:     if (argc < kFirstArgIndex) {\n170:         std::print(stderr,\n171:                    \"6 or more arg-s are needed: <expect_code> <file_input> <file_stdout> <file_stderr> -- <exe>. \"\n172:                    \"Received: {}\\n\",\n173:                    argc - 1);\n174:         return 1;\n175:     }\n176: \n177:     if (std::string(argv[5]) != \"--\") {\n178:         std::print(stderr, \"Separator \\\"--\\\" is needed on 5th position, but {} was received instead\\n\", argv[5]);\n179:         return 1;\n180:     }\n181: \n182:     int expected_code = 0;\n183: \n184:     try {\n185:         expected_code = std::stoi(argv[1]);\n186:     } catch (const std::invalid_argument&) {\n187:         std::print(stderr, \"Expected exit-code is integer. Received: {}\\n\", argv[1]);\n188:         return 1;\n189:     } catch (const std::out_of_range&) {\n190:         std::print(stderr, \"Expected exit-code is integer and received number({}) - is beyond int.\\n\", argv[1]);\n191:         return 1;\n192:     }\n193: \n194: // �������-����������� ����� ��� �������� ��������� �������� � ����������� ����������� � ��������� ����\n195: #ifdef _WIN32\n196:     // ���� ������� ����� ������ �������, ����� �����\n197:     // hProcess - ����� �� ������ ���� �������. ����� ��� �������� ����������, ������ ����\n198:     // hThread - ����� �� ������ ���� �����(������� ����� ��������). �� ������������, �� ����� ����� ������� ���\n199:     // ������ ����������� ����� �� �������� ������ � �����\n200:     PROCESS_INFORMATION pi{};\n201: \n202:     //  ���������� ���� ��� �������������� ����������� in/out/err ������\n203:     {\n204: \n205:         // ������ �� ����� �����, ������ � ������\n206:         win_handle in = open_io_file(argv[2], GENERIC_READ, OPEN_EXISTING, \"open input file\");\n207:         if (!in)\n208:             return 1;\n209: \n210:         win_handle out = open_io_file(argv[3], GENERIC_WRITE, CREATE_ALWAYS, \"create output file\");\n211:         if (!out)\n212:             return 1;\n213: \n214:         win_handle err = open_io_file(argv[4], GENERIC_WRITE, CREATE_ALWAYS, \"create error file\");\n215:         if (!err)\n216:             return 1;\n217: \n218:         // ��������� ��� �������� ��������\n219:         // hStdInput/hStdOutput/hStdError - ��� ������� ������ �� ��������/��������� ����� in/out/err\n220:         // ��������� ��� �������� �������� � ���� STARTUPINFOA. ����� ������ ������ ����� �������� ����, ��� � run_case\n221:         STARTUPINFOA si{};\n222:         si.cb = sizeof(si);                // ������ ��������� = ������ STARTUPINFOA\n223:         si.dwFlags = STARTF_USESTDHANDLES; // ������ �������������� ��� ������\n224:         si.hStdInput = in.get();\n225:         si.hStdOutput = out.get();\n226:         si.hStdError = err.get();\n227: \n228:         // ������ ���� \"main.exe\" arg1 arg2 ...; �������� ����� ������ quoting - ��� �� ����� ������� �� ��������� �\n229:         // �������\n230:         std::string cmdline = quote_arg(argv[kExeIndex]);\n231:         // argv + kFirstArgIndex - ��������� �� ������ ��������. argc - kFirstArgIndex - ���-�� ����������\n232:         // std::views::counted ���� ������������������ �� ����������, ���� ��� ����\n233:         for (const char* arg : std::views::counted(argv + kFirstArgIndex, argc - kFirstArgIndex)) {\n234:             cmdline += ' ';\n235:             cmdline += quote_arg(arg);\n236:         }\n237: \n238:         // ��� ����� �� CreateProcessW � CreateProcessA ������ ����� �� �������. � char* -> wchar_t\n239:         // �����: ��-ASCII ���� ������� �� ���������. �� � ���� ��� ��������� � �����\n240:         // argv[kExeIndex] - ��� ������������ �������� - ��������-��� ������������ �����\n241:         // cmdline.data() - ����������� ���� � ��� ��������� ��������� ������\n242:         // 3 � 4 NULL - ��� ����� ���������� ������������ ��� �������� � ������\n243:         // TRUE - ���� ������� ����� �����������. ��� ���������� ������� ���� in/out/err �� run_case\n244:         // NULL - ��������� �� ��������� - �� ���� �� ��������\n245:         // NULL - current working directory ��� � ��������\n246:         // startup info = si, process information = pi\n247:         if (!CreateProcessA(argv[kExeIndex], cmdline.data(), NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)) {\n248:             print_win_error(\"run\", argv[kExeIndex]);\n249:             return 1;\n250:         }\n251:     } // ����� ���������� �������� in/out/err ����� ����������� ��� run_case\n252: \n253:     win_handle hproc{pi.hProcess};\n254:     win_handle hthread{pi.hThread};\n255: \n256:     DWORD exit_code = 0;\n257:     // run_case ����������� � ���, ���� �� ���������� ������� pi.hProcess\n258:     // ��� ����������, �� ����� ���� �������� � ���� ��� ���� - ������ ������ � ����������\n259:     if (WaitForSingleObject(hproc.get(), INFINITE) != WAIT_OBJECT_0) {\n260:         print_win_error(\"reach the completion of\", argv[kExeIndex]);\n261:         return 1;\n262:     }\n263:     // GetExitCodeProcess - ����� ��� ���������� �������� pi.hProcess � �������� � exit_code\n264:     // ��������, ���� ����� �� ������� ����� ����� ��� ����������\n265:     if (!GetExitCodeProcess(hproc.get(), &exit_code)) {\n266:         print_win_error(\"get the execution code\", argv[kExeIndex]);\n267:         return 1;\n268:     }\n269: \n270:     // ��������� ������� ���� �������� � ����������\n271:     if (static_cast<int>(exit_code) != expected_code) {\n272:         std::print(stderr, \"expected code is {}; received code is {}\\n\", expected_code, exit_code);\n273:         return 1;\n274:     }\n275: \n276:     return 0;\n277: #else\n278:     // linux\n279:     // fork() ������� � pid ������������� �������� (���� ��� ���, � �������� -1)\n280:     // ����� ��� ���������� ��������: -1 - ��� ������� ��� fail; 0 - ��� ������� ������\n281:     // �������. ����� - ��� ������� ��������\n282:     pid_t pid = -1;\n283:     {\n284:         // �������� �������� ������������ � ��������, ����� ����� �������� �� ������\n285:         posix_fd in = open_io_file(argv[2], O_RDONLY | O_CLOEXEC, 0, \"open input file\");\n286:         if (!in)\n287:             return 1;\n288: \n289:         posix_fd out = open_io_file(argv[3], O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644, \"create output file\");\n290:         if (!out)\n291:             return 1;\n292: \n293:         posix_fd err = open_io_file(argv[4], O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644, \"create error file\");\n294:         if (!err)\n295:             return 1;\n296: \n297:         pid = fork(); // ����� ������������� �������� run_case\n298:         // �������� ���� �� ���������� ������� �������� ������� (pid=-1)\n299:         if (pid < 0) {\n300:             print_errno_error(\"create a child process to run\", argv[kExeIndex]);\n301:             return 1;\n302:         }\n303:         // ����� pid ����� � ������. � ���� ����� - ������ � �������� ������\n304:         if (pid == 0) {\n305:             // ������: ������������� 0/1/2 �� �����\n306:             if (dup2(in.get(), STDIN_FILENO) < 0 || dup2(out.get(), STDOUT_FILENO) < 0 ||\n307:                 dup2(err.get(), STDERR_FILENO) < 0) {\n308:                 int errno_copy = errno;\n309:                 std::print(stderr, \"Can not redirect streams: {}\\n\",\n310:                            std::error_code(errno_copy, std::generic_category()).message());\n311:                 _exit(kExecFailed);\n312:             }\n313:             // ������ ���� run_case �� ��� main (��� ��� ��������) � ������\n314:             // ���������������� ������ �������� ��� � ����\n315:             execv(argv[kExeIndex], &argv[kExeIndex]);\n316: \n317:             // ������� ������ execv\n318:             int errno_copy = errno;\n319:             std::print(stderr, \"Can not run {}: {}\\n\", argv[kExeIndex],\n320:                        std::error_code(errno_copy, std::generic_category()).message());\n321:             // ��������� ������� ������\n322:             _exit(kExecFailed);\n323: \n324:             // � �������� ������ - ��������� ���� � execv ���� � _exit; ������ �� ���� ����� �� ������\n325:             // � �� ������, �.�. ����� - ��� ��������\n326:         }\n327:     } // ��� 3�� fd run_case-� ����������� ������������� ������, �.�. ����� �� ����. ������