                "text": "#include \"string_utils.h\"\n\n#include <ctype.h>\n#include <errno.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n// ������ �������� �� �������� ������ �� \\0 ����� �������. ������\nchar* get_string(int* len) {\n    *len = 0;\n    int capacity = 1;\n    char *s = (char*)malloc(sizeof(char)), *temp = NULL;\n    int ch;\n    while ((ch = getchar()) != EOF && ch != '\\n') {\n        s[*len] = (char)ch;\n        ++(*len);\n\n        if (*len >= capacity) {\n            capacity *= 2;\n            temp = (char*)realloc(s, capacity * sizeof(char));\n            // �������� �� null �� realloc �� ������ deepseek\n            // + free �����, ����� �� �� ������ ��� �������� null � �� ���� ������\n            if (!temp) {\n                free(s);\n                *len = -1;\n                return NULL;\n            }\n            s = temp;\n        }\n    }\n    s[*len] = '\\0';\n    if (ch == EOF && *len == 0)\n        *len = -1;\n\n    return s;\n}\n\n// �������� �� �������\nint is_empty(const char* s) {\n    while (isspace((unsigned char)*s))\n        ++s;\n    return *s == '\\0';\n}\n\n// ���� �������� �� �����\nchar* trim_string(char* s, int* len) {\n    // ������� ��������� ��������\n    while (*len > 0 && isspace((unsigned char)*s)) {\n        ++s;\n        --(*len);\n    }\n    // ����� ������\n    while (*len > 0 && isspace((unsigned char)s[*len - 1])) {\n        --(*len);\n        s[*len] = '\\0';\n    }\n\n    return s;\n}\n\nint is_hex_prefix(const char* ptr) {\n    // ������� �������� ������, �.�. ���� ��������� �������. ����� isspace, \n    // �� ������ ����� ������. ��������. ����� ���������� � �++\n    while (isspace((unsigned char)*ptr))\n        ++ptr;\n    if (*ptr == '\\0')\n        return 0;\n    // ���� ������ ������� ���� 0x, �� ������� � ��� �����. ����� �������� �� 0x�����\n    int pad = 0;\n    // +/- ����� hex ������ - ���������\n    if (*ptr == '+' || *ptr == '-')\n        ++pad;\