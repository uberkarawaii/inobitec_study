            "output": "<path>C:\\Users\\User\\Desktop\\inobitec_stud\\common\\CMakeLists.txt</path>\n<type>file</type>\n<content>\n1: # === T1 СБОРКА СТАТИЧ. БИБЛИОТЕКИ ===\n2: # <name> - логическое имя цели\n3: # [<type>] - static\n4: # [EXCLUDE_FROM_ALL] - не установлено, деолтно false, то есть target включится в all\n5: # <sources> = geometry.c/cpp / string_utils.c/cpp; header-ы cmake должен подтянуть сам \n6: add_library(common_cpp_static STATIC geometry.cpp string_utils.cpp)\n7: add_library(common_c_static STATIC geometry.c string_utils.c)\n8: \n9: # target_compile_definitions - именно для директив препроцессора\n10: # здесь - для добавления флага COMMON_STATIC\n11: # PUBLIC сделает так, что COMMON_STATIC будет и при компиляции либы, и при компиляции тех, кто к ней линкуется\n12: # t1../main.. линкуется к ней - транзитивно получит флаг COMMON_STATIC  \n13: target_compile_definitions(common_cpp_static PUBLIC COMMON_STATIC)\n14: target_compile_definitions(common_c_static PUBLIC COMMON_STATIC)\n15: \n16: # libm.so для линукса. с ней линкуется библиотека и транзитивно - t1_c\n17: if(UNIX)\n18:   target_link_libraries(common_c_static PUBLIC m)\n19: endif()\n20: \n21: # из верхнего CMakeLists.txt - построит команду для сборки\n22: # т.к. common_..._static - static library -> из configure_target для неё произойдёт только cl, не link\n23: # и т.к. static, то ещё будет сделана сборка в lib-у (CMake видит тип таргета)  \n24: configure_target(common_cpp_static ON)\n25: configure_target(common_c_static ON)\n26: \n27: \n28: # === T2 СБОРКА СТАТИЧ. БИБЛИОТЕКИ\n29: add_library(string_utils_cpp_static STATIC string_utils.cpp)\n30: add_library(string_utils_c_static STATIC string_utils.c)\n31: \n32: target_compile_definitions(string_utils_cpp_static PUBLIC COMMON_STATIC) \n33: target_compile_definitions(string_utils_c_static PUBLIC COMMON_STATIC)\n34: \n35: configure_target(string_utils_cpp_static ON)\n36: configure_target(string_utils_c_static ON)\n37: \n38: \n39: # === T3-T4 С