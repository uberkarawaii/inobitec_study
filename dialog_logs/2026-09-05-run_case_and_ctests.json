R}\")\n43:   file(TO_NATIVE_PATH \"${ABSOLUTE_PATH_MAIN}\" NATIVE_PATH_MAIN)\n44: \n45:   # ��������� ����� � �������� main ��� ������ ������� �� run_case\n46:   if(NOT args) \n47:     string(JOIN \" \" PREFIX ${NATIVE_PATH_MAIN} < ${input})\n48:   else\n49:     string(JOIN \" \" PREFIX ${NATIVE_PATH_MAIN} ${args} < ${input}) \n50: \n51:   # �������� ������ ������� ��������� run_case\n52:   string(JOIN \" \" RUN_MAIN ${PREFIX} ${REDIRECTION})\n53: \n54:   # ���� �������� ������ �� ��� ������, �� check � �� �����\n55:   if(mode EQUAL 0)\n56:     add_test(${test_name} ${run_case} ${RUN_MAIN} ${expected_excode})\n57:   # ����������� �������� � ������ ������ � ��������� ��������� + ��������� ��������� \n58:   else()   \n59:     add_test(${test_name} ${run_case} ${RUN_MAIN} ${expected_excode} & ${NATIVE_PATH_CHECK} ${CHECK_MODE} ${test_name} ${expected_result})\n60:   endif()\n61: \n62: endfunction()\n63: \n64: \n65: \n66: \n67: \n68: \n\n(End of file - total 68 lines)\n</content>",
