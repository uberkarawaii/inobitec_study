                "text": "configure_target(run_case OFF)\nconfigure_target(check OFF)\n\n# test_name - ��� ������� �����\n# exe - ��������� ������� ����� �����������\n# args - ��������� ��������� ������ ��� exe\n# input - ������� ������ ��� exe\n# expected_excode - ��������� ��� ����������\n# mode - ��� check (--equal / --contains)\n# expected_result - ��������� ����� ��������� � stdout / stderr \nfunction(add_case test_name exe args input expected_excode mode expected_result)\n  # run_case ������ ���. ��� ������ ��� ��� ��������� � \n  # string(<glue> <output_variable> [<input>...])\n  # ���� ��� ���� ������ �� ��� ������\n  if(mode EQUAL 0) \n    # ��������� ������ ��� ������, ��������� ����� ���\n    if(NOT expected_result) \n      string(JOIN \" \" REDIRECTION > NULL 2> NULL)\n    # �������� ���� ����. ��������. � ���� ��������� �� ����� ����� \n    else \n      string(JOIN \" \" REDIRECTION > NULL 2> ${test_name})\n\n    endif()\n\n  # ���� ���� ������ ���. �������� ���� ����\n  else() \n    string(JOIN \" \" REDIRECTION > ${test_name} 2> NULL)\n\n    # ��������� ������ ��� check, ���� mode ��������� � �����-�� �������� �����\n    if(mode EQUAL 1)\n      set(CHECK_MODE --check)\n    elseif(mode EQUAL 2)\n      set(CHECK_MODE --equals)\n    endif()\n\n    # ���� �� ������������� check � ������ ������\n    get_filename_component(ABSOLUTE_PATH_CHECK \"${check}\" ABSOLUTE BASE_DIR \"${CMAKE_CURRENT_BINARY_DIR}\")\n    file(TO_NATIVE_PATH \"${ABSOLUTE_PATH_CHECK}\" NATIVE_PATH_CHECK)\n  endif()\n\n  # ���� �� ������������� main � ������ ������   - ��� �������� ������ ��CMAKE_CURRENT_SOURCE_DIR � ����� ������\n  get_filename_component(ABSOLUTE_PATH_MAIN \"${exe}\" ABSOLUTE BASE_DIR \"${CMAKE_CURRENT_BINARY_DIR}\")\n  file(TO_NATIVE_PATH \"${ABSOLUTE_PATH_MAIN}\" NATIVE_PATH_MAIN)\n\n  # ��������� ����� � �������� main ��� ������ ������� �� run_case\n  if(NOT args) \n    string(JOIN \" \" PREFIX ${NATIVE_PATH_MAIN} < ${input})\n  else\n    string(JOIN \" \" PREFIX ${NATIVE_PATH_MAIN} ${args} < ${input}) \n\n  # �������� ������ ������� ��������� run_case\n  string(JOIN \" \" RUN_MAIN ${PREFIX} ${REDIRECTION})\n\n  # ���� �������� ������ �� ��� ������, �� check � �� �����\n  if(mode EQUAL 0)\n    add_test(${test_name} ${run_case} ${RUN_MAIN} ${expected_excode})\n  # ����������� �������� � ������ ������ � ��������� ��������� + ��������� ��������� \n  else()   \n    add_test(${test_name} ${run_case} ${RUN_MAIN} ${expected_excode} & ${NATIVE_PATH_CHECK} ${CHECK_MODE} ${test_name} ${expected_result})\n  endif()\n\nendfunction()\n\n\n\n\n\n",
