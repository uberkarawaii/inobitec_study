И ===\n40: add_library(common_cpp_shared SHARED geometry.cpp string_utils.cpp)\n41: add_library(common_c_shared SHARED geometry.c string_utils.c)\n42: \n43: # тут PRIVATE, т.к. main t3-t4 не должны иметь этот флаг, чтобы у них внутри был dllimport\n44: target_compile_definitions(common_cpp_shared PRIVATE COMMON_EXPORTS)\n45: target_compile_definitions(common_c_shared PRIVATE COMMON_EXPORTS)\n46: \n47: if(UNIX)\n48:   target_link_libraries(common_c_shared PUBLIC m)\n49: endif()\n50: \n51: configure_target(common_cpp_shared ON)\n52: configure_target(common_c_shared ON)\n\n(End of file - total 52 lines)\n</content>",
