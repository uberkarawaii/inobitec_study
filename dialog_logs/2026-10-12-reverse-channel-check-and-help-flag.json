.cmake - ���� ����㯭� gtest_add_tests � gtest_discover_tests (��� 楫��, ������������� � GTest)\\ninclude(GoogleTest)\\n\\n# �����쪠� ��⮢�� �ணࠬ��\\nadd_executable(gtest_smoke gtest_smoke.cpp)\\n# ���䨣������� ��� ��⮢�� ���離�, �� �த�� ��� ���஢����\\nconfigure_target(gtest_smoke OFF)\\n# GTest::gtest_main ������ �� �⠯� find_package, ��� � ��. ������஢���� 楫� \\n# (�� ��� � headers / .lib) \\ntarget_link_libraries(gtest_smoke PRIVATE GTest::gtest_main)\\nadd_test(NAME gtest_smoke COMMAND gtest_smoke)\\n\\n# �-�� ��� ����஢���� ��������. dll �㪠��, �.�. vcpkg applocal �⪫��� �� ��������� ���䫨�⮢ �� -j\\nfunction(deploy_vcpkg_dlls target)\\n# ��᫥ �������� 楫�, ��६����� � ��� � dll �� ������ ��� ������ � �.�. �࠭��⨢��,\\n# �᫨ �� ��� � ����� � 楫� ��� �᫨ ��� ����������\\n# COMMAND_EXPAND_LISTS - ࠧ������ dll �� ������� �१ ; � �⤥��� ��㬥���\\n# ⠪�� �஡���� ⮫쪮 �� �����, ��� ����ᮬ ⠪��� �� ���������\\nif(WIN32)\\n  add_custom_command(TARGET ${target} POST_BUILD\\n    COMMAND ${CMAKE_COMMAND} -E copy_if_different\\n            $<TARGET_RUNTIME_DLLS:${target}>\\n            $<TARGET_FILE_DIR:${target}>\\n    COMMAND_EXPAND_LISTS)\\nendif()\\nendfunction()\\n\\n# ��� smoke-楫� - gtest-dll-�� �१ ᢮� �-��, �� vcpkg applocal-��\\ndeploy_vcpkg_dlls(gtest_smoke)\\n\\n# �-����\\nadd_subdirectory(unit)\\n\\nfile(MAKE_DIRECTORY \\\"${CMAKE_CURRENT_BINARY_DIR}/results\\\")\\n\\n# test_name - ��� �ࣥ� ���\\n# exe - �ணࠬ�� ����� �㤥� �஢�������\\n# args - ��㬥��� ��������� ��ப� ��� exe\\n# input - �室�� ����� ��� exe\\n# expected_excode - �������� ��� �����襭��\\n# check_flag - ��� check (--equal / --contains)\\n# expected_result - �������� �뢮� �ணࠬ��\\n# stream - ��⮪, �뢮� ���ண� �㤥� �ࠢ�������� � expected_result\\nfunction(add_case test_name exe args input expected_excode check_flag expected_result stream)\\n\\n# �� �⨬ ��㬥�⠬ �㤥� ࠧ�����, ⠪ �� �஢�ઠ �ࠧ�. �᫨ �� ������ ��� �� ��ࢮ�� ���\\n# ࠧ��ᥭ� �� ��� if �.�. �� ������ᨬ� �஢�ન\\n# �� mode=FATAL_ERROR ��⠭���� ��ࠡ�⪨ � �����樨. ������� CMake c ���㫥�� �����\\n\\nif(NOT \\\"${check_flag}\\\" STREQUAL \\\"CONTAINS\\\" AND NOT \\\"${check_flag}\\\" STREQUAL \\\"EQ\\\")\\n  message(FATAL_ERROR \\\"unknown flag for check. expected CONTAINS for containing and EQ for equality\\\")\\nendif()\\n\\nif(NOT ${stream} EQUAL 1 AND NOT ${stream} EQUAL 2)\\n  message(FATAL_ERROR \\\"unknown stream type. expected 1 for stdout and 2 for stderr\\\" )\\nendif()\\n\\n# ��� ��� �� ���: test_name + _code\\nset(CODE_TEST \\\"${test_name}_code\\\")\\n# ��� 䠩�� stdout\\nset(STDOUT_FILE \\\"${CMAKE_CURRENT_BINARY_DIR}/results/${test_name}.out\\\")\\n# ��� 䠩�� stderr\\nset(STDERR_FILE \\\"${CMAKE_CURRENT_BINARY_DIR}/results/${test_name}.err\\\")\\n\\n# �室��� ������� �.�. ��� 䠩���, ��� ������ (��� ��� �� IO fail)\\n# ��� �⭮��. ��⥩ ��⠥���, �� �� 䠩� � �� � /input_data; ��᮫��� ������� ��� ����\\nif(IS_ABSOLUTE \\\"${input}\\\")\\n  set(INPUT_PATH \\\"${input}\\\")\\nelse()\\n  set(INPUT_PATH \\\"${CMAKE_CURRENT_SOURCE_DIR}/input_data/${input}\\\")\\nendif()\\n\\n# ��������� ���祭��. ��᮫��� ���� ���� ��� ����, ���� - 䠩� �� tests/expect/\\n# ᤥ���� ��� ��� ���ᨮ��஢���� (⠬ �������� �������� � build, �� ����� � tests/expect/)\\nif(IS_ABSOLUTE \\\"${expected_result}\\\")\\n  set(EXPECTED_PATH \\\"${expected_result}\\\")\\nelse()\\n  set(EXPECTED_PATH \\\"${CMAKE_CURRENT_SOURCE_DIR}/expect/${expected_result}\\\")\\nendif() \\n\\n# ���_1 �� ��� �ᥣ�� ����᫮��� � �������� �� ᨣ�����\\nadd_test(NAME ${CODE_TEST} COMMAND $<TARGET_FILE:run_case> ${expected_excode}\\n ${INPUT_PATH}\\n ${STDOUT_FILE}\\n ${STDERR_FILE}\\n --\\n $<TARGET_FILE:${exe}>\\n ${args})\\n# args ��� ����祪 �⮡� �� �������� �� ����� � �� \\\"��譨�\\\" ��㬥���\\n\\n# ��⭮��� ����� ��室���� 䠩�� � ��� � ����ᨬ�� �� ��⮪� stdout(1)/stderr(2) \\nif(${stream} EQUAL 1)\\n  set(PROGRAMM_RESULT ${STDOUT_FILE})\\n  set(RESULT_TEST \\\"${test_name}_stdout\\\")\\nelseif(${stream} EQUAL 2)\\n  set(PROGRAMM_RESULT ${STDERR_FILE})\\n  set(RESULT_TEST \\\"${test_name}_stderr\\\")\\nendif()\\n\\n# ��⠭���� 䫠�� ��� check - ᮢ������� / ᮤ�ঠ��