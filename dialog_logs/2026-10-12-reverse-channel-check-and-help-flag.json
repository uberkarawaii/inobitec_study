� � �������\r\n     while (1) {\r\n         s = get_string(&len);\r\n         ++i;\r\n \r\n         // ����� ����� ��������� �������� �� �������� � IO ��� ����� ����. ������\r\n         if (len == -1) {\r\n             free(s);\r\n             s = NULL;\r\n \r\n             if (ferror(stdin)) {\r\n                 fprintf(stderr, \"������ %d - ���� �����-������\\n\", i);\r\n                 return io_fail;\r\n             }\r\n             // ���� len == -1 ��� ������� � ������� ������, �� ��� ��������� EOF\r\n             else\r\n                 break;\r\n         }\r\n \r\n         // �������� �� �������; ���� �����, ����������\r\n         if (is_empty(s)) {\r\n             free(s);\r\n             s = NULL;\r\n             continue;\r\n         }\r\n \r\n         // ������������ ����� � ������ ����� parse_point\r\n         struct Point p;\r\n         int ex_code = parse_point(s, &p);\r\n \r\n         if (ex_code != 0) {\r\n             // ���� ���� ����������\r\n             if (ex_code == NUMBER_TOO_FEW)\r\n                 fprintf(stderr, \"������ %d - ������������ ���������. ��������� X Y Z, ��������: %s\\n\", i, s);\r\n \r\n             // ���� �������� ����������\r\n             else if (ex_code == NUMBER_NOT_NUMBER)\r\n                 fprintf(stderr, \"������ %d. ���������� ������: %s\\n\", i, s);\r\n \r\n             // ������� ����� ����������\r\n             else if (ex_code == NUMBER_TOO_MUCH)\r\n                 fprintf(stderr, \"������ %d - ������� ����� ���������. ��������� X Y Z, ��������: %s\\n\", i, s);\r\n \r\n             // ���� �� ��������� ��� inf ��� Nan\r\n             else if (ex_code == NUMBER_NOT_FINITE)\r\n                 fprintf(stderr, \"������ %d. ����� X Y Z ���������� �� �������� ����������: %s\\n\", i, s);\r\n \r\n             // � ����� ���� ����� ��������� �� �������� �����������\r\n             else if (ex_code == NUMBER_OUT_OF_RANGE)\r\n                 fprintf(stderr, \"������ %d. ����� X Y Z ���������� ����������, ��������� �� ���������� ��������: %s\\n\",\r\n                         i, s);\r\n \r\n             free(s);\r\n             s = NULL;\r\n             return data;\r\n         }\r\n \r\n         // ���� ����� ����, �� ��� �������� �� parse_points == 0 - ������������� ������\r\n         // ���������� ����� � ������\r\n         (*points)[*points_size] = p;\r\n         (*points_size)++;\r\n \r\n         //\r\n         if (*points_size >= *points_capacity) {\r\n             *points_capacity *= 2;\r\n             struct Point* tmp = realloc(*points, *points_capacity * sizeof(*tmp));\r\n             if (!tmp) {\r\n                 fprintf(stderr, \"������ ��� ��������� ������\\n\");\r\n                 free(s);\r\n                 free(*points);\r\n                 exit(io_fail);\r\n             }\r\n             *points = tmp;\r\n         }\r\n \r\n         // ���������� s �.�. � �� ��������� ����� ������\r\n         free(s);\r\n         s = NULL;\r\n     }\r\n \r\n     if (*points_size == 0) {\r\n         fprintf(stderr, \"����� �����������\\n\");\r\n         free(s);\r\n         return no_input;\r\n     }\r\n \r\n     return 0;\r\n }\r\n \r\n int main(int argc, char* argv[]) {\r\n     // ���� ������ �������� --version - ����� ������ � ���������\r\n     if (handle_version_flag(argc, argv))\r\n         return 0;\r\n     // ���� ������ ���. --help/-h - ������� ������� � ���������\r\n     if (handle_help_flag(argc, argv, HELP_TEXT))\r\n         return 0;\r\n \r\n     // �������� ������� - ���-�� ���������� � ��� ������ (����� ��, ������� ��, ������������� ��)\r\n     if (argc != 2) {\r\n         if (argc < 2)\r\n             fprintf(stderr, \"�������� ������; ��� �������� �� ���� �������\\n\");\r\n         else\r\n             fprintf(stderr, \"�������� ������; ���� ������� ������ ���������\\n\");\r\n         print_help_hint();\r\n         return usage;\r\n     }\r\n \r\n     double r = 0;\r\n     const int r_code = parse_radius(argv[1], &r);\r\n     // ���� �������� � ��������, �� ��� �������� ������ - ���������� ������, ���� �� help � ����� � ����� usage\r\n-    if (r_code){\r\n-    if (r_code == NUMBER_EMPTY) {\r\n-        fprintf(stderr, \"�������� ������; �������� ������ ��� ��������\\n\");\r\n-    }\r\n+    if (r_code) {\r\n+        if (r_code == NUMBER_EMPTY) {\r\n+            fprintf(stderr, \"�������� ������; �������� ������ ��� ��������\\n\");\r\n+        }\r\n \r\n-    else if (r_code == NUMBER_NOT_NUMBER) {\r\n-        fprintf(stderr, \"������ ������ ���� ������. ��������: %s\\n\", argv[1]);\r\n-    }\r\n+        else if (r_code == NUMBER_NOT_NUMBER) {\r\n+            fprintf(stderr, \"������ ������ ���� ������. ��������: %s\\n\", argv[1]);\r\n+        }\r\n \r\n-    else if (r_code == NUMBER_OUT_OF_RANGE) {\r\n-        fprintf(stderr, \"������ ������� �� ���������� ��������: %s\\n\", argv[1]);\r\n-    }\r\n+        else if (r_code == NUMBER_OUT_OF_RANGE) {\r\n+            fprintf(stderr, \"������ ������� �� ���������� ��������: %s\\n\", argv[1]);\r\n+        }\r\n \r\n-    else if (r_code == NUMBER_NOT_FINITE) {\r\n-        fprintf(stderr, \"������ ������ ���� �������� ������. ��������: %s\\n\", argv[1]);\r\n-    }\r\n+        else if (r_code == NUMBER_NOT_FINITE) {\r\n+            fprintf(stderr, \"������ ������ ���� �������� ������. ��������: %s\\n\", argv[1]);\r\n+        }\r\n \r\n-    else if (r_code == NUMBER_NOT_POSITIVE) {\r\n-        fprintf(stderr, \"������ ������ ���� �������������. ��������: %s\\n\", argv[1]);\r\n-    }\r\n+        else if (r_code == NUMBER_NOT_POSITIVE) {\r\n+            fprintf(stderr, \"������ ������ ���� �������������. ��������: %s\\n\", argv[1]);\r\n+        }\r\n         print_help_hint();\r\n         return usage;\r\n     }\r\n \r\n     // ������ ����� � �������� ��������� ������\r\n     int points_size = 0, points_capacity = 1;\r\n     struct Point* points = malloc(sizeof(struct Point));\r\n     if (!points) {\r\n         fprintf(stderr, \"�� ������� �������� ������\\n\");\r\n         return io_fail;\r\n     }\r\n \r\n     // ����� ���������. �-���\r\n     // ���� ��� �����. != 0, ��� ��� ���-�� ����������, � ����� ������� ���� �� ���\r\n     int status = get_points(&points, &points_size, &points_capacity);\r\n     if (status != 0) {\r\n         free(points);\r\n         return status;\r\n     } else\r\n         // ����� �����, � ������� �����. �� ������ < r\r\n         for (int i = 0; i < points_size; ++i) {\r\n             if (point_distance(points[i], (struct Point){0, 0, 0}) < r)\r\n                 printf(\"%.3f %.3f %.3f\\n\", points[i].x, points[i].y, points[i].z);\r\n         }\r\n \r\n     free(points);\r\n \r\n     return 0;\r\n }\n\\ No newline at end of file\n",
