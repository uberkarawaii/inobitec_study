��: test_name + _code\\n76: set(CODE_TEST \\\"${test_name}_code\\\")\\n77: # ��� 䠩�� stdout\\n78: set(STDOUT_FILE \\\"${CMAKE_CURRENT_BINARY_DIR}/results/${test_name}.out\\\")\\n79: # ��� 䠩�� stderr\\n80: set(STDERR_FILE \\\"${CMAKE_CURRENT_BINARY_DIR}/results/${test_name}.err\\\")\\n81: \\n82: # �室��� ������� �.�. ��� 䠩���, ��� ������ (��� ��� �� IO fail)\\n83: # ��� �⭮��. ��⥩ ��⠥���, �� �� 䠩� � �� � /input_data; ��᮫��� ������� ��� ����\\n84: if(IS_ABSOLUTE \\\"${input}\\\")\\n85:   set(INPUT_PATH \\\"${input}\\\")\\n86: else()\\n87:   set(INPUT_PATH \\\"${CMAKE_CURRENT_SOURCE_DIR}/input_data/${input}\\\")\\n88: endif()\\n89: \\n90: # ��������� ���祭��. ��᮫��� ���� ���� ��� ����, ���� - 䠩� �� tests/expect/\\n91: # ᤥ���� ��� ��� ���ᨮ��஢���� (⠬ �������� �������� � build, �� ����� � tests/expect/)\\n92: if(IS_ABSOLUTE \\\"${expected_result}\\\")\\n93:   set(EXPECTED_PATH \\\"${expected_result}\\\")\\n94: else()\\n95:   set(EXPECTED_PATH \\\"${CMAKE_CURRENT_SOURCE_DIR}/expect/${expected_result}\\\")\\n96: endif() \\n97: \\n98: # ���_1 �� ��� �ᥣ�� ����᫮��� � �������� �� ᨣ�����\\n99: add_test(NAME ${CODE_TEST} COMMAND $<TARGET_FILE:run_case> ${expected_excode}\\n100:  ${INPUT_PATH}\\n101:  ${STDOUT_FILE}\\n102:  ${STDERR_FILE}\\n103:  --\\n104:  $<TARGET_FILE:${exe}>\\n105:  ${args})\\n106: # args ��� ����祪 �⮡� �� �������� �� ����� � �� \\\"��譨�\\\" ��㬥���\\n107: \\n108: # ��⭮��� ����� ��室���� 䠩�� � ��� � ����ᨬ�� �� ��⮪� stdout(1)/stderr(2) \\n109: if(${stream} EQUAL 1)\\n110:   set(PROGRAMM_RESULT ${STDOUT_FILE})\\n111:   set(RESULT_TEST \\\"${test_name}_stdout\\\")\\n112: elseif(${stream} EQUAL 2)\\n113:   set(PROGRAMM_RESULT ${STDERR_FILE})\\n114:   set(RESULT_TEST \\\"${test_name}_stderr\\\")\\n115: endif()\\n116: \\n117: # ��⠭���� 䫠�� ��� check - ᮢ������� / ᮤ�ঠ���. ������ �� check_flag\\n118: if(\\\"${check_flag}\\\" STREQUAL \\\"CONTAINS\\\")\\n119:   set(CHECK_FLAG --contains)\\n120: elseif(\\\"${check_flag}\\\" STREQUAL \\\"EQ\\\")\\n121:   set(CHECK_FLAG --equal)