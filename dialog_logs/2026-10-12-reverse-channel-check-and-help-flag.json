              "patch": "Index: t4_filter_cpp/main.cpp\n===================================================================\n--- t4_filter_cpp/main.cpp\t\n+++ t4_filter_cpp/main.cpp\t\n@@ -1,145 +1,145 @@\n #include <cctype>\r\n #include <cmath>\r\n #include <expected>\r\n #include <iostream>\r\n #include <print>\r\n #include <ranges>\r\n #include <string>\r\n #include <string_view>\r\n #include <vector>\r\n \r\n+#include \"../common/cli.hpp\"\r\n #include \"../common/exit_codes.hpp\"\r\n #include \"../common/geometry.hpp\"\r\n #include \"../common/parse_codes.hpp\"\r\n #include \"../common/string_utils.hpp\"\r\n-#include \"../common/cli.hpp\"\r\n \r\n constexpr std::string_view kHelpText = R\"(t4_filter: ������ ����� �� �������\r\n �������������: <R> [--help] [--version]\r\n R � ������: ������������, R > 0.\r\n ���� (stdin): ����� \"x y z\" (�� ����� � ������) �� EOF.\r\n ������� � stdout ������ �����, ���������� �� ������ ��������� �� ������� ������ R.\r\n ���� ��������: 0 � �����; 64 � �������� ���������; 65 � ������������ ������; 66 � ��� ������� ������; 74 � ���� �����-������.)\";\r\n \r\n // ����� ������ � �������; ��� ������ �������� ��������� � ���������� ��� ���\r\n std::expected<std::vector<Point>, int> get_points() {\r\n     std::vector<Point> points;\r\n     // ������ ��� ����������\r\n     std::string temp;\r\n     // ������� �����\r\n     int i = 0;\r\n \r\n     while (std::getline(std::cin, temp)) {\r\n         ++i;\r\n \r\n         // ������� ������ �����\r\n         if (is_empty(temp))\r\n             continue;\r\n \r\n         // ������������� ����� � �������� �� ��, ��� ��� ��������, � ��� �� ����������� ���-��\r\n         // ���� ���� ���������� �������� 1, ���� ���������� ������ - 2\r\n         auto result = parse_point(temp);\r\n         if (!result) {\r\n             // ���� ����������\r\n             if (result.error() == number_error::too_few)\r\n                 std::cerr << \"������ \" << i << \" - ������������ ���������. ��������� X Y Z, ��������: \" << temp << \"\\n\";\r\n \r\n             // ���������� ������\r\n             else if (result.error() == number_error::not_number)\r\n                 std::cerr << \"������ \" << i << \". ���������� ������: \" << temp << \"\\n\";\r\n \r\n             // ������� ����� ���������\r\n             else if (result.error() == number_error::too_much)\r\n                 std::cerr << \"������ \" << i << \" - ������� ����� ���������. ��������� X Y Z, ��������: \" << temp\r\n                           << \"\\n\";\r\n \r\n             // ���� �� ��������� - �� �������� �����\r\n             else if (result.error() == number_error::not_finite)\r\n                 std::cerr << \"������ \" << i << \". ����� X Y Z ���������� �� �������� ����������: \" << temp << \"\\n\";\r\n \r\n             // � ����� ���� ����� ��������� �� �������� �����������\r\n             else if (result.error() == number_error::out_of_range)\r\n                 std::cerr << \"������ \" << i\r\n                           << \". ����� X Y Z ���������� ����������, ��������� �� ���������� ��������: \" << temp << \"\\n\";\r\n \r\n             return std::unexpected(exit_code::data);\r\n         }\r\n \r\n         // ���� ����� ����, �� ex_code == 0 ����� �������� ����� � ������\r\n         points.push_back(*result);\r\n     }\r\n \r\n     // error IO �������� ����� while. i+1 �.�. � ���� ��� ������ �� �����\r\n     if (std::cin.bad()) {\r\n         std::cerr << \"������ \" << i + 1 << \" - ���� �����-������\\n\";\r\n         return std::unexpected(exit_code::io_fail);\r\n     }\r\n \r\n     if (points.empty()) {\r\n         std::cerr << \"����� �����������\\n\";\r\n         return std::unexpected(exit_code::no_in);\r\n     }\r\n \r\n     return points;\r\n }\r\n \r\n int main(int argc, char* argv[]) {\r\n     // ���� ������ �������� --version - ����� ������ � ���������\r\n     if (handle_version_flag(argc, argv))\r\n         return 0;\r\n     // ���� ������ ���. --help/-h - ������� ������� � ���������\r\n     if (handle_help_flag(argc, argv, kHelpText))\r\n         return 0;\r\n \r\n     // ����. �������������, ����� EOF � io-fail ������ ����������� ��-�� ������ ����� fgetc\r\n     std::ios::sync_with_stdio(false);\r\n \r\n     // �������� ����� �������; ��� ������ ���������� ���� 0, ���� ������ ��� 1\r\n     if (argc != 2) {\r\n         if (argc < 2)\r\n             std::cerr << \"�������� ������; ��� �������� �� ���� �������\\n\";\r\n         else\r\n             std::cerr << \"�������� ������; ���� ������� ������ ���������\\n\";\r\n         print_help_hint();\r\n         return exit_code::usage;\r\n     }\r\n \r\n     std::string_view r_line{argv[1]};\r\n \r\n     // ������������� ����� � ��������, ��� ��� �����\r\n     auto parsedR = parse_radius(r_line);\r\n     if (!parsedR) {\r\n         if (parsedR.error() == number_error::not_number)\r\n             std::cerr << \"������ ������ ���� ������. ��������: \" << r_line << \"\\n\";\r\n         else if (parsedR.error() == number_error::not_finite)\r\n             std::cerr << \"������ ������ ���� �������� ������. ��������: \" << r_line << \"\\n\";\r\n         else if (parsedR.error() == number_error::not_positive)\r\n             std::cerr << \"������ ������ ���� �������������. ��������: \" << r_line << \"\\n\";\r\n         else if (parsedR.error() == number_error::out_of_range)\r\n             std::cerr << \"������ ������� �� ���������� ��������: \" << r_line << \"\\n\";\r\n         else if (parsedR.error() == number_error::empty)\r\n             std::cerr << \"�������� ������; �������� ������ ��� ��������\\n\";\r\n         print_help_hint();\r\n         return exit_code::usage;\r\n     }\r\n     double R = *parsedR;\r\n \r\n     // ��������� ��������� ������� �����\r\n     auto result = get_points();\r\n \r\n     // ��������� ������ - get_points ��� ��������� ��� � ������ ������ ��� ������\r\n     if (!result)\r\n         return result.error();\r\n \r\n     // ���� ��� ������, ����� ������ ���������� � *result\r\n     // ��� ���������\r\n     auto is_point_suitable = [R](const Point& p) { return point_distance(p, {0, 0, 0}) < R; };\r\n     // ��� ������\r\n     auto show_format = [](const Point& p) { return std::format(\"{:.3f} {:.3f} {:.3f}\\n\", p.x, p.y, p.z); };\r\n     // ����� ������� � result ������������ �� ��� �������� �� �������, � ���� ��������������� ������\r\n     auto suitable_points = *result | std::views::filter(is_point_suitable) | std::views::transform(show_format);\r\n     for (const auto& pt : suitable_points)\r\n         std::print(\"{}\", pt);\r\n \r\n     return 0;\r\n }\n\\ No newline at end of file\n",
