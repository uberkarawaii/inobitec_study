                "text": "#include <iostream>\n#include <print>\n#include <string>\n#include <vector>\n\n#include \"../common/exit_codes.hpp\"\n#include \"../common/geometry.hpp\"\n#include \"../common/parse_codes.hpp\"\n#include \"../common/string_utils.hpp\"\n\nint main(int argc, char* argv[]) {\n    // ���� ������ �������� --version - ����� ������ � ���������\n    if (handle_version_flag(argc, argv))\n        return 0;\n\n    // ��������� N\n    std::string lineN;\n    // ���������� ������, �������� �� �������\n    if (!std::getline(std::cin, lineN)) {\n        std::cerr << \"������� ������ ���� ������ ������ N\\n\";\n        return exit_code::no_in;\n    }\n\n    // ������������� N � �������� �� ������ �������������\n    auto parsed = parse_int32(lineN);\n    if (!parsed) {\n        if (parsed.error() == number_error::out_of_range) {\n            std::cerr << \"N �� ���������� � 32-������ �����. ��������: \" << lineN << '\\n';\n            return exit_code::data;\n        } else if (parsed.error() == number_error::empty) {\n            std::cerr << \"������� ������ ���� ������ ������ N\\n\";\n            return exit_code::no_in;\n        }\n        // ��� ����� ������ ������ (�������� ��� ������ ������, �� ��� ���������, ����� ����� �� ����� ������)\n        std::cerr << \"N ������ ���� ����� ������. ��������: \" << lineN << '\\n';\n        return exit_code::data;\n    }\n\n    // ���������� �����\n    const int N = *parsed;\n\n    // ��������� ��������\n    if (N < 3 || N > 20) {\n        std::cerr << \"N ������ ���� � ��������� [3;20]. ��������: \" << lineN << '\\n';\n        return exit_code::usage;\n    }\n\n    std::vector<Point> points(N);\n    for (int i = 0; i < N; ++i) {\n        points[i] = polygon_vertex(i, N);\n    }\n\n    for (int i = 0; i < N; ++i) {\n        for (int j = 0; j < N; ++j) {\n            if (i == j)\n                std::print(\"{:8.3f}\", 0.0);\n            else\n                std::print(\"{:8.3f}\", point_distance(points[i], points[j]));\n        }\n        std::print(\"\\n\");\n    }\n    return 0;\n}",
