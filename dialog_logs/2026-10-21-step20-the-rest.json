            "output": "<path>C:\\Users\\User\\Desktop\\inobitec_stud\\CMakeLists.txt</path>\n<type>file</type>\n<content>\n150: set(CMAKE_C_STANDARD_REQUIRED ON)\n151: # только стандартный компилятор языка, без расширений, типа gnu-расширений\n152: set(CMAKE_C_EXTENSIONS OFF)\n153: # то же для с++\n154: set(CMAKE_CXX_STANDARD 23)\n155: set(CMAKE_CXX_STANDARD_REQUIRED ON)\n156: set(CMAKE_CXX_EXTENSIONS OFF)\n157:                                \n158: # === ТИП СБОРКИ ===\n159: # определение debug / release; делается через -DCMAKE_BUILD_TYPE=...\n160: # Debug будет поставлен, если ничего не передали через флаг\n161: if(NOT CMAKE_BUILD_TYPE)\n162:   set(CMAKE_BUILD_TYPE Debug CACHE STRING \"Build type (Debug/Release)\" FORCE)\n163: endif()\n164: # переменная CMAKE_BUILD_TYPE уйдёт в кэш \n165: # кэш: для CMake, хранить инф. м-у выполнениями, и пользователь не повторяет ввод каждый раз\n166: # FORCE вызовет перезапись параметра\n167: \n168: \n169: # === ИСПРАВЛЕНИЕ DEFAULT-ФЛАГОВ ===\n170: # CMAke дефолтно положит /RTC1 в debug-ветку. /RTC1 ловит ошибки в runtime, для этого лезет в стек и размечает его\n171: # ASan - та же ф-ция. если оба будут менять стек, они помешают друг другу -> несовместимы. /RTC1 убирается \n172: # /incremental также несовместим с asan (именно по документации. так работало и когда оба вместе)\n173: if(MSVC)\n174:   string(REPLACE \"/RTC1\" \"\" CMAKE_C_FLAGS_DEBUG   \"${CMAKE_C_FLAGS_DEBUG}\")\n175:   string(REPLACE \"/RTC1\" \"\" CMAKE_CXX_FLAGS_DEBUG \"${CMAKE_CXX_FLAGS_DEBUG}\")\n176:   string(REPLACE \"/INCREMENTAL\" \"\" CMAKE_EXE_LINKER_FLAGS_DEBUG  \"${CMAKE_EXE_LINKER_FLAGS_DEBUG}\")\n177: endif()\n178: \n179: \n180: # === ПОСТРОИТЬ КОМАНДЫ КОМПИЛЯЦИИ И ЛИНКА ===\n181: function(configure_target trgt DBG)\n182: if(MSVC)\n183:   # минимальная поддерживаемая ОС - win7 (и все дальнейшие)\n184:   target_compile_definitions(${trgt} PRIVATE _WIN32_WINNT=0x0601)\n185:   # в msvc /Zi, /EHsc, /DEBUG  будут дублироваться, но прописываются для ясности\n186:   # target_compile_options - произвольные флаги компилятора \n187:   # PRIVATE даёт нетранзитивность: А (этот объект) и Б к нему сможет линковаться. а когда К линк. к Б, то К не будет линк. к А\n188:   target_compile_options(${trgt} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:/EHsc> /W4 /permissive-)\n189: \n190:   # сюда будет заходить только для программ из задач, не для программ для тестирования (run_case, check) - им эти флаги не нужны\n191:   if(DBG)\n192:     # CMake проставит след. флаги автоматиечки: /Od /O2; /MDd /MD; /DNDEBUG\n193:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Debug>:/Zi /fsanitize=address> $<$<CONFIG:Release>:/Zi>)\n194:     target_link_options(${trgt} PRIVATE $<$<CONFIG:Debug>:/DEBUG> $<$<CONFIG:Release>:/DEBUG /OPT:REF /OPT:ICF>)\n195:   endif()\n196: \n197: else()\n198:   target_compile_options(${trgt} PRIVATE -Wall -Wextra)\n199:   # и в ветке продуктов, и в ветке тестовых программ оптимизация на релизе будет именно -O2, а не cmake-default -O3\n200:   if (DBG) \n201:     # -O0 на дебаге будет подтянут CMake автоматически, а на релизе -DNDEBUG\n202:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Debug>: -g -fsanitize=address> $<$<CONFIG:Release>: -g -O2>)\n203:     target_link_options(${trgt} PRIVATE $<$<CONFIG:Debug>: -fsanitize=address>)\n204:   else()\n205:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Release>: -O2>)\n206:   endif()\n207: endif()\n208: endfunction()\n209: \n210: \n211: # === Ф-ЦИЯ ДОБАВЛЕНИЯ ЗАДАЧИ === \n212: # сборки exe из main.c/main.cpp; уходит в каталог build/cfg/dir\n213: function(add_task dir trgt src lib)\n214:   # добавление исполняемного файла \n215:   # цель и её исходник. цель имеет одно имя (логическое, типа t1_c), а сделанный ею файл - другое (OUTPUT_NAME main)\n216:   add_executable(${trgt} ${src})\n217: \n218:   # в CMAKE_BINARY_DIR будет тот каталог, который был передан по -B\n219:   set_target_properties(${trgt} PROPERTIES\n220:   OUTPUT_NAME main\n221:   RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/${dir})\n222: \n223:   # с кем линкуемся\n224:   # тут private не имеет смысла (.exe конечен, к нему не линкуются), просто для единообразия\n225:   target_link_libraries(${trgt} PRIVATE ${lib})\n226: \n227:   # определение типа библиотеки т.к. на windows для .dll нужно доп. действие для связки с .exe\n228:   get_target_property(lib_type ${lib} TYPE)\n229:   # копирование dll в папку к exe даже если сам exe не перестраивался\n230:   if(WIN32 AND lib_type STREQUAL \"SHARED_LIBRARY\")\n231:     set(copied_dll \"${CMAKE_BINARY_DIR}/${dir}/${lib}.dll\")\n232:     add_custom_command(OUTPUT \"${copied_dll}\"\n233:       COMMAND ${CMAKE_COMMAND} -E copy_if_different $<TARGET_FILE:${lib}> \"${CMAKE_BINARY_DIR}/${dir}\"\n234:       DEPENDS ${lib} \n235:       COMMENT \"Copying DLL ${lib} next to ${trgt}\"\n236:       VERBATIM)\n237:     add_custom_target(${trgt}_dll DEPENDS \"${copied_dll}\")\n238:     add_dependencies(${trgt} ${trgt}_dll)\n239:   endif()\n240: \n241:   # команда для cl+link. флаг DEBUG = ON - т.е. пойдём по ветке if (DBG) с флагами для программ-задач\n242:   configure_target(${trgt} ON)\n243:  \n244: endfunction()\n245: \n246: # генерация version.h из шаблона\n247: # @PROJECT_VERSION@ подставится реальная версия из project(VERSION)\n248: # @ONLY - подставляются только @VAR@, а не ${...} (в шаблоне только @PROJECT_VERSION@). для защиты\n249: # /generated в каталоге бинарей будет создан configure_file-ом, если такого каталога ещё нет\n250: configure_file(\n251:   ${CMAKE_SOURCE_DIR}/common/version.h.in\n252:   ${CMAKE_BINARY_DIR}/generated/version.h\n253:   @ONLY)\n254: \n255: # === ПОДПРОЕКТ ДЛЯ СОЗДАНИЯ БИБЛИОТЕК === \n256: # add_subdirectory(source_dir [binary_dir] ...)\n257: # source_dir - где лежит вложенный CMakeLists.txt /common)\n258: # binary_dir - где положить служеб. файлы CMake для подпроекта (если не указано, то в CMAKE_BINARY_DIR/source_dir)  \n259: add_subdirectory(common)\n260: \n261: \n262: # === ДОБАВЛЕНИЕ ЗАДАЧ ===\n263: # arg1 - папка бинарей и прочих продуктов (build/cfg/...)\n264: # arg2 - логическое имя цели\n265: # arg3 - исходник, чтобы сделать файл цели\n266: # arg4 - библиотека с которой линковаться\n267: \n268: # TASK 1\n269: add_task(t1_dist_matrix_cpp t1_cpp t1_dist_matrix_cpp/main.cpp common_cpp_static)\n\n(Showing lines 150-269 of 318. Use offset=270 to continue.)\n</content>",
