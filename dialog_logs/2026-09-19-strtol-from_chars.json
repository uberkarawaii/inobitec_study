RSE_NOT_FINITE)\n                fprintf(stderr, \"������ %d. ����� X Y Z ���������� �� �������� ����������: %s\\n\", i, s);\n\n            // � ����� ���� ����� ��������� �� �������� �����������\n            else if (ex_code == PARSE_OUT_OF_RANGE)\n                fprintf(stderr, \"������ %d. ����� X Y Z ���������� ����������, ��������� �� ���������� ��������: %s\\n\",\n                        i, s);\n\n            free(s);\n            s = NULL;\n            return data;\n        }\n\n        // ���� ����� ����, �� ��� �������� �� parse_points == 0 - ������������� ������\n        // ���������� ����� � ������\n        (*points)[*points_size] = p;\n        (*points_size)++;\n\n        //\n        if (*points_size >= *points_capacity) {\n            *points_capacity *= 2;\n            struct Point* tmp = realloc(*points, *points_capacity * sizeof(*tmp));\n            if (!tmp) {\n                fprintf(stderr, \"������ ��� ��������� ������\\n\");\n                free(s);\n                free(*points);\n                exit(io_fail);\n            }\n            *points = tmp;\n        }\n\n        // ���������� s �.�. � �� ��������� ����� ������\n        free(s);\n        s = NULL;\n    }\n\n    if (*points_size == 0) {\n        fprintf(stderr, \"����� �����������\\n\");\n        free(s);\n        return no_input;\n    }\n\n    return 0;\n}\n\nint main(int argc, char* argv[]) {\n    // �������� ������� - ���-�� ���������� � ��� ������ (����� ��, ������� ��, ������������� ��)\n    if (argc != 2) {\n        if (argc < 2)\n            fprintf(stderr, \"�������� ������; ��� �������� �� ���� �������\\n\");\n        else\n            fprintf(stderr, \"�������� ������; ���� ������� ������ ���������\\n\");\n        return usage;\n    }\n\n    char* end_r;\n    errno = 0;\n    // ���������� ������. strtod ��� ������� ������� �������\n    double r = strtod(argv[1], &end_r);\n    const char* tail = end_r;\n    // ������� ��������. ��������\n    while (*tail != '\\0' && isspace((unsigned char)*tail))\n        ++tail;\n    // ���� �������. ���. � ������, ��� � ����� �� �����, ��� ���� 16�� ������� - �� ��� ������ �������\n    if (end_r == argv[1] || *tail != '\\0' || is_hex_prefix(argv[1])) {\n        fprintf(stderr, \"������ ������ ���� ������. ��������: %s\\n\", argv[1]);\n        return usage;\n    }\n\n    if (errno == ERANGE && (r == 0.0 || !isfinite(r))) {\n        fprintf(stderr, \"������ ������� �� ���������� ��������: %s\\n\", argv[1]);\n        return usage;\n    }\n\n    if (!isfinite(r)) {\n        fprintf(stderr, \"������ ������ ���� �������� ������. ��������: %s\\n\", argv[1]);\n        return usage;\n    }\n\n    if (r <= 0) {\n        fprintf(stderr, \"������ ������ ���� �������������. ��������: %s\\n\", argv[1]);\n        return usage;\n    }\n\n    // ������ ����� � �������� ��������� ������\n    int points_size = 0, points_capacity = 1;\n    struct Point* points = malloc(sizeof(struct Point));\n    if (!points) {\n        fprintf(stderr, \"�� ������� �������� ������\\n\");\n        return io_fail;\n    }\n\n    // ����� ���������. �-���\n    // ���� ��� �����. != 0, ��� ��� ���-�� ����������, � ����� ������� ���� �� ���\n    int status = get_points(&points, &points_size, &points_capacity);\n    if (status != 0) {\n        free(points);\n        return status;\n    } else\n        // ����� �����, � ������� �����. �� ������ < r\n        for (int i = 0; i < points_size; ++i) {\n            if (sqrt(points[i].x * points[i].x + points[i].y * points[i].y + points[i].z * points[i].z) < r)\n                printf(\"%.3f %.3f %.3f\\n\", points[i].x, points[i].y, points[i].z);\n        }\n\n    free(points);\n\n    return 0;\n}",
