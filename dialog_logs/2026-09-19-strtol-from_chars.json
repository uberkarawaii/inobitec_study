� � �������; ��� ������ �������� ��������� � ���������� ��� ���\nstd::expected<std::vector<Point>, int> get_points() {\n    std::vector<Point> points;\n    // ������ ��� ����������\n    std::string temp;\n    // ������� �����\n    int i = 0;\n\n    while (std::getline(std::cin, temp)) {\n        ++i;\n\n        // ������� ������ �����\n        if (is_empty(temp))\n            continue;\n\n        // ������������� ����� � �������� �� ��, ��� ��� ��������, � ��� �� ����������� ���-��\n        // ���� ���� ���������� �������� 1, ���� ���������� ������ - 2\n        auto result = parse_point(temp);\n        if (!result) {\n            // ���� ����������\n            if (result.error() == parse_too_few)\n                std::cerr << \"������ \" << i << \" - ������������ ���������. ��������� X Y Z, ��������: \" << temp << \"\\n\";\n\n            // ���������� ������\n            else if (result.error() == parse_not_number)\n                std::cerr << \"������ \" << i << \". ���������� ������: \" << temp << \"\\n\";\n\n            // ������� ����� ���������\n            else if (result.error() == parse_too_much)\n                std::cerr << \"������ \" << i << \" - ������� ����� ���������. ��������� X Y Z, ��������: \" << temp\n                          << \"\\n\";\n\n            // ���� �� ��������� - �� �������� �����\n            else if (result.error() == parse_not_finite)\n                std::cerr << \"������ \" << i << \". ����� X Y Z ���������� �� �������� ����������: \" << temp << \"\\n\";\n\n            // � ����� ���� ����� ��������� �� �������� �����������\n            else if (result.error() == parse_out_of_range)\n                std::cerr << \"������ \" << i\n                          << \". ����� X Y Z ���������� ����������, ��������� �� ���������� ��������: \" << temp << \"\\n\";\n\n            return std::unexpected(exit_code::data);\n        }\n\n        // ���� ����� ����, �� ex_code == 0 ����� �������� ����� � ������\n        points.push_back(*result);\n    }\n\n    // error IO �������� ����� while. i+1 �.�. � ���� ��� ������ �� �����\n    if (std::cin.bad()) {\n        std::cerr << \"������ \" << i + 1 << \" - ���� �����-������\\n\";\n        return std::unexpected(exit_code::io_fail);\n    }\n\n    if (points.empty()) {\n        std::cerr << \"����� �����������\\n\";\n        return std::unexpected(exit_code::no_in);\n    }\n\n    return points;\n}\n\nint main(int argc, char* argv[]) {\n    // ����. �������������, ����� EOF � io-fail ������ ����������� ��-�� ������ ����� fgetc\n    std::ios::sync_with_stdio(false);\n    // �������� ����� �������; ��� ������ ���������� ���� 0, ���� ������ ��� 1\n    if (argc != 2) {\n        if (argc < 2)\n            std::cerr << \"�������� ������; ��� �������� �� ���� �������\\n\";\n        else\n            std::cerr << \"�������� ������; ���� ������� ������ ���������\\n\";\n        return exit_code::usage;\n    }\n\n    std::string_view r_line{argv[1]};\n\n    // ������������� ����� � ��������, ��� ��� �����\n    auto parsedR = get_radius(r_line);\n    if (!parsedR) {\n        if (parsedR.error() == radius_not_number)\n            std::cerr << \"������ ������ ���� ������. ��������: \" << r_line << \"\\n\";\n        else if (parsedR.error() == radius_not_finite)\n            std::cerr << \"������ ������ ���� �������� ������. ��������: \" << r_line << \"\\n\";\n        else if (parsedR.error() == radius_not_positive)\n            std::cerr << \"������ ������ ���� �������������. ��������: \" << r_line << \"\\n\";\n        else if (parsedR.error() == radius_out_of_range)\n            std::cerr << \"������ ������� �� ���������� ��������: \" << r_line << \"\\n\";\n        return exit_code::usage;\n    }\n    double R = *parsedR;\n\n    // ��������� ��������� ������� �����\n    auto result = get_points();\n\n    // ��������� ������ - get_points ��� ��������� ��� � ������ ������ ��� ������\n    if (!result)\n        return result.error();\n\n    // ���� ��� ������, ����� ������ ���������� � *result\n    // ��� ���������\n    auto is_point_suitable = [R](const Point& p) { return std::hypot(p.x, p.y, p.z) < R; };\n    // ��� ������\n    auto show_format = [](const Point& p) { return std::format(\"{:.3f} {:.3f} {:.3f}\\n\", p.x, p.y, p.z); };\n    // ����� ������� � result ������������ �� ��� �������� �� �������, � ���� ��������������� ������\n    auto suitable_points = *result | std::views::filter(is_point_suitable) | std::views::transform(show_format);\n    for (const auto& pt : suitable_points)\n        std::print(\"{}\", pt);\n\n    return 0;\n}",
