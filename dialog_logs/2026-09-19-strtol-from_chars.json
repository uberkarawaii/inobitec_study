          "text": "Вот обе реализации, в стиле `common/geometry.*` (те же `COMMON_API`, коды-константы). `[МНЕНИЕ, ВЫСОКИЙ]`\n\n## C — `common/string_utils.h`\n\nДобавить `#include <stdint.h>` и после `trim_string`:\n\n```c\n// разбор целого (десятичное); строка уже обрезана от пробелов\n// 0 - успех\n// INT_PARSE_NOT_NUMBER  - не число\n// INT_PARSE_OUT_OF_RANGE - не помещается в int32\nCOMMON_API int parse_int32(const char* s, int32_t* out);\n\n// коды именно для целочисленного разбора, чтобы не сталкиваться с PARSE_* из geometry\nenum { INT_PARSE_NOT_NUMBER = 1, INT_PARSE_OUT_OF_RANGE = 2 };\n```\n\n## C — `common/string_utils.c`\n\nДобавить `#include <errno.h>` и `#include <stdint.h>` (остальное — `ctype.h`, `stdlib.h` — уже есть):\n\n```c\nint parse_int32(const char* s, int32_t* out) {\n    // ведущий + допустим только если сразу за ним цифра: strtol принял бы и \"+-5\",\n    // сдвинуть + руками надо (from_chars не умеет плюс), но тогда \"+-5\" надо отсечь\n    const char* first = s;\n    if (*first == '+') {\n        ++first;\n        if (!isdigit((unsigned char)*first))\n            return INT_PARSE_NOT_NUMBER;\n    }\n\n    errno = 0;\n    char* end = NULL;\n    long v = strtol(first, &end, 10);\n\n    // Windows: long == int32, спасёт только ERANGE (значение уже clamp'нуто)\n    // Linux:   long 64-битный, ERANGE нет, спасёт сравнение с INT32_*\n    if (errno == ERANGE || v < INT32_MIN || v > INT32_MAX)\n        return INT_PARSE_OUT_OF_RANGE;\n\n    // число обязано занимать всю строку: \"5x\", \"5.5\", \"0x10\", \"\" - не число\n    if (end == first || *end != '\\0')\n        return INT_PARSE_NOT_NUMBER;\n\n    *out = (int32_t)v;\n    return 0;\n}\n```\n\nПорядок `out_of_range` → хвост: для `\"99999999999999999999x\"` даёт `OUT_OF_RANGE` (как t3–t4, «что встретилось первым»).\n\n## C++ — `common/string_utils.hpp`\n\nДобавить `#include <cstdint>`, `#include <expected>`, `#include <string_view>` и после `is_empty`:\n\n```cpp\n// разбор целого (десятичное); строка уже обрезана от пробелов\nCOMMON_API std::expected<std::int32_t, int> parse_int32(std::string_view s);\n\n// коды; отдельные имена, чтобы не сталкиваться с parse_* из geometry.hpp\ninline constexpr int int_parse_not_number = 1;\ninline constexpr int int_parse_out_of_range = 2;\n```\n\n## C++ — `common/string_utils.cpp`\n\nДобавить `#include <cctype>`, `#include <charconv>`, `#include <cstdint>`, `#include <expected>`, `#include <string_view>`, `#include <system_error>` (свой header первым):\n\n```cpp\nstd::expected<std::int32_t, int> parse_int32(std::string_view s) {\n    const char* first = s.data();\n    const char* last = s.data() + s.size();\n\n    // ведущий + допустим только если сразу за ним цифра:\n    // иначе from_chars после сдвига принял бы \"+-5\" как -5\n    if (first != last && *first == '+') {\n        ++first;\n        if (first == last || !std::isdigit(static_cast<unsigned char>(*first)))\n            return std::unexpected(int_parse_not_number);\n    }\n\n    std::int32_t v = 0;\n    const auto [ptr, ec] = std::from_chars(first, last, v);\n\n    if (ec == std::errc::result_out_of_range)\n        return std::unexpected(int_parse_out_of_range);\n\n    // неполное потребление (\"5x\", \"5.5\", \"0x10\") или нет преобразования (\"\", \"x5\")\n    if (ec != std::errc{} || ptr != last)\n        return std::unexpected(int_parse_not_number);\n\n    return v;\n}\n```\n\n## Как зовёт `main` (для контекста, не отдельная правка)\n\n```c\nint32_t N = 0;\nint code = parse_int32(clean_n, &N);\nif (code == INT_PARSE_OUT_OF_RANGE) { /* ... */ return data; }\nif (code == INT_PARSE_NOT_NUMBER)  { /* ... */ return data; }\nif (N < MIN_SIZE || N > MAX_SIZE)  { /* ... */ return usage; }\n```\n\n```cpp\nauto parsed = parse_int32(lineN);\nif (!parsed) {\n    if (parsed.error() == int_parse_out_of_range) { /* ... */ return exit_code::data; }\n    if (parsed.error() == int_parse_not_number)  { /* ... */ return exit_code::data; }\n} else if (*parsed < 3 || *parsed > 20) {\n    /* ... */ return exit_code::usage;\n}\n```\n\nДва момента на ваше решение:\n- Константы назвала `INT_PARSE_*`/`int_parse_*`, чтобы не пересечься с `PARSE_NOT_NUMBER`/`PARSE_OUT_OF_RANGE` из `geometry.*` (оба заголовка попадают в t3–t4). Если хотите общий префикс проекта — скажите.\n- Парсер принимает **уже обрезанную** строку (`@pre`), как сейчас и делают t1/t2; сам пробелы не трогает.",
