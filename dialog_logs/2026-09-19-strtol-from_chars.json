-5\",         \"-+5\",          \"+abc\",        \"-abc\",         \"+\",\n        \"-\",         \"+.5\",\n    };\n\n    std::printf(\"sizeof(int)=%zu sizeof(long)=%zu sizeof(int32_t)=%zu\\n\\n\", sizeof(int), sizeof(long),\n                sizeof(std::int32_t));\n\n    for (const std::string& s : cases) {\n        // 1) C-ветка: strtol, base 10\n        errno = 0;\n        char* end = nullptr;\n        const long v = std::strtol(s.c_str(), &end, 10);\n        const bool st_conv = (end != s.c_str());\n        const bool st_full = st_conv && (*end == '\\0');\n        const bool st_erange = (errno == ERANGE);\n\n        const char* first = s.data();\n        const char* last = s.data() + s.size();\n\n        // 2) from_chars сырой (без ручного сдвига знака)\n        int raw = 0;\n        const auto [p_raw, ec_raw] = std::from_chars(first, last, raw);\n        const bool raw_full = (ec_raw == std::errc{}) && (p_raw == last);\n\n        // 3) from_chars с ручным сдвигом '+' (как сейчас в t1/t2)\n        int skip = 0;\n        const char* first_skip = first;\n        if (first_skip != last && *first_skip == '+')\n            ++first_skip;\n        const auto [p_skip, ec_skip] = std::from_chars(first_skip, last, skip);\n        const bool skip_full = (ec_skip == std::errc{}) && (p_skip == last);\n\n        std::printf(\n            \"in=%-26s | strtol: v=%-20ld conv=%d full=%d ERANGE=%d rem=%-10s \"\n            \"| fc-raw: ec=%-16s v=%-11d full=%d | fc+skip: ec=%-16s v=%-11d full=%d\\n\",\n            quote(s).c_str(), v, st_conv, st_full, st_erange, quote(end).c_str(), ec_name(ec_raw), raw, raw_full,\n            ec_name(ec_skip), skip, skip_full);\n    }\n\n    return 0;\n}\n```\n\nКак гонять:\n```\ncl /std:c++latest /W4 /EHsc parse_diff_int.cpp\nparse_diff_int.exe > windows.txt\n```\n```\ng++ -std=c++23 -Wall -Wextra -O0 parse_diff_int.cpp -o parse_diff_int\n./parse_diff_int > ubuntu.txt\n```\n\nНа что смотреть в выводе:\n- `sizeof(long)` — 4 на Windows, 8 на Ubuntu 