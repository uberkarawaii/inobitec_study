FATAL_ERROR \"VCPKG_DEV_ROOT is not set; it must point to the vcpkg clone used by the toolchain\")\n37: endif()\n38: \n39: # чтение vcpkg.json из корня проекта, чтобы определить baseline\n40: # _vcpkg_manifest - весь vcpkg.json; _m - builtin-baseline найденный по regex  \n41: file(READ \"${CMAKE_SOURCE_DIR}/vcpkg.json\" _vcpkg_manifest)\n42: string(REGEX MATCH \"\\\"builtin-baseline\\\"[ \\t]*:[ \\t]*\\\"([0-9a-fA-F]+)\\\"\" _m \"${_vcpkg_manifest}\")\n43: # если builtin-baseline не нашёлся, то падение с ошибкой \n44: if(NOT _m)\n45:   message(FATAL_ERROR \"builtin-baseline was not found in vcpkg.json\")\n46: endif()\n47: # CMAKE_MATCH_1 - то что попало в первую группу regex - т.е. ([0-9a-fA-F]+), сам sha\n48: set(VCPKG_BASELINE \"${CMAKE_MATCH_1}\")\n49: \n50: # запуск подпроцесса git из папки клона vcpkg\n51: # cat-file -e X - есть ли объект Х в базе? результат: 0(успех) или не-нуль(нет в базе), уйдёт в _baseline_ok\n52: # \"${VCPKG_BASELINE}^{commit}\" - объект-коммит выделенного sha. если такого коммита нет - падение с не-нуль  \n53: execute_process(\n54:   COMMAND \"${GIT_EXECUTABLE}\" -C \"$ENV{VCPKG_DEV_ROOT}\" cat-file -e \"${VCPKG_BASELINE}^{commit}\"\n55:   RESULT_VARIABLE _baseline_ok\n56:   OUTPUT_QUIET\n57:   ERROR_QUIET)\n58: \n59: # если такого объекта нет в базе - падение с сообщением. если есть - тоже оповещаем\n60: if(NOT _baseline_ok EQUAL 0)\n61:   message(FATAL_ERROR\n62:     \"builtin-baseline ${VCPKG_BASELINE} is not reachable in the vcpkg instance at \"\n63:     \"$ENV{VCPKG_DEV_ROOT}. Run 'git fetch' in that clone and try again.\")\n64: endif()\n65: \n66: message(STATUS \"vcpkg baseline : ${VCPKG_BASELINE} (reachable in $ENV{VCPKG_DEV_ROOT})\")\n67: \n68: # имя проекта сохранится в CMAKE_PROJECT_NAME\n69: # определяются яызки проекта: с с++; определится компилятор; \n70: # появятся перменные (типа CMAKE_C_FLAGS_DEBUG) заполненные дефолтными значениями\n71: project(inobitec_stud VERSION 0.1.0 LANGUAGES C CXX)\n72: \n73: # какой инстанс vcpkg реально подключён - защита от тихой подмены инструмента\n74: # CMAKE_TOOLCHAIN_FILE путь к скрипт vcpkg.cmake\n75: # Z_VCPKG_ROOT_DIR корень vcpkg, вычисляется им самим. т.е. из какого инстанса идёт инструмент\n76: # триплет: профиль сборки. у меня сейчас x64-windows - x64, винда, динамич. линковка\n77: if(VCPKG_TARGET_TRIPLET)\n78:   message(STATUS \"vcpkg toolchain: ${CMAKE_TOOLCHAIN_FILE}\")\n79:   if(DEFINED Z_VCPKG_ROOT_DIR)\n80:     message(STATUS \"vcpkg instance : ${Z_VCPKG_ROOT_DIR}\")\n81:   endif()\n82:   message(STATUS \"vcpkg triplet  : ${VCPKG_TARGET_TRIPLET}\")\n83: endif()\n84: \n85: # === СТАНДАРТЫ ===\n86: # стандарт языка Си\n87: set(CMAKE_C_STANDARD 17)\n88: # компилятор обязан поддерживать этот стандарт языка. иначе - ошибка во время конфигурации CMakeLists (прекомпил.)\n89: set(CMAKE_C_STANDARD_REQUIRED ON)\n90: # только стандартный компилятор языка, без расширений, типа gnu-расширений\n91: set(CMAKE_C_EXTENSIONS OFF)\n92: # то же для с++\n93: set(CMAKE_CXX_STANDARD 23)\n94: set(CMAKE_CXX_STANDARD_REQUIRED ON)\n95: set(CMAKE_CXX_EXTENSIONS OFF)\n96: \n97:                                \n98: # === ТИП СБОРКИ ===\n99: # определение debug / release; делается через -DCMAKE_BUILD_TYPE=...\n100: # Debug будет поставлен, если ничего не передали через флаг\n101: if(NOT CMAKE_BUILD_TYPE)\n102:   set(CMAKE_BUILD_TYPE Debug CACHE STRING \"Build type (Debug/Release)\" FORCE)\n103: endif()\n104: # переменная CMAKE_BUILD_TYPE уйдёт в кэш \n105: # кэш: для CMake, хранить инф. м-у выполнениями, и пользователь не повторяет ввод каждый раз\n106: # FORCE вызовет перезапись параметра\n107: \n108: \n109: # === ИСПРАВЛЕНИЕ DEFAULT-ФЛАГОВ ===\n110: # CMAke дефолтно положит /RTC1 в debug-ветку. /RTC1 ловит ошибки в runtime, для этого лезет в стек и размечает его\n111: # ASan - та же ф-ция. если оба будут менять стек, они помешают друг другу -> несовместимы. /RTC1 убирается \n112: # /incremental также несовместим с asan (именно по документации. так работало и когда об