9: # === Ф-ЦИЯ ДОБАВЛЕНИЯ ЗАДАЧИ === \n150: # сборки exe из main.c/main.cpp; уходит в каталог build/cfg/dir\n151: function(add_task dir trgt src lib)\n152:   # добавление исполняемного файла \n153:   # цель и её исходник. цель имеет одно имя (логическое, типа t1_c), а сделанный ею файл - другое (OUTPUT_NAME main)\n154:   add_executable(${trgt} ${src})\n155: \n156:   # в CMAKE_BINARY_DIR будет тот каталог, который был передан по -B\n157:   set_target_properties(${trgt} PROPERTIES\n158:   OUTPUT_NAME main\n159:   RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/${dir})\n160: \n161:   # с кем линкуемся\n162:   # тут private не имеет смысла (.exe конечен, к нему не линкуются), просто для единообразия\n163:   target_link_libraries(${trgt} PRIVATE ${lib})\n164: \n165:   # определение типа библиотеки т.к. на windows для .dll нужно доп. действие для связки с .exe\n166:   get_target_property(lib_type ${lib} TYPE)\n167:   # копирование dll в папку к exe даже если сам exe не перестраивался\n168:   if(WIN32 AND lib_type STREQUAL \"SHARED_LIBRARY\")\n169:     set(copied_dll \"${CMAKE_BINARY_DIR}/${dir}/${lib}.dll\")\n170:     add_custom_command(OUTPUT \"${copied_dll}\"\n171:       COMMAND ${CMAKE_COMMAND} -E copy_if_different $<TARGET_FILE:${lib}> \"${CMAKE_BINARY_DIR}/${dir}\"\n172:       DEPENDS ${lib} \n173:       COMMENT \"Copying DLL ${lib} next to ${trgt}\"\n174:       VERBATIM)\n175:     add_custom_target(${trgt}_dll DEPENDS \"${copied_dll}\")\n176:     add_dependencies(${trgt} ${trgt}_dll)\n177:   endif()\n178: \n179:   # команда для cl+link. флаг DEBUG = ON - т.е. пойдём по ветке if (DBG) с флагами для программ-задач\n180:   configure_target(${trgt} ON)\n181:  \n182: endfunction()\n183: \n184: # генерация version.h из шаблона\n185: # @PROJECT_VERSION@ подставится реальная версия из project(VERSION)\n186: # @ONLY - подставляются только @VAR@, а не ${...} (в шаблоне только @PROJECT_VERSION@). для защиты\n187: # /generated в каталоге бинарей будет создан configure_file-ом, если такого каталога ещё нет\n188: configure_file(\n189:   ${CMAKE_SOURCE_DIR}/common/version.h.in\n190:   ${CMAKE_BINARY_DIR}/generated/version.h\n191:   @ONLY)\n192: \n193: # === ПОДПРОЕКТ ДЛЯ СОЗДАНИЯ БИБЛИОТЕК === \n194: # add_subdirectory(source_dir [binary_dir] ...)\n195: # source_dir - где лежит вложенный CMakeLists.txt /common)\n196: # binary_dir - где положить служеб. файлы CMake для подпроекта (если не указано, то в CMAKE_BINARY_DIR/source_dir)  \n197: add_subdirectory(common)\n198: \n199: \n200: # === ДОБАВЛЕНИЕ ЗАДАЧ ===\n201: # arg1 - папка бинарей и прочих продуктов (build/cfg/...)\n202: # arg2 - логическое имя цели\n203: # arg3 - исходник, чтобы сделать файл цели\n204: # arg4 - библиотека с которой линковаться\n205: \n206: # TASK 1\n207: add_task(t1_dist_matrix_cpp t1_cpp t1_dist_matrix_cpp/main.cpp common_cpp_static)\n208: add_task(t1_dist_matrix_c t1_c t1_dist_matrix_c/main.c common_c_static)\n209: \n210: # TASK 2\n211: add_task(t2_passport_cpp t2_cpp t2_passport_cpp/main.cpp string_utils_cpp_static)\n212: add_task(t2_passport_c t2_c t2_passport_c/main.c string_utils_c_static)\n213: \n214: # TASK 3\n215: add_task(t3_bbox_cpp t3_cpp t3_bbox_cpp/main.cpp common_cpp_shared)\n216: add_task(t3_bbox_c t3_c t3_bbox_c/main.c common_c_shared)\n217: \n218: # TASK 4\n219: add_task(t4_filter_cpp t4_cpp t4_filter_cpp/main.cpp common_cpp_shared)\n220: add_task(t4_filter_c t4_c t4_filter_c/main.c common_c_shared)\n221: \n222: # === ФОРМАТИРОВАНИЕ ===\n223: \n224: # cmake/format.cmake в скриптовом режиме. отделен он графа сборки проекта\n225: set(FORMAT_SCRIPT \"${CMAKE_SOURCE_DIR}/cmake/format.cmake\")\n226: \n227: # исключаем весь каталог сборки, а не только текущую конфигурацию:\n228: # конфигурации вложены (build/debug, build/release)\n229: set(FORMAT_BUILD_ROOT \"${CMAKE_BINARY_DIR}\")\n230: get_filename_component(FORMAT_BUILD_PARENT \"${CMAKE_BINARY_DIR}\" DIRECTORY)\n231: if(NOT FORMAT_BUILD_PARENT STREQUAL CMAKE_SOURCE_DIR)\n232:   set(FORMAT_BUILD_ROOT \"${FORMAT_BUILD_PARENT}\")\n233: endif()\n234: \n235: # один и тот же source-dir и build-dir, изменяется только check/apply - он добавляется в командах\n236: # общая часть из source-dir и build-dir\n237: set(FORMAT_COMMON -DSRC_DIR=${CMAKE_SOURCE_DIR} -DBUILD_DIR=${FORMAT_BUILD_ROOT} -P ${FORMAT_SCRIPT})\n238: \n239: # отформатировать\n240: add_custom_target(format\n241:   COMMAND ${CMAKE_COMMAND} -DMODE=apply ${FORMAT_COMMON}\n242:   COMMENT \"Applying clang-format to all C/C++ files\")\n243: \n244: # проверить формат (в этом же виде вызывается из ctest)\n245: add_custom_target(format-check\n246:   COMMAND ${CMAKE_COMMAND} -DMODE=check ${FORMAT_COMMON}\n247:   COMMENT \"Checking clang-format of all C/C++ files\")\n248: \n249: # === TESTS ===\n250: enable_testing()\n251: # первый тест: проверка чистоты формата\n252: # если есть clang+format - проверка строгая, не-падение - только при чистом формате\n253: # иначе - warning и тесты\n254: add_test(NAME format-check COMMAND ${CMAKE_COMMAND} -DMODE=check ${FORMAT_COMMON}) \n255: # тесты на знчения и коды\n256: add_subdirectory(tests) \n\n(End of file - total 256 lines)\n</content>",
            "metadata": {
              "preview": "# минимальная необходимая версия cmake + свежие политики (конкретные точки поведения) до 3.22 \n# в старых CMake-ах выполнение остановится здесь, с требованием версии 3.22\n# политика - как себя ведёт что-либо в CMake. если не указать версию, то default=OLD и будет warning, \n# т.к. старые политики - для совместимости, но не обещают корретности\ncmake_minimum_required(VERSION 3.22)\n\n# проверка наличия ninja, если задан именно этот генератор. до проверки компилятора в project() \nif(CMAKE_GENERATOR MATCHES \"^Ninja\")\n  # find_program ищет в PATH и кэширует результат в CMakeCache.txt как NINJA_EXECUTABLE\n  find_program(NINJA_EXECUTABLE NAMES ninja)\n  if(NOT NINJA_EXECUTABLE)\n    message(FATAL_ERROR\n      \"The '${CMAKE_GENERATOR}' generator was selected, but ninja was not found. \"\n      \"Install ninja or add its directory to PATH\")\n  endif()\n  # сообщение при конфигурации\n  message(STATUS \"ninja: ${NINJA_EXECUTABLE}\")\n# else отсутствует - пока что в проекте генератор - именно Ninja\nendif()\n",
