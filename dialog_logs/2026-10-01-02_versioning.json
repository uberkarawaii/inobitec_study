            "output": "<path>C:\\Users\\User\\Desktop\\inobitec_stud\\CMakeLists.txt</path>\n<type>file</type>\n<content>\n1: # минимальная необходимая версия cmake + свежие политики (конкретные точки поведения) до 3.22 \n2: # в старых CMake-ах выполнение остановится здесь, с требованием версии 3.22\n3: # политика - как себя ведёт что-либо в CMake. если не указать версию, то default=OLD и будет warning, \n4: # т.к. старые политики - для совместимости, но не обещают корретности\n5: cmake_minimum_required(VERSION 3.22)\n6: \n7: # проверка наличия ninja, если задан именно этот генератор. до проверки компилятора в project() \n8: if(CMAKE_GENERATOR MATCHES \"^Ninja\")\n9:   # find_program ищет в PATH и кэширует результат в CMakeCache.txt как NINJA_EXECUTABLE\n10:   find_program(NINJA_EXECUTABLE NAMES ninja)\n11:   if(NOT NINJA_EXECUTABLE)\n12:     message(FATAL_ERROR\n13:       \"The '${CMAKE_GENERATOR}' generator was selected, but ninja was not found. \"\n14:       \"Install ninja or add its directory to PATH\")\n15:   endif()\n16:   # сообщение при конфигурации\n17:   message(STATUS \"ninja: ${NINJA_EXECUTABLE}\")\n18: # else отсутствует - пока что в проекте генератор - именно Ninja\n19: endif()\n20: \n21: \n22: # === ПРОВЕРКА BASELINE ===\n23: # делается до project, иначе будет падение не от моей проверки с моим сообщением,\n24: # а при vcpkg install - каскад падений\n25: \n26: # надо понять: \"вложена\" ли требуемая версия в имеющийся инстанс vcpkg. для этого используем git\n27: # проверка что он есть - иначе нет инструмента для проверки\n28: find_program(GIT_EXECUTABLE NAMES git)\n29: if(NOT GIT_EXECUTABLE)\n30:   message(FATAL_ERROR \"git was not found in PATH; it is required to check the vcpkg baseline\")\n31: endif()\n32: \n33: # при поиске инстанса опираемся на переменную среды VCPKG_DEV_ROOT - если её нет, падаем\n34: # иначе не сможем понять, какой именно инстанс\n35: if(NOT DEFINED ENV{VCPKG_DEV_ROOT} OR \"$ENV{VCPKG_DEV_ROOT}\" STREQUAL \"\")\n36:   message(FATAL_ERROR \"VCPKG_DEV_ROOT is not set; it must point to the vcpkg clone used by the toolchain\")\n37: endif()\n38: \n39: # чтение vcpkg.json из корня проекта, чтобы определить baseline\n40: # _vcpkg_manifest - весь vcpkg.json; _m - builtin-baseline найденный по regex  \n41: file(READ \"${CMAKE_SOURCE_DIR}/vcpkg.json\" _vcpkg_manifest)\n42: string(REGEX MATCH \"\\\"builtin-baseline\\\"[ \\t]*:[ \\t]*\\\"([0-9a-fA-F]+)\\\"\" _m \"${_vcpkg_manifest}\")\n43: # если builtin-baseline не нашёлся, то падение с ошибкой \n44: if(NOT _m)\n45:   message(FATAL_ERROR \"builtin-baseline was not found in vcpkg.json\")\n46: endif()\n47: # CMAKE_MATCH_1 - то что попало в первую группу regex - т.е. ([0-9a-fA-F]+), сам sha\n48: set(VCPKG_BASELINE \"${CMAKE_MATCH_1}\")\n49: \n50: # запуск подпроцесса git из папки клона vcpkg\n51: # cat-file -e X - есть ли объект Х в базе? результат: 0(успех) или не-нуль(нет в базе), уйдёт в _baseline_ok\n52: # \"${VCPKG_BASELINE}^{commit}\" - объект-коммит выделенного sha. если такого коммита нет - падение с не-нуль  \n53: execute_process(\n54:   COMMAND \"${GIT_EXECUTABLE}\" -C \"$ENV{VCPKG_DEV_ROOT}\" cat-file -e \"${VCPKG_BASELINE}^{commit}\"\n55:   RESULT_VARIABLE _baseline_ok\n56:   OUTPUT_QUIET\n57:   ERROR_QUIET)\n58: \n59: # если такого объекта нет в базе - падение с сообщением. если есть - тоже оповещаем\n60: if(NOT _baseline_ok EQUAL 0)\n61:   message(FATAL_ERROR\n62:     \"builtin-baseline ${VCPKG_BASELINE} is not reachable in the vcpkg instance at \"\n63:     \"$ENV{VCPKG_DEV_ROOT}. Run 'git fetch' in that clone and try again.\")\n64: endif()\n65: \n66: message(STATUS \"vcpkg baseline : ${VCPKG_BASELINE} (reachable in $ENV{VCPKG_DEV_ROOT})\")\n67: \n68: # имя проекта сохранится в CMAKE_PROJECT_NAME\n69: # определяются яызки проекта: с с++; определится компилятор; \n70: # появятся перменные (типа CMAKE_C_FLAGS_DEBUG) заполненные дефолтными значениями\n71: project(inobitec_stud LANGUAGES C CXX)\n72: \n73: # какой инстанс vcpkg реально подключён - защита от тихой подмены инструмента\n74: # CMAKE_TOOLCHAIN_FILE путь к скрипт vcpkg.cmake\n75: # Z_VCPKG_ROOT_DIR корень vcpkg, вычисляется им самим. т.е. из какого инстанса идёт инструмент\n76: # триплет: профиль сборки. у меня сейчас x64-windows - x64, винда, динамич. линковка\n77: if(VCPKG_TARGET_TRIPLET)\n78:   message(STATUS \"vcpkg toolchain: ${CMAKE_TOOLCHAIN_FILE}\")\n79:   if(DEFINED Z_VCPKG_ROOT_DIR)\n80:     message(STATUS \"vcpkg instance : ${Z_VCPKG_ROOT_DIR}\")\n81:   endif()\n82:   message(STATUS \"vcpkg triplet  : ${VCPKG_TARGET_TRIPLET}\")\n83: endif()\n84: \n85: # === СТАНДАРТЫ ===\n86: # стандарт языка Си\n87: set(CMAKE_C_STANDARD 17)\n88: # компилятор обязан поддерживать этот стандарт языка. иначе - ошибка во время конфигурации CMakeLists (прекомпил.)\n89: set(CMAKE_C_STANDARD_REQUIRED ON)\n90: # только стандартный компилятор языка, без расширений, типа gnu-расширений\n91: set(CMAKE_C_EXTENSIONS OFF)\n92: # то же для с++\n93: set(CMAKE_CXX_STANDARD 23)\n94: set(CMAKE_CXX_STANDARD_REQUIRED ON)\n95: set(CMAKE_CXX_EXTENSIONS OFF)\n96: \n97:                                \n98: # === ТИП СБОРКИ ===\n99: # определение debug / release; делается через -DCMAKE_BUILD_TYPE=...\n100: # Debug будет поставлен, если ничего не передали через флаг\n101: if(NOT CMAKE_BUILD_TYPE)\n102:   set(CMAKE_BUILD_TYPE Debug CACHE STRING \"Build type (Debug/Release)\" FORCE)\n103: endif()\n104: # переменная CMAKE_BUILD_TYPE уйдёт в кэш \n105: # кэш: для CMake, хранить инф. м-у выполнениями, и пользователь не повторяет ввод каждый раз\n106: # FORCE вызовет перезапись параметра\n107: \n108: \n109: # === ИСПРАВЛЕНИЕ DEFAULT-ФЛАГОВ ===\n110: # CMAke дефолтно положит /RTC1 в debug-ветку. /RTC1 ловит ошибки в runtime, для этого лезет в стек и размечает его\n111: # ASan - та же ф-ция. если оба будут менять стек, они помешают друг другу -> несовместимы. /RTC1 убирается \n112: # /incremental также несовместим с asan (именно по документации. так работало и когда оба вместе)\n113: if(MSVC)\n114:   string(REPLACE \"/RTC1\" \"\" CMAKE_C_FLAGS_DEBUG   \"${CMAKE_C_FLAGS_DEBUG}\")\n115:   string(REPLACE \"/RTC1\" \"\" CMAKE_CXX_FLAGS_DEBUG \"${CMAKE_CXX_FLAGS_DEBUG}\")\n116:   string(REPLACE \"/INCREMENTAL\" \"\" CMAKE_EXE_LINKER_FLAGS_DEBUG  \"${CMAKE_EXE_LINKER_FLAGS_DEBUG}\")\n117: endif()\n118: \n119: \n120: # === ПОСТРОИТЬ КОМАНДЫ КОМПИЛЯЦИИ И ЛИНКА ===\n121: function(configure_target trgt DBG)\n122: if(MSVC)\n123:   # в msvc /Zi, /EHsc, /DEBUG  будут дублироваться, но прописываются для ясности\n124:   # target_compile_options - произвольные флаги компилятора \n125:   # PRIVATE даёт нетранзитивность: А (этот объект) и Б к нему сможет линковаться. а когда К линк. к Б, то К не будет линк. к А\n126:   target_compile_options(${trgt} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:/EHsc> /W4 /permissive-)\n127: \n128:   # сюда будет заходить только для программ из задач, не для программ для тестирования (run_case, check) - им эти флаги не нужны\n129:   if(DBG)\n130:     # CMake проставит след. флаги автоматиечки: /Od /O2; /MDd /MD; /DNDEBUG\n131:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Debug>:/Zi /fsanitize=address> $<$<CONFIG:Release>:/Zi>)\n132:     target_link_options(${trgt} PRIVATE $<$<CONFIG:Debug>:/DEBUG> $<$<CONFIG:Release>:/DEBUG /OPT:REF /OPT:ICF>)\n133:   endif()\n134: \n135: else()\n136:   target_compile_options(${trgt} PRIVATE -Wall -Wextra)\n137:   # и в ветке продуктов, и в ветке тестовых программ оптимизация на релизе будет именно -O2, а не cmake-default -O3\n138:   if (DBG) \n139:     # -O0 на дебаге будет подтянут CMake автоматически, а на релизе -DNDEBUG\n140:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Debug>: -g -fsanitize=address> $<$<CONFIG:Release>: -g -O2>)\n141:     target_link_options(${trgt} PRIVATE $<$<CONFIG:Debug>: -fsanitize=address>)\n142:   else()\n143:     target_compile_options(${trgt} PRIVATE $<$<CONFIG:Release>: -O2>)\n144:   endif()\n145: endif()\n146: endfunction()\n147: \n148: \n149: # === Ф-ЦИЯ ДОБАВЛЕНИЯ ЗАДАЧИ === \n150: # сборки exe из main.c/main.cpp; уходит в каталог build/cfg/dir\n151: function(add_task dir trgt src lib)\n152:   # добавление исполняемного файла \n153:   # цель и её исходник. цель имеет одно имя (логическое, типа t1_c), а сделанный ею файл - другое (OUTPUT_NAME main)\n154:   add_executable(${trgt} ${src})\n155: \n156:   # в CMAKE_BINARY_DIR будет тот каталог, который был передан по -B\n157:   set_target_properties(${trgt} PROPERTIES\n158:   OUTPUT_NAME main\n159:   RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/${dir})\n160: \n161:   # с кем линкуемся\n162:   # тут private не имеет смысла (.exe конечен, к нему не линкуются), просто для единообразия\n163:   target_link_libraries(${trgt} PRIVATE ${lib})\n164: \n165:   # определение типа библиотеки т.к. на windows для .dll нужно доп. действие для связки с .exe\n166:   get_target_property(lib_type ${lib} TYPE)\n167:   # копирование dll в папку к exe даже если сам exe не перестраивался\n168:   if(WIN32 AND lib_type STREQUAL \"SHARED_LIBRARY\")\n169:     set(copied_dll \"${CMAKE_BINARY_DIR}/${dir}/${lib}.dll\")\n170:     add_custom_command(OUTPUT \"${copied_dll}\"\n171:       COMMAND ${CMAKE_COMMAND} -E copy_if_different $<TARGET_FILE:${lib}> \"${CMAKE_BINARY_DIR}/${dir}\"\n172:       DEPENDS ${lib} \n173:       COMMENT \"Copying DLL ${lib} next to ${trgt}\"\n174:       VERBATIM)\n175:     add_custom_target(${trgt}_dll DEPENDS \"${copied_dll}\")\n176:     add_dependencies(${trgt} ${trgt}_dll)\n177:   endif()\n178: \n179:   # команда для cl+link. флаг DEBUG = ON - т.е. пойдём по ветке if (DBG) с флагами для программ-задач\n180:   configure_target(${trgt} ON)\n181:  \n182: endfunction()\n183: \n184: # === ПОДПРОЕКТ ДЛЯ СОЗДАНИЯ БИБЛИОТЕК === \n185: # add_subdirectory(source_dir [binary_dir] ...)\n186: # source_dir - где лежит вложенный CMakeLists.txt /common)\n187: # binary_dir - где положить служеб. файлы CMake для подпроекта (если не указано, то в CMAKE_BINARY_DIR/source_dir)  \n188: add_subdirectory(common)\n189: \n190: \n191: # === ДОБАВЛЕНИЕ ЗАДАЧ ===\n192: # arg1 - папка бинарей и прочих продуктов (build/cfg/...)\n193: # arg2 - логическое имя цели\n194: # arg3 - исходник, чтобы сделать файл цели\n195: # arg4 - библиотека с которой линковаться\n196: \n197: # TASK 1\n198: add_task(t1_dist_matrix_cpp t1_cpp t1_dist_matrix_cpp/main.cpp common_cpp_static)\n199: add_task(t1_dist_matrix_c t1_c t1_dist_matrix_c/main.c common_c_static)\n200: \n201: # TASK 2\n202: add_task(t2_passport_cpp t2_cpp t2_passport_cpp/main.cpp string_utils_cpp_static)\n203: add_task(t2_passport_c t2_c t2_passport_c/main.c string_utils_c_static)\n204: \n205: # TASK 3\n206: add_task(t3_bbox_cpp t3_cpp t3_bbox_cpp/main.cpp common_cpp_shared)\n207: add_task(t3_bbox_c t3_c t3_bbox_c/main.c common_c_shared)\n208: \n209: # TASK 4\n210: add_task(t4_filter_cpp t4_cpp t4_filter_cpp/main.cpp common_cpp_shared)\n211: add_task(t4_filter_c t4_c t4_filter_c/main.c common_c_shared)\n212: \n213: # === ФОРМАТИРОВАНИЕ ===\n214: \n215: # cmake/format.cmake в скриптовом режиме. отделен он графа сборки проекта\n216: set(FORMAT_SCRIPT \"${CMAKE_SOURCE_DIR}/cmake/format.cmake\")\n217: \n218: # исключаем весь каталог сборки, а не только текущую конфигурацию:\n219: # конфигурации вложены (build/debug, build/release)\n220: set(FORMAT_BUILD_ROOT \"${CMAKE_BINARY_DIR}\")\n221: get_filename_component(FORMAT_BUILD_PARENT \"${CMAKE_BINARY_DIR}\" DIRECTORY)\n222: if(NOT FORMAT_BUILD_PARENT STREQUAL CMAKE_SOURCE_DIR)\n223:   set(FORMAT_BUILD_ROOT \"${FORMAT_BUILD_PARENT}\")\n224: endif()\n225: \n226: # один и тот же source-dir и build-dir, изменяется только check/apply - он добавляется в командах\n227: # общая часть из source-dir и build-dir\n228: set(FORMAT_COMMON -DSRC_DIR=${CMAKE_SOURCE_DIR} -DBUILD_DIR=${FORMAT_BUILD_ROOT} -P ${FORMAT_SCRIPT})\n229: \n230: # отформатировать\n231: add_custom_target(format\n232:   COMMAND ${CMAKE_COMMAND} -DMODE=apply ${FORMAT_COMMON}\n233:   COMMENT \"Applying clang-format to all C/C++ files\")\n234: \n235: # проверить формат (в этом же виде вызывается из ctest)\n236: add_custom_target(format-check\n237:   COMMAND ${CMAKE_COMMAND} -DMODE=check ${FORMAT_COMMON}\n238:   COMMENT \"Checking clang-format of all C/C++ files\")\n239: \n240: # === TESTS ===\n241: enable_testing()\n242: # первый тест: проверка чистоты формата\n243: # если есть clang+format - проверка строгая, не-падение - только при чистом формате\n244: # иначе - warning и тесты\n245: add_test(NAME format-check COMMAND ${CMAKE_COMMAND} -DMODE=check ${FORMAT_COMMON}) \n246: # тесты на знчения и коды\n247: add_subdirectory(tests) \n\n(End of file - total 247 lines)\n</content>",
            "metadata": {
              "preview": "# минимальная необходимая версия cmake + свежие политики (конкретные точки поведения) до 3.22 \n# в старых CMake-ах выполнение остановится здесь, с требованием версии 3.22\n# политика - как себя ведёт что-либо в CMake. если не указать версию, то default=OLD и будет warning, \n# т.к. старые политики - для совместимости, но не обещают корретности\ncmake_minimum_required(VERSION 3.22)\n\n# проверка наличия ninja, если задан именно этот генератор. до проверки компилятора в project() \nif(CMAKE_GENERATOR MATCHES \"^Ninja\")\n  # find_program ищет в PATH и кэширует результат в CMakeCache.txt как NINJA_EXECUTABLE\n  find_program(NINJA_EXECUTABLE NAMES ninja)\n  if(NOT NINJA_EXECUTABLE)\n    message(FATAL_ERROR\n      \"The '${CMAKE_GENERATOR}' generator was selected, but ninja was not found. \"\n      \"Install ninja or add its directory to PATH\")\n  endif()\n  # сообщение при конфигурации\n  message(STATUS \"ninja: ${NINJA_EXECUTABLE}\")\n# else отсутствует - пока что в проекте генератор - именно Ninja\nendif()\n",
