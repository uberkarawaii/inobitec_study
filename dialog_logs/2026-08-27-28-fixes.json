R)/t2_passport_cpp/main$(EXE_EXT)\n132: T2_C_EXE := $(BINDIR)/t2_passport_c/main$(EXE_EXT)\n133: \n134: T3_CPP_EXE := $(BINDIR)/t3_bbox_cpp/main$(EXE_EXT)\n135: T3_C_EXE := $(BINDIR)/t3_bbox_c/main$(EXE_EXT)\n136: \n137: T4_CPP_EXE := $(BINDIR)/t4_filter_cpp/main$(EXE_EXT)\n138: T4_C_EXE := $(BINDIR)/t4_filter_c/main$(EXE_EXT)\n139: \n140: # target-specific ���������� - ��� ����������� �������� �� ����� ���������� - ����������� / ������������ \n141: $(T1_CPP_EXE) $(T1_C_EXE) $(T2_CPP_EXE) $(T2_C_EXE): COMMON_FLAG := $(DEFINE)COMMON_STATIC\n142: # ��� t3 - t4 ���� ���� ������ - ��� ������� ����� ����������, ��� ������������� �� dll\n143: $(T3_CPP_EXE) $(T3_C_EXE) $(T4_CPP_EXE) $(T4_C_EXE): COMMON_FLAG :=\n144: \n145: # ���� (��������)\n146: # ��� ������ ����� wildcard: ���� ��� �������, �� ��� ���������� ������ make ����� ��������� � �������� ��������\n147: # � �� ������ ��� �� ������ �� .ok ������ - ������� ������ ��� �� ����. ����� �� ��� ������ .ok ����� ������ ��� �� �� ����������\n148: # ������ � ����������� ������\n149: T1_CPP_TESTS := $(TESTDIR)/t1_cpp_abc.ok \\\n150: \t    $(TESTDIR)/t1_cpp_float.ok \\\n151: \t    $(TESTDIR)/t1_cpp_low.ok \\\n152: \t    $(TESTDIR)/t1_cpp_high.ok \\\n153: \t    $(TESTDIR)/t1_cpp_nul.ok \\\n154:             $(TESTDIR)/t1_cpp_norm.ok\n155: \n156: T1_C_TESTS := $(TESTDIR)/t1_c_abc.ok \\\n157: \t    $(TESTDIR)/t1_c_float.ok \\\n158: \t    $(TESTDIR)/t1_c_low.ok \\\n159: \t    $(TESTDIR)/t1_c_high.ok \\\n160: \t    $(TESTDIR)/t1_c_nul.ok \\\n161:             $(TESTDIR)/t1_c_norm.ok\n162: \n163: T2_CPP_TESTS := $(TESTDIR)/t2_cpp_norm.ok \\\n164:                 $(TESTDIR)/t2_cpp_eof_name.ok \\\n165:                 $(TESTDIR)/t2_cpp_empty_name.ok \\\n166:                 $(TESTDIR)/t2_cpp_eof_vertexes.ok \\\n167:                 $(TESTDIR)/t2_cpp_empty_vertexes.ok \\\n168:                 $(TESTDIR)/t2_cpp_negative_vertexes.ok \\\n169:                 $(TESTDIR)/t2_cpp_fractional_vertexes.ok \\\n170:                 $(TESTDIR)/t2_cp