                "text": "#include <algorithm>\n#include <cmath>\n#include <iostream>\n#include <numeric>\n#include <print>\n#include <ranges>\n#include <string>\n#include <vector>\n\n#include \"../common/exit_codes.hpp\"\n#include \"../common/geometry.hpp\"\n#include \"../common/string_utils.hpp\"\n\nint main() {\n    // ���������� ��������� x y z � ������; ������� ������, ����� �����\n    // ��� ������������� ������ ����� � ������� ����� ������\n    std::string temp;\n    std::vector<Point> points;\n    int i = 0;\n    // ���� �� EOF - ������\n    while (std::getline(std::cin, temp)) {\n        // ���������� �����, ����� ��� ������ ����� ������, � �� ����. � �������\n        ++i;\n\n        if (std::cin.bad()) {\n            std::cerr << \"���� IO ��� ������ ������ � ������ \" << i << \"\\n\";\n            return exit_code::io_fail;\n        }\n\n        // ��������� ������ ������ ������ ������������\n        if (is_empty(temp))\n            continue;\n\n        // ������ ����� ����� parse_point\n        auto result = parse_point(temp);\n        if (!result) {\n            // ���� ����������\n            if (result.error() == 1)\n                std::cerr << \"������ \" << i << \" - ������������ ���������. ��������� X Y Z, ��������: \" << temp << \"\\n\";\n            // ���������� ������\n            else if (result.error() == 2)\n                std::cerr << \"������ \" << i << \". ���������� ������: \" << temp << \"\\n\";\n// ������� ����� ���������\nelse \nstd::cerr << \"������ \" << i << \" - ������� ����� ���������. ��������� X Y Z, ��������: \" << temp << \"\\n\";\n            return exit_code::data;\n        }\n\n        // ���� ����� �� ����� �������, ������ ex_code == 0 � ����� ������� ����� � ������\n        points.push_back(*result);\n    }\n\n    // ���� �� ����� ������ ������ ����� ������, �� ������� ������ �� ����\n    if (points.empty()) {\n        std::cerr << \"������� ������ �����������\\n\";\n        return exit_code::no_in;\n    }\n\n    // ���