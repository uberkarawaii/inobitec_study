                "text": "#include \"geometry.hpp\"\n\n#include <array>\n#include <cctype>\n#include <charconv>\n#include <expected>\n#include <string>\n#include <string_view>\n#include <system_error>\n\n// ������������� x y z\nstd::expected<Point, int> parse_point(std::string_view s) {\n    // ������ double ����� �� ������\n    std::array<double, 3> dots{};\n// ��������� �� (������ ������)\n    const char* ptr_start = s.data();\n// ��������� �� (������ ������) + (������ ������)\n    const char* ptr_end = s.data() + s.size();\n    int j = 0;\n    while (j < 3) {\n        // ������� ��������, �.�. ����� ������� ����� ���� � �� �� ������ �������\n        while (ptr_start != ptr_end && std::isspace(static_cast<unsigned char>(*ptr_start)))\n            ++ptr_start;\n\n        // ���� ��������� ������ ��������� �� ����� - � ��� ������ 3 ����� ����� �� ������ ���������\n        // �.�. �� 3 �����, �� ������ ��� ������� X Y Z\n        if (ptr_start == ptr_end)\n            return std::unexpected(parse_too_few);\n\n        const auto [ptr, ec] = std::from_chars(ptr_start, ptr_end, dots[j]);\n        // ��������� �� �����, ���� 3 �� �� ���� ���������\n        if (ptr == ptr_end && j < 2)\n            return std::unexpected(parse_too_few);\n\n        // ���� ec � ������� ��� ������������� ������� �� �� ������� � �� �� �����, �� ��� ������ � ������\n        if (ec != std::errc{} || (ptr != ptr_end && !std::isspace(static_cast<unsigned char>(*ptr)))) {\n            return std::unexpected(parse_not_number);\n        }\n        // ��������� ��������� ��� ����.������. ���������� ����, ��� ������������ ������������� � ���� ��������\n        ptr_start = ptr;\n\n        ++j;\n    }\n\n// ���� ����� ���� � �� X Y Z ���� ���-�� ���\nif (ptr != ptr_end){\n// ������� �������� ����� ���� ��������\nwhile (ptr_start != ptr_end && std::isspace(static_cast<unsigned char>(*ptr_start))) ++ptr_start;\n\n// ���� ����� �������� ������ == �����, �� ��� ���� ���� �������. ����� - �������� ���-�� ���\nif (ptr_start != ptr_end){\ndouble d{};\nconst auto [ptr1, ec1] = std::from_chars(ptr_start, ptr_end, d);\n// ���� ec1 ����� ������ � ��������� ����������� �� �� ���������� � �� �� �������� �������, �� ���� � ������ �������\nif (ec1 != std::errc{} || (ptr1 != ptr_end && !std::isspace(static_cast<unsigned char>(*ptr1)))) return std::unexpected(parse_not_number);\n// ����� - ��� ������ �����\nelse return std::unexpected(parse_too_much);\n}\n}\n \n\n    return Point{dots[0], dots[1], dots[2]};\n}",
