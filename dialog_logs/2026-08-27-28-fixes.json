                "text": "#include \"geometry.h\"\n\n#include <math.h>\n#include <stdlib.h>\n#include <string.h>\n\n// ������������� �����. ���� ��������� ������:\n// PARSE_TOO_FEW - 1 - ���� ���������\n// PARSE_NOT_NUMBER - 2 - ���������� ������\n// PARSE_EXTRA - 3 - ����� ���������\n// PARSE_NOT_FINITE - 4 - �� �������� �����\nint parse_point(char* str, struct Point* p) {\n    // ��������� �� ������ ������\n    char* pointer = str;\n    // ������ ���������, ���� ����� �������� ����� ������������� �����\n    char* end = NULL;\n\n    int i = 0;\n    double d[3];\n    while (i < 3 && *pointer != '\\0') {\n        // ������� ���������� �����\n        d[i] = strtod(pointer, &end);\n        // �������� ��� ��� �� nan / inf\n        if (!isfinite(d[i]))\n            return PARSE_NOT_FINITE;\n        // ��������� - �.�. ���������� ������;\n        // ��� ����� ���� ��������� �� �� �������/����� ��� � ����� ������ ������ ��� ���������� ������,\n        //  ����� end == pointer\n        if (end == pointer || (*end != '\\0' && strchr(\" \\t\\n\\r\", *end) == NULL))\n            return PARSE_NOT_NUMBER;\n        // ����������� ��������� � �����, ��� ���������� ������������� �����\n        pointer = end;\n        // �������� ��������� �� ���-�� �������� ����� �����\n        pointer += strspn(pointer, \" \\t\\n\\r\");\n        ++i;\n    }\n\n    // ���� ������ ������ ���, � ������ ����������� - ��������� ������ �������\n    if (i != 3)\n        return PARSE_TOO_FEW;\n\n    // ���� ������ ���������� ���, � ������ ���-�� ��� (������� ����� 3 ����� ��� �������) - ��� ������ �����, ���\n    // ������\n    if (i == 3 && *pointer != '\\0') {\n        // ���� ���� ��� �� X Y Z. ������� ��� ��� ������, ��� ��� ��� ����������\n        (void)strtod(pointer, &end);\n        // ���� � ������ ������ ������ (end == ptr) ��� end ����������� �� �� ���������� - ������ �������� � ��-�����\n        if (end == pointer || (*end != '\\0' && strchr(\" \\t\\n\\r\", *end) == NULL))\n            return PARSE_NOT_NUMBER;\n        // ����� - ��� ������ �����\n        else\n            return PARSE_EXTRA;\n    }\n\n    *p = (struct Point){.x = d[0], .y = d[1], .z = d[2]};\n\n    return 0;\n}",
