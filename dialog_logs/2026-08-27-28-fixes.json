��� ����� ��� ���������� ������������, ���� ������ ��� �� ����\n252: \n253: # ������������� ����� �������. obj - ����� ��� ��������� hdr obj ��������� ������\n254: # �������� ������������� ��� t1-t2 �.�. ��� ���������� � ��������� ���������� ������� ����, ���� ������ ����������, ��� ����� obj ����� hdr\n255: \n256: # ���-���� �������������� (������ ��� �������)\n257: ifeq ($(OS), Windows_NT)\n258:  \n259: GEOM_CPP_HDR := common/geometry.hpp\n260: GEOM_C_HDR := common/geometry.h\n261: \n262: STR_UTIL_CPP_HDR := common/string_utils.hpp\n263: STR_UTIL_C_HDR := common/string_utils.h\n264: \n265: CPP_OBJ_HDR := common/exit_codes.hpp $(STR_UTIL_CPP_HDR) $(GEOM_CPP_HDR)\n266: C_OBJ_HDR := common/exit_codes.h $(STR_UTIL_C_HDR) $(GEOM_C_HDR)\n267: \n268: else\n269: \n270: GEOM_CPP_HDR := \n271: GEOM_C_HDR := \n272: \n273: STR_UTIL_CPP_HDR := \n274: STR_UTIL_C_HDR := \n275: \n276: CPP_OBJ_HDR := \n277: C_OBJ_HDR := \n278: \n279: endif\n280: \n281: \n282: $(BINDIR)/%$(OBJ_EXT): %.cpp $(CPP_OBJ_HDR) | $(CPP_DIRS)\n283: \t$(CXX) $(COMPILE_ONLY) $(COMMON_FLAG) $(OBJ_OUT)$@ $(CXXFLAGS) $<   \n284: \n285: # ����������� ��� ��\n286: $(BINDIR)/%$(OBJ_EXT): %.c $(C_OBJ_HDR) | $(C_DIRS) \n287: \t$(CC) $(COMPILE_ONLY) $(COMMON_FLAG) $(OBJ_OUT)$@ $(CFLAGS) $<\n288: \n289: # STATIC (t1-t2) ������� ��� geometry + string_utils, �.�. �� ����� ����������� �� ��������� � ������� .src\n290: $(BINDIR)/common/geometry_cpp$(OBJ_EXT): common/geometry.cpp $(GEOM_CPP_HDR) | $(BINDIR)/common\n291: \t$(CXX) $(COMPILE_ONLY) $(DEFINE)COMMON_STATIC $(OBJ_OUT)$@ $(PIC_FLAGS) $(CXXFLAGS) $< \n292: \n293: $(BINDIR)/common/geometry_c$(OBJ_EXT): common/geometry.c $(GEOM_C_HDR) | $(BINDIR)/common\n294: \t$(CC) $(COMPILE_ONLY) $(DEFINE)COMMON_STATIC $(OBJ_OUT)$@ $(PIC_FLAGS) $(CFLAGS) $<\n295: \n296: $(BINDIR)/common/string_utils_cpp$(OBJ_EXT): common/string_utils.cpp $(STR_UTIL_CPP_HDR) | $(BINDIR)/common\n297: \t$(CXX) $(COMPILE_ONLY) $(DEFINE)COMMON_STATIC $(OBJ_OUT)$@ $(PIC_FLAGS) $(CXXFLAGS) $<\n298: \n299: