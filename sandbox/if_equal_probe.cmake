# Проверка if(NOT <bool> EQUAL 0) vs if(NOT <bool>)
set(ok_true  TRUE)
set(ok_false FALSE)
set(n_zero   0)
set(n_five   5)
set(msg      "No such file or directory")

message("--- 1. NOT TRUE EQUAL 0   (ожидание: FIRED) ---")
if(NOT ok_true EQUAL 0)
  message("FIRED")
else()
  message("not fired")
endif()

message("--- 2. NOT TRUE           (ожидание: not fired) ---")
if(NOT ok_true)
  message("FIRED")
else()
  message("not fired")
endif()

message("--- 3. NOT FALSE          (ожидание: FIRED) ---")
if(NOT ok_false)
  message("FIRED")
else()
  message("not fired")
endif()

message("--- 4. NOT 0 EQUAL 0      (ожидание: not fired) ---")
if(NOT n_zero EQUAL 0)
  message("FIRED")
else()
  message("not fired")
endif()

message("--- 5. NOT 5 EQUAL 0      (ожидание: FIRED) ---")
if(NOT n_five EQUAL 0)
  message("FIRED")
else()
  message("not fired")
endif()

message("--- 6. NOT <string> EQUAL 0 (ожидание: FIRED; так работал старый код) ---")
if(NOT msg EQUAL 0)
  message("FIRED")
else()
  message("not fired")
endif()

message("--- 7. NOT <undefined> (ожидание: FIRED - ловушка) ---")
if(NOT undefined_ok)
  message("FIRED")
else()
  message("not fired")
endif()